<!-- Floating Selection Bubble Menu -->
<div data-tiptap-target="bubbleMenu" class="hidden fixed z-[100] bg-ink dark:bg-ink-darker text-white shadow-2xl rounded-xl p-1 flex items-center gap-0.5 border border-white/10 backdrop-blur-xl transition-opacity">
  <button type="button" data-action="click->tiptap#toggleBold" class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-white/15 text-xs font-bold" title="Negrito">B</button>
  <button type="button" data-action="click->tiptap#toggleItalic" class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-white/15 text-xs italic font-serif" title="Itálico">I</button>
  <button type="button" data-action="click->tiptap#toggleStrike" class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-white/15 text-xs line-through" title="Riscado">S</button>
  <button type="button" data-action="click->tiptap#toggleCode" class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-white/15 text-xs font-mono" title="Código">&lt;&gt;</button>
  <button type="button" data-action="click->tiptap#setLink" class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-white/15 text-xs" title="Inserir Link">
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
  </button>
  <div class="w-px h-4 bg-white/20 mx-1"></div>
  <button type="button" data-action="click->tiptap#toggleH1" class="px-1.5 h-7 rounded-lg flex items-center justify-center hover:bg-white/15 text-[11px] font-bold">H1</button>
  <button type="button" data-action="click->tiptap#toggleH2" class="px-1.5 h-7 rounded-lg flex items-center justify-center hover:bg-white/15 text-[11px] font-bold">H2</button>
  <button type="button" data-action="click->tiptap#toggleTaskList" class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-white/15" title="Checklist">
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
  </button>
</div>

<!-- Slash Command Floating Menu Popover -->
<div data-tiptap-target="slashMenu" class="hidden fixed z-[100] w-80 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-2xl shadow-2xl p-2 animate-[scale-in_0.15s_ease-out_forwards] max-h-96 overflow-y-auto hide-scrollbar">
  <div class="px-2.5 py-1.5 text-[10px] font-bold uppercase tracking-wider text-ink-light/70 dark:text-white/40 flex items-center justify-between border-b border-ink/5 dark:border-white/5 mb-1">
    <span>Comandos Rápidos</span>
    <span class="text-[9px] font-normal text-ink-light/50">Esc para fechar</span>
  </div>
  
  <div class="space-y-0.5 text-xs py-1">
    <!-- H1 -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="h1" data-search="h1 titulo principal header grande heading1" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-terracotta/10 text-terracotta flex items-center justify-center font-bold text-xs shrink-0">H1</span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Título Principal</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Título de seção grande</p>
      </div>
    </button>

    <!-- H2 -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="h2" data-search="h2 subtitulo header medio heading2" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center font-bold text-xs shrink-0">H2</span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Subtítulo</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Subtítulo de seção médio</p>
      </div>
    </button>

    <!-- H3 -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="h3" data-search="h3 secao pequena header pequeno heading3" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold text-xs shrink-0">H3</span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Seção Pequena</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Tópico subordinado</p>
      </div>
    </button>

    <!-- Task List -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="task" data-search="task lista tarefas checklist to-do todo check checkbox" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Lista de Tarefas</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Checklist com caixas interativas</p>
      </div>
    </button>

    <!-- Bullet List -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="bullet" data-search="bullet lista marcadores pontos unnumbered list ul" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-500 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Lista com Marcadores</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Lista com bullets simples</p>
      </div>
    </button>

    <!-- Ordered List -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="ordered" data-search="ordered lista numerada numeros ordered list ol 123" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-teal-500/10 text-teal-500 flex items-center justify-center shrink-0 font-mono font-bold text-xs">1.</span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Lista Numerada</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Lista ordenada por números</p>
      </div>
    </button>

    <!-- Callout Note -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="callout" data-search="callout destaque nota informacao info dica ideia box" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-yellow-500/10 text-yellow-500 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Nota em Destaque (Callout)</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Aviso ou nota importante</p>
      </div>
    </button>

    <!-- Warning Callout -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="warning" data-search="warning atencao aviso cuidado alerta caution" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Aviso de Atenção</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Destaque para avisos importantes</p>
      </div>
    </button>

    <!-- Tip Callout -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="tip" data-search="tip dica sucesso boa pratica recomendacao check" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-green-500/10 text-green-500 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Dica & Boa Prática</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Sugestão de sucesso ou recomendação</p>
      </div>
    </button>

    <!-- Danger Callout -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="danger" data-search="danger perigo critico erro alert stop ban" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-red-500/10 text-red-500 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Alerta Crítico / Perigo</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Avisos de risco e restrições críticas</p>
      </div>
    </button>

    <!-- Table -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="table" data-search="table tabela grid matriz linhas colunas data" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-indigo-500/10 text-indigo-500 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Tabela de Dados</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Estrutura em linhas e colunas</p>
      </div>
    </button>

    <!-- Code Block -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="code" data-search="code codigo bloco programa programacao snippet pre" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-500 flex items-center justify-center font-mono text-xs shrink-0">&lt;/&gt;</span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Bloco de Código</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Código fonte formatado com fundo escuro</p>
      </div>
    </button>

    <!-- Blockquote -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="quote" data-search="quote citacao citar quote citação" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-stone-500/10 text-stone-500 flex items-center justify-center font-serif text-sm italic shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Citação</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Bloco estilizado para referências e frases</p>
      </div>
    </button>

    <!-- Diagram / Architecture -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="diagram" data-search="diagram diagrama mermaid arquitetura fluxo quadros" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xs shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Diagrama de Arquitetura</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Bloco de diagrama Mermaid técnico</p>
      </div>
    </button>

    <!-- Issue Reference -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="issue" data-search="issue tarefa card backlog ticket rastreio" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-terracotta/10 text-terracotta flex items-center justify-center text-xs shrink-0 font-bold">#</span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Referência a Tarefa / Issue</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Vínculo com tarefa do backlog</p>
      </div>
    </button>

    <!-- Divider -->
    <button type="button" data-action="click->tiptap#insertBlock" data-type="divider" data-search="divider linha divisoria divisor horizontal rule hr" class="slash-cmd-btn w-full text-left flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable cursor-pointer transition-colors">
      <span class="w-7 h-7 rounded-lg bg-ink/10 dark:bg-white/10 flex items-center justify-center shrink-0">―</span>
      <div class="min-w-0 flex-1">
        <p class="font-medium truncate">Linha Divisória</p>
        <p class="text-[10px] text-ink-light dark:text-white/40 truncate">Divisor visual de seções</p>
      </div>
    </button>
  </div>

  <div id="slash-empty-msg" class="hidden p-3 text-center text-xs text-ink-light/60 dark:text-white/40 italic">
    Nenhum bloco encontrado
  </div>
</div>
