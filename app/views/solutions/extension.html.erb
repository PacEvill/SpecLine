<div class="min-h-screen flex flex-col bg-fable-light dark:bg-[#18181A] text-ink dark:text-white font-sans selection:bg-terracotta/30 selection:text-ink transition-colors duration-500 relative">
  <%= render 'shared/marketing_header' %>

  <main class="flex-grow w-full">
    <!-- HERO SECTION: Extensão Universitária & Vínculo Territorial Maricá -->
    <header class="p-8 md:p-20 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#18181A] relative overflow-hidden text-center">
      <!-- Ambient Glow Flare -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[380px] bg-terracotta/15 dark:bg-terracotta/10 blur-[140px] rounded-full pointer-events-none animate-pulse"></div>

      <div class="max-w-4xl mx-auto space-y-6 relative z-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-terracotta/10 text-terracotta text-xs font-mono font-bold tracking-wide uppercase border border-terracotta/20">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 21a9 9 0 0 0 9-9c0-4.97-4.03-9-9-9s-9 4.03-9 9a9 9 0 0 0 9 9Z"/><path d="M3.6 9h16.8"/><path d="M3.6 15h16.8"/><path d="M11.5 3a17 17 0 0 0 0 18"/><path d="M12.5 3a17 17 0 0 1 0 18"/></svg>
          <span>Extensão Universitária · PEI VI · Campus Maricá (2026.2)</span>
        </div>
        
        <h1 class="font-serif font-light text-5xl md:text-7xl lg:text-8xl leading-[0.95] tracking-tight text-ink dark:text-fable">
          Engenharia de Software<br>
          <i class="text-terracotta font-serif-italic">a serviço de Maricá.</i><br>
          Da academia à comunidade.
        </h1>

        <p class="max-w-2xl mx-auto text-lg md:text-xl text-ink-light dark:text-white/70 font-serif italic leading-relaxed pt-2">
          O SpecLine nasceu no 6º período de Engenharia de Software da Universidade de Vassouras (FUSVE) com um propósito extensionista claro: transferir conhecimento técnico avançado e entregar uma plataforma de gestão profissional gratuita para o ecossistema de estudantes, programadores e pequenos empreendedores de Maricá/RJ.
        </p>

        <!-- Action Buttons -->
        <div class="pt-6 flex flex-wrap justify-center items-center gap-4 font-mono text-xs">
          <%= link_to new_user_registration_path, class: "group px-8 py-4 bg-ink text-white dark:bg-white dark:text-ink hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white font-mono text-xs uppercase tracking-widest font-semibold flex items-center gap-3 shadow-md hover:scale-105 active:scale-95 transition-all cursor-pointer" do %>
            <span>Acessar Plataforma Gratuita</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          <% end %>
          <a href="#oficina-presencial" class="px-6 py-4 border border-ink/20 dark:border-white/20 text-ink dark:text-white hover:border-terracotta hover:text-terracotta font-mono text-xs uppercase tracking-widest font-semibold transition-all flex items-center gap-2">
            <span>Detalhes da Oficina em Maricá</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </a>
        </div>
      </div>
    </header>

    <!-- BAROMETRO INSTITUCIONAL: METRICAS DO PROJETO EXTENSIONISTA -->
    <section class="border-b border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper py-8 px-6">
      <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div class="space-y-1">
          <div class="font-mono text-3xl md:text-4xl font-bold text-terracotta">R$ 0,00</div>
          <div class="font-sans text-xs uppercase tracking-wider text-ink-light/80 dark:text-white/60">Custo Total de Operação (TCO)</div>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-3xl md:text-4xl font-bold text-sage">197 mil</div>
          <div class="font-sans text-xs uppercase tracking-wider text-ink-light/80 dark:text-white/60">Habitantes no Território (IBGE)</div>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-3xl md:text-4xl font-bold text-ochre">15 a 30</div>
          <div class="font-sans text-xs uppercase tracking-wider text-ink-light/80 dark:text-white/60">Participantes na Oficina Presencial</div>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-3xl md:text-4xl font-bold text-olive">100%</div>
          <div class="font-sans text-xs uppercase tracking-wider text-ink-light/80 dark:text-white/60">Acesso Aberto & Código Livre</div>
        </div>
      </div>
    </section>

    <!-- DIAGNÓSTICO TERRITORIAL: POR QUE MARICÁ? -->
    <section class="p-8 md:p-20 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#18181A]">
      <div class="max-w-6xl mx-auto space-y-12">
        <div class="max-w-3xl space-y-4">
          <span class="font-mono text-xs uppercase tracking-widest text-terracotta font-bold">Diagnóstico Territorial</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-white leading-tight">
            Inovação em crescimento,<br>
            <i class="text-terracotta font-serif-italic">mas com gargalos no acesso a ferramentas.</i>
          </h2>
          <p class="font-sans text-base text-ink-light dark:text-white/70 leading-relaxed">
            O município de Maricá vive uma efervescência econômica e tecnológica impulsionada por políticas públicas pioneiras (como o ICTIM — Instituto de Ciência, Tecnologia e Inovação de Maricá, a Moeda Social Mumbuca e a expansão de polos de formação técnica). No entanto, nossa pesquisa de campo revelou que estudantes e iniciativas locais esbarram em severas barreiras:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-8 border border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper rounded-2xl space-y-4 shadow-sm">
            <div class="font-mono text-xs text-rust font-bold uppercase tracking-wider">Desafio 01</div>
            <h3 class="font-serif text-2xl text-ink dark:text-white font-bold">Monopólio em Dólar</h3>
            <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
              65,8% dos participantes de Maricá declararam impedimento financeiro intransponível para manter assinaturas corporativas como Jira, Confluence, Notion ou Miro, cujos preços são cotados em moeda estrangeira.
            </p>
          </div>

          <div class="p-8 border border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper rounded-2xl space-y-4 shadow-sm">
            <div class="font-mono text-xs text-ochre font-bold uppercase tracking-wider">Desafio 02</div>
            <h3 class="font-serif text-2xl text-ink dark:text-white font-bold">Dispersão Operacional</h3>
            <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
              78,9% apontaram a fragmentação de ferramentas (troca constante de contexto entre abas soltas, WhatsApp e planilhas desconexas) como o principal motivo de atraso e desistência de projetos em equipes comunitárias.
            </p>
          </div>

          <div class="p-8 border border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper rounded-2xl space-y-4 shadow-sm">
            <div class="font-mono text-xs text-olive font-bold uppercase tracking-wider">Desafio 03</div>
            <h3 class="font-serif text-2xl text-ink dark:text-white font-bold">Perda de Requisitos</h3>
            <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
              57,9% relatam desatualização crônica das especificações funcionais e perda de memória técnica ao longo dos ciclos, gerando retrabalho constante e descontinuidade em projetos acadêmicos e sociais.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- DETALHES DA AÇÃO PRESENCIAL EM MARICÁ -->
    <section id="oficina-presencial" class="p-8 md:p-20 border-b border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper">
      <div class="max-w-6xl mx-auto space-y-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-6 space-y-6">
            <span class="font-mono text-xs uppercase tracking-widest text-terracotta font-bold">Ação Prática de Campo</span>
            <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-white leading-tight">
              Oficina Presencial:<br>
              <i class="text-terracotta font-serif-italic">Mão na Massa no Campus Maricá.</i>
            </h2>
            <p class="font-sans text-base text-ink-light dark:text-white/70 leading-relaxed">
              Mais do que entregar software, a extensão universitária exige presença e diálogo. Realizaremos uma oficina prática e gratuita aberta à comunidade e estudantes da região no laboratório da universidade, proporcionando mentoria direta para modelar projetos reais com o SpecLine.
            </p>

            <div class="space-y-4 pt-2">
              <div class="flex items-start gap-3 p-4 rounded-xl bg-fable-light dark:bg-[#18181A] border border-ink/10 dark:border-white/10">
                <div class="mt-1 text-terracotta">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                </div>
                <div>
                  <div class="text-sm font-bold text-ink dark:text-white">Data & Horário</div>
                  <div class="text-xs text-ink-light dark:text-white/70">17 de Outubro de 2026 (Sábado) — das 09h00 às 11h30 (150 min)</div>
                </div>
              </div>

              <div class="flex items-start gap-3 p-4 rounded-xl bg-fable-light dark:bg-[#18181A] border border-ink/10 dark:border-white/10">
                <div class="mt-1 text-sage">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <div class="text-sm font-bold text-ink dark:text-white">Local Físico da Ação</div>
                  <div class="text-xs text-ink-light dark:text-white/70">Laboratório de Informática Avançada (Lab 02) — Universidade de Vassouras (Campus Maricá - FUSVE)</div>
                  <div class="text-[11px] text-ink-light/60 dark:text-white/50 mt-0.5">Av. Roberto Silveira, nº 437, Bairro Flamengo, Maricá/RJ — CEP: 24903-815</div>
                </div>
              </div>

              <div class="flex items-start gap-3 p-4 rounded-xl bg-fable-light dark:bg-[#18181A] border border-ink/10 dark:border-white/10">
                <div class="mt-1 text-olive">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div>
                  <div class="text-sm font-bold text-ink dark:text-white">Responsáveis & Mediação</div>
                  <div class="text-xs text-ink-light dark:text-white/70">Diego Silva Pereira Pacheco (Discente / Líder do Projeto)</div>
                  <div class="text-[11px] text-ink-light/60 dark:text-white/50">Docente Responsável: Profª. Laís Cristine Bordallo Pinheiro | Apoio Técnico: Prof. Me. Victor Andrade da Silveira</div>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-6 bg-fable-light dark:bg-[#18181A] p-8 rounded-3xl border border-ink/10 dark:border-white/10 space-y-6">
            <h3 class="font-serif text-2xl font-bold text-ink dark:text-white">Etapas da Capacitação (150 min)</h3>
            
            <div class="space-y-4 font-mono text-xs">
              <div class="p-4 bg-white dark:bg-ink-paper rounded-xl border border-ink/5 dark:border-white/5 flex items-start gap-3">
                <span class="text-terracotta font-bold">15'</span>
                <div>
                  <div class="font-sans font-bold text-ink dark:text-white">Acolhimento & Credenciamento</div>
                  <div class="font-sans text-xs text-ink-light dark:text-white/60">Assinatura formal na Lista de Presença física oficial (Anexo A).</div>
                </div>
              </div>

              <div class="p-4 bg-white dark:bg-ink-paper rounded-xl border border-ink/5 dark:border-white/5 flex items-start gap-3">
                <span class="text-terracotta font-bold">20'</span>
                <div>
                  <div class="font-sans font-bold text-ink dark:text-white">Diagnóstico Territorial & Abertura</div>
                  <div class="font-sans text-xs text-ink-light dark:text-white/60">Apresentação dos princípios ágeis e demo interativa da plataforma no data-show.</div>
                </div>
              </div>

              <div class="p-4 bg-white dark:bg-ink-paper rounded-xl border border-ink/5 dark:border-white/5 flex items-start gap-3">
                <span class="text-terracotta font-bold">40'</span>
                <div>
                  <div class="font-sans font-bold text-ink dark:text-white">Prática Guiada no Laboratório</div>
                  <div class="font-sans text-xs text-ink-light dark:text-white/60">Cada participante cria seu workspace, redige especificações com TipTap e organiza um quadro Kanban.</div>
                </div>
              </div>

              <div class="p-4 bg-white dark:bg-ink-paper rounded-xl border border-ink/5 dark:border-white/5 flex items-start gap-3">
                <span class="text-terracotta font-bold">20'</span>
                <div>
                  <div class="font-sans font-bold text-ink dark:text-white">Mentoria Individual de Projetos</div>
                  <div class="font-sans text-xs text-ink-light dark:text-white/60">Apoio direto nas bancadas para estruturar ideias de TCC, negócios locais e projetos comunitários.</div>
                </div>
              </div>

              <div class="p-4 bg-white dark:bg-ink-paper rounded-xl border border-ink/5 dark:border-white/5 flex items-start gap-3">
                <span class="text-terracotta font-bold">20'</span>
                <div>
                  <div class="font-sans font-bold text-ink dark:text-white">Avaliação de Impacto & Evidências</div>
                  <div class="font-sans text-xs text-ink-light dark:text-white/60">Preenchimento da Avaliação em Escala Likert (Anexo B) e registro de fotos datadas.</div>
                </div>
              </div>

              <div class="p-4 bg-white dark:bg-ink-paper rounded-xl border border-ink/5 dark:border-white/5 flex items-start gap-3">
                <span class="text-terracotta font-bold">35'</span>
                <div>
                  <div class="font-sans font-bold text-ink dark:text-white">Roda de Devolutiva & Encerramento</div>
                  <div class="font-sans text-xs text-ink-light dark:text-white/60">Compartilhamento de aprendizados, recolhimento dos instrumentos e encerramento.</div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- DOCUMENTAÇÃO ACADÊMICA & TRANSPARÊNCIA -->
    <section class="p-8 md:p-20 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#18181A]">
      <div class="max-w-5xl mx-auto space-y-10 text-center">
        <div class="space-y-4">
          <span class="font-mono text-xs uppercase tracking-widest text-terracotta font-bold">Transparência Acadêmica</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-white">
            Documentação Oficial do Projeto
          </h2>
          <p class="font-serif italic text-base md:text-lg text-ink-light dark:text-white/70 max-w-2xl mx-auto">
            Todos os artefatos de planejamento, roteiros de oficina e relatórios de conformidade estão versionados e abertos no repositório oficial da disciplina.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
          <div class="p-6 bg-white dark:bg-ink-paper rounded-2xl border border-ink/10 dark:border-white/10 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-terracotta uppercase">Plano de Ação</span>
              <span class="text-[10px] font-mono bg-terracotta/10 text-terracotta px-2 py-0.5 rounded">PDF Oficial</span>
            </div>
            <h4 class="font-serif text-xl font-bold text-ink dark:text-white">Plano de Ação Extensionista (PEI VI)</h4>
            <p class="font-sans text-xs text-ink-light dark:text-white/70 leading-relaxed">
              Documento institucional contendo diagnóstico territorial com dados de Maricá, cronograma de atividades, matriz de riscos e resultados esperados.
            </p>
            <div class="pt-2">
              <a href="https://github.com/PacEvill/SpecLine/raw/main/docs/academic/PLANO%20DE%20A%C3%87%C3%83O%20EXTENSIONISTA.pdf" target="_blank" class="inline-flex items-center gap-2 text-xs font-mono font-bold text-terracotta hover:underline">
                <span>Baixar Plano de Ação em PDF</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </a>
            </div>
          </div>

          <div class="p-6 bg-white dark:bg-ink-paper rounded-2xl border border-ink/10 dark:border-white/10 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-sage uppercase">Roteiro de Campo</span>
              <span class="text-[10px] font-mono bg-sage/10 text-sage px-2 py-0.5 rounded">PDF Oficial</span>
            </div>
            <h4 class="font-serif text-xl font-bold text-ink dark:text-white">Roteiro da Oficina de Maricá</h4>
            <p class="font-sans text-xs text-ink-light dark:text-white/70 leading-relaxed">
              Guia cronometrado de 150 min usável por terceiros, com papéis definidos, materiais necessários e modelos da Lista de Presença e Escala Likert.
            </p>
            <div class="pt-2">
              <a href="https://github.com/PacEvill/SpecLine/raw/main/docs/academic/oficina-marica.pdf" target="_blank" class="inline-flex items-center gap-2 text-xs font-mono font-bold text-sage hover:underline">
                <span>Baixar Roteiro da Oficina em PDF</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CALL TO ACTION FINAL -->
    <section class="p-12 md:p-24 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-ink text-center relative overflow-hidden">
      <div class="max-w-3xl mx-auto space-y-6 relative z-10">
        <p class="font-mono text-xs tracking-widest text-terracotta uppercase font-bold">Participe da Ação Comunitária</p>
        <h2 class="font-serif font-light text-4xl md:text-6xl tracking-tight text-ink dark:text-white">
          Sua jornada de engenharia começa com ferramentas certas.
        </h2>
        <p class="font-serif italic text-lg text-ink-light dark:text-white/70">
          Crie seu primeiro projeto no SpecLine ou participe da nossa oficina presencial no Campus Maricá.
        </p>
        <div class="pt-4 flex justify-center">
          <%= link_to new_user_registration_path, class: "group px-8 py-4 bg-ink text-white dark:bg-white dark:text-ink hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white font-mono text-xs uppercase tracking-widest font-semibold flex items-center gap-3 shadow-xl hover:scale-105 active:scale-95 transition-all cursor-pointer" do %>
            <span>Criar Minha Conta Gratuita</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          <% end %>
        </div>
      </div>
    </section>
  </main>

  <%= render 'shared/marketing_footer' %>
</div>
