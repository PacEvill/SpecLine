<header class="sticky top-0 z-50 w-full bg-fable/90 dark:bg-ink-darker/90 backdrop-blur-md border-b border-ink/10 dark:border-white/10 transition-colors duration-500 animate-fade-in-up">
  <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between relative">
    <a href="/" class="flex items-center space-x-3 group relative z-10">
      <!-- Lucide: Boxes -->
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink dark:text-fable group-hover:text-terracotta transition-colors duration-500"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></svg>
      <span class="font-serif font-semibold text-2xl tracking-tight text-ink dark:text-fable group-hover:text-terracotta transition-colors duration-500">SpecLine</span>
    </a>
    
    <!-- Centered Menu Items (Desktop) -->
    <div class="hidden lg:flex absolute left-1/2 top-1/2 -translate-y-1/2 -translate-x-1/2 items-center gap-6 font-sans text-sm font-medium">
      
      <!-- Dropdown Funcionalidades -->
      <div class="relative group">
        <button class="flex items-center gap-1 py-2 text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable transition-colors focus:outline-none duration-500">
          Funcionalidades
          <svg class="w-4 h-4 transition-transform group-hover:rotate-180 duration-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <!-- Painel escondido -->
        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 w-[320px]">
          <div class="bg-white dark:bg-ink-paper rounded-xl shadow-xl border border-ink/10 dark:border-white/10 p-2 flex flex-col gap-1">
            <a href="/features/docs" class="flex items-start gap-3 p-3 rounded-lg hover:bg-fable-dark dark:hover:bg-white/5 transition-colors duration-500">
              <div class="mt-0.5 text-sage">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
              </div>
              <div>
                <div class="text-ink dark:text-fable font-semibold">Documentos & Wiki</div>
                <div class="text-ink-light dark:text-white/60 text-xs font-normal">Editor focado e colaborativo</div>
              </div>
            </a>
            <a href="/features/kanban" class="flex items-start gap-3 p-3 rounded-lg hover:bg-fable-dark dark:hover:bg-white/5 transition-colors duration-500">
              <div class="mt-0.5 text-terracotta">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="9" x2="9" y1="3" y2="21"/><path d="M14 8h.01"/><path d="M14 16h.01"/></svg>
              </div>
              <div>
                <div class="text-ink dark:text-fable font-semibold">Gestão de Tarefas</div>
                <div class="text-ink-light dark:text-white/60 text-xs font-normal">Kanban e fluxo de trabalho</div>
              </div>
            </a>
            <a href="/features/chat" class="flex items-start gap-3 p-3 rounded-lg hover:bg-fable-dark dark:hover:bg-white/5 transition-colors duration-500">
              <div class="mt-0.5 text-ink dark:text-fable">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <div>
                <div class="text-ink dark:text-fable font-semibold">Comunicação Contextual</div>
                <div class="text-ink-light dark:text-white/60 text-xs font-normal">Chats focados por projeto</div>
              </div>
            </a>
            <a href="/features/whiteboard" class="flex items-start gap-3 p-3 rounded-lg hover:bg-fable-dark dark:hover:bg-white/5 transition-colors duration-500">
              <div class="mt-0.5 text-sage">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 Z"/></svg>
              </div>
              <div>
                <div class="text-ink dark:text-fable font-semibold">Quadros e Diagramas</div>
                <div class="text-ink-light dark:text-white/60 text-xs font-normal">Whiteboard e Mermaid.js</div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Dropdown Soluções -->
      <div class="relative group">
        <button class="flex items-center gap-1 py-2 text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable transition-colors focus:outline-none duration-500">
          Soluções
          <svg class="w-4 h-4 transition-transform group-hover:rotate-180 duration-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 w-[240px]">
          <div class="bg-white dark:bg-ink-paper rounded-xl shadow-xl border border-ink/10 dark:border-white/10 p-2 flex flex-col gap-1">
            <a href="/solutions/startups" class="flex items-center gap-3 p-3 rounded-lg hover:bg-fable-dark dark:hover:bg-white/5 transition-colors duration-500">
              <div class="text-ink dark:text-fable font-medium">Para Startups</div>
            </a>
            <a href="/solutions/agencies" class="flex items-center gap-3 p-3 rounded-lg hover:bg-fable-dark dark:hover:bg-white/5 transition-colors duration-500">
              <div class="text-ink dark:text-fable font-medium">Para Agências</div>
            </a>
            <a href="/solutions/product" class="flex items-center gap-3 p-3 rounded-lg hover:bg-fable-dark dark:hover:bg-white/5 transition-colors duration-500">
              <div class="text-ink dark:text-fable font-medium">Para Times de Produto</div>
            </a>
          </div>
        </div>
      </div>

      <!-- Dropdown Filosofia -->
      <div class="relative group">
        <button class="flex items-center gap-1 py-2 text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable transition-colors focus:outline-none duration-500">
          Filosofia
          <svg class="w-4 h-4 transition-transform group-hover:rotate-180 duration-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 w-[280px]">
          <div class="bg-white dark:bg-ink-paper rounded-xl shadow-xl border border-ink/10 dark:border-white/10 p-2 flex flex-col gap-1">
            <a href="/philosophy/vision" class="flex items-start gap-3 p-3 rounded-lg hover:bg-fable-dark dark:hover:bg-white/5 transition-colors duration-500">
              <div class="mt-0.5 text-terracotta">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              </div>
              <div>
                <div class="text-ink dark:text-fable font-semibold">Nossa Visão</div>
                <div class="text-ink-light dark:text-white/60 text-xs font-normal">Por que construímos o SpecLine</div>
              </div>
            </a>
            <a href="/philosophy/focus" class="flex items-start gap-3 p-3 rounded-lg hover:bg-fable-dark dark:hover:bg-white/5 transition-colors duration-500">
              <div class="mt-0.5 text-sage">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
              </div>
              <div>
                <div class="text-ink dark:text-fable font-semibold">O Poder do Foco</div>
                <div class="text-ink-light dark:text-white/60 text-xs font-normal">Trabalho profundo sem interrupções</div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <a href="/pricing" class="py-2 text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors duration-500">Preços</a>
      <a href="/changelog" class="py-2 text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors duration-500">Changelog</a>
    </div>

    <!-- Right Side (Auth) -->
    <div class="flex items-center gap-4 font-sans text-sm font-medium relative z-10">
      <% if user_signed_in? %>
        <a href="<%= workspaces_path %>" class="flex items-center hover:scale-105 transition-transform duration-300" title="Acessar SpecLine">
          <div class="w-10 h-10 rounded-full bg-terracotta text-white flex items-center justify-center font-serif font-medium text-lg shadow-md hover:shadow-lg transition-all duration-500">
            <%= current_user.email[0].upcase %>
          </div>
        </a>
      <% else %>
        <%= link_to "Entrar", new_user_session_path, class: "text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors py-2 hidden sm:block duration-500" %>
        <%= link_to "Criar Conta", new_user_registration_path, class: "btn-primary text-sm px-5 py-2.5" %>
      <% end %>
    </div>
  </nav>
</header>
