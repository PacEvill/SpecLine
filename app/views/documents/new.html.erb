<div class="flex-1 bg-white dark:bg-ink-darker min-h-screen flex flex-col font-sans">
  <%= form_with(model: [@workspace, @project, @document], class: "h-full flex flex-col") do |form| %>
    <%= form.hidden_field :parent_id %>
    
    <!-- Editor Header with Actions -->
    <header class="h-14 px-6 flex items-center justify-between sticky top-0 bg-white/95 dark:bg-ink-darker/95 backdrop-blur-md z-20">
      <div class="flex items-center gap-2">
        <%= link_to workspace_project_path(@workspace, @project, view: 'documents'), class: "p-1.5 text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 rounded transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        <% end %>
        <div class="text-sm text-ink-light dark:text-white/60 flex items-center gap-1.5 ml-1">
          <span class="hover:underline cursor-pointer"><%= @project.name %></span>
          <span class="text-ink/30 dark:text-white/30 text-xs">/</span>
          <span class="text-ink dark:text-fable font-medium">Novo Documento</span>
        </div>
      </div>
      
      <div class="flex items-center gap-3">
        <%= link_to "Descartar", workspace_project_path(@workspace, @project, view: 'documents'), class: "px-3 py-1.5 text-xs font-medium text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable hover:bg-ink/5 dark:hover:bg-white/10 rounded transition-colors" %>
        <%= form.submit "Publicar", class: "px-3 py-1 bg-transparent hover:bg-ink/5 dark:hover:bg-white/10 text-ink dark:text-fable text-sm font-medium rounded transition-colors cursor-pointer" %>
      </div>
    </header>

    <!-- Editor Body -->
    <main class="flex-1 w-full max-w-[800px] mx-auto px-8 sm:px-12 py-10 lg:py-16">
      
      <!-- Icon/Emoji Selector -->
      <div class="mb-4">
        <div class="group relative inline-block">
          <%= form.text_field :icon, class: "w-auto min-w-[80px] max-w-[120px] h-20 text-[56px] leading-none bg-transparent border-none p-0 hover:bg-ink/5 dark:hover:bg-white/5 rounded-xl transition-colors cursor-pointer outline-none focus:ring-0", style: "box-shadow: none;", placeholder: "📄", maxlength: 3 %>
          <div class="absolute -top-8 left-0 opacity-0 group-hover:opacity-100 transition-opacity bg-ink dark:bg-fable text-white dark:text-ink text-[11px] font-medium py-1 px-2.5 rounded whitespace-nowrap pointer-events-none z-10 shadow-sm">
            Adicionar ícone
          </div>
        </div>
      </div>

      <!-- Title -->
      <div class="mb-2">
        <%= form.text_area :title, rows: 1, class: "w-full text-4xl sm:text-5xl font-bold tracking-tight bg-transparent border-none p-0 text-ink dark:text-fable placeholder-ink/20 dark:placeholder-white/20 resize-none overflow-hidden outline-none focus:ring-0", style: "box-shadow: none;", placeholder: "Título sem nome", autofocus: true, required: true, oninput: "this.style.height = ''; this.style.height = this.scrollHeight + 'px'" %>
      </div>

      <!-- ActionText Editor -->
      <div class="mt-4">
        <%= form.rich_text_area :content, class: "prose prose-ink dark:prose-invert max-w-none prose-p:text-[16px] prose-p:leading-relaxed prose-headings:font-bold prose-headings:tracking-tight prose-a:text-terracotta hover:prose-a:text-[#c26244] prose-img:rounded-xl prose-pre:bg-ink-paper prose-pre:border prose-pre:border-white/10 min-h-[500px] border-none outline-none focus:ring-0 p-0 m-0", style: "box-shadow: none;", placeholder: "Comece a escrever..." %>
      </div>
    </main>
  <% end %>
</div>
