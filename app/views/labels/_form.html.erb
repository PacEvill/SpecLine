<%= turbo_frame_tag "modal" do %>
  <div data-controller="modal" data-modal-open-value="true" class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-ink/30 backdrop-blur-sm transition-opacity duration-500" data-modal-target="backdrop" data-action="click->modal#close"></div>

    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
      <div class="flex min-h-full items-end justify-end text-center sm:items-center sm:p-0">
        <div class="relative transform overflow-hidden bg-[#FDFBF7] dark:bg-ink-darker text-left shadow-2xl transition-all sm:my-0 sm:w-full sm:max-w-md h-screen border-l border-ink/10 dark:border-white/10 flex flex-col duration-500" data-modal-target="panel">
          
          <div class="flex items-center justify-between px-6 py-4 border-b border-ink/5 dark:border-white/5 bg-white dark:bg-ink-paper">
            <h3 class="text-base font-serif font-medium text-ink dark:text-fable" id="modal-title">
              <%= @label.new_record? ? "Nova Tag Rápida" : "Editar Tag" %>
            </h3>
            <button type="button" class="text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors duration-500" data-action="modal#close">
              <span class="sr-only">Fechar</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>

          <div class="flex-1 overflow-y-auto px-6 py-6">
            <%= form_with(model: [@workspace, @label], html: { target: "_top", class: "space-y-6" }) do |f| %>
              <% if @label.errors.any? %>
                <div class="bg-red-50 text-red-600 p-4 rounded-xl text-sm mb-6 border border-red-100">
                  <p class="font-semibold mb-2">Não foi possível salvar:</p>
                  <ul class="list-disc pl-5 space-y-1">
                    <% @label.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <div>
                <%= f.label :name, "Nome da Tag", class: "block text-xs font-medium text-ink-light dark:text-white/60 mb-1.5" %>
                <%= f.text_field :name, class: "w-full px-3 py-2 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-lg text-sm text-ink dark:text-fable focus:outline-none focus:border-terracotta dark:focus:border-terracotta focus:ring-1 focus:ring-terracotta transition-shadow placeholder:text-ink/30 dark:placeholder:text-white/30 duration-500", placeholder: "Ex: Frontend", required: true %>
              </div>

              <div>
                <%= f.label :color, "Cor", class: "block text-xs font-medium text-ink-light dark:text-white/60 mb-1.5" %>
                <%= f.color_field :color, class: "w-12 h-10 p-1 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-lg cursor-pointer" %>
                <p class="text-[10px] text-ink-light dark:text-white/60 mt-1.5">Escolha uma cor para diferenciar a tag visualmente.</p>
              </div>

              <div class="pt-6 mt-6 border-t border-ink/5 dark:border-white/5 flex items-center justify-between">
                <% unless @label.new_record? %>
                  <%= link_to "Excluir Tag", workspace_label_path(@workspace, @label), data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir esta tag?" }, class: "text-xs font-medium text-red-600 hover:underline" %>
                <% else %>
                  <div></div>
                <% end %>

                <div class="flex items-center gap-3">
                  <button type="button" class="px-4 py-2 text-sm font-medium text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors duration-500" data-action="modal#close">Cancelar</button>
                  <%= f.submit "Salvar Tag", class: "px-6 py-2 bg-ink text-white text-sm font-medium rounded-lg hover:bg-terracotta transition-colors shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] cursor-pointer duration-500" %>
                </div>
              </div>
            <% end %>
          </div>
          
        </div>
      </div>
    </div>
  </div>
<% end %>
