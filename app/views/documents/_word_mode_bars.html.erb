<!-- ======================================================== -->
<!-- SPEC LINE / WORD INTERFACE SHELL                          -->
<!-- ======================================================== -->

<!-- 1. Top Word Ribbon Toolbar -->
<header id="word-mode-ribbon" class="hidden h-11 w-full bg-[#F5F5F7] dark:bg-[#1C1C1C] border-b border-ink/10 dark:border-white/10 px-3 items-center justify-between z-50 shrink-0 select-none text-ink dark:text-white/90 transition-colors">
  
  <!-- Left Formatting Tools -->
  <div class="flex items-center gap-1 overflow-x-auto hide-scrollbar">
    
    <!-- Undo / Redo -->
    <button type="button" data-action="click->tiptap#undo" class="p-1.5 hover:bg-ink/5 dark:hover:bg-white/10 rounded text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white transition-colors cursor-pointer" title="Desfazer (Ctrl+Z)">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
    </button>
    <button type="button" data-action="click->tiptap#redo" class="p-1.5 hover:bg-ink/5 dark:hover:bg-white/10 rounded text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white transition-colors cursor-pointer" title="Refazer (Ctrl+Y)">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"/></svg>
    </button>

    <div class="w-px h-4 bg-ink/10 dark:bg-white/10 mx-1 shrink-0"></div>

    <!-- Font Family Selector (With SpecLine Original Fonts) -->
    <select data-action="change->tiptap#setFontFamily" class="bg-white dark:bg-[#2C2C2C] text-ink dark:text-white text-xs rounded-lg px-2 py-1 border border-ink/15 dark:border-white/10 focus:outline-none focus:ring-1 focus:ring-terracotta cursor-pointer h-7 shadow-xs">
      <option value="ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" selected>SpecLine Sans (Padrão)</option>
      <option value="Georgia, Cambria, 'Times New Roman', Times, serif">SpecLine Serif (Elegante)</option>
      <option value="'Times New Roman', Times, serif">Times New Roman</option>
      <option value="Arial, Helvetica, sans-serif">Arial</option>
      <option value="Calibri, Candara, Segoe, 'Segoe UI', Optima, Arial, sans-serif">Calibri</option>
      <option value="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace">Mono / Código</option>
    </select>

    <!-- Font Size Selector (Interactive) -->
    <select data-action="change->tiptap#setFontSize" class="bg-white dark:bg-[#2C2C2C] text-ink dark:text-white text-xs rounded-lg px-2 py-1 border border-ink/15 dark:border-white/10 focus:outline-none focus:ring-1 focus:ring-terracotta cursor-pointer h-7 shadow-xs font-mono" title="Tamanho da Fonte">
      <option value="12px">12 pt</option>
      <option value="13px">13 pt</option>
      <option value="14px">14 pt</option>
      <option value="15px">15 pt</option>
      <option value="16px">16 pt</option>
      <option value="17px" selected>17 pt (Padrão)</option>
      <option value="18px">18 pt</option>
      <option value="20px">20 pt</option>
      <option value="24px">24 pt</option>
      <option value="28px">28 pt</option>
      <option value="32px">32 pt</option>
    </select>

    <div class="w-px h-4 bg-ink/10 dark:bg-white/10 mx-1 shrink-0"></div>

    <!-- Core Typography (N, I, S) -->
    <button type="button" data-action="click->tiptap#toggleBold" class="w-7 h-7 flex items-center justify-center hover:bg-ink/5 dark:hover:bg-white/10 rounded-lg text-xs font-bold text-ink dark:text-white transition-colors cursor-pointer" title="Negrito (Ctrl+B)">N</button>
    <button type="button" data-action="click->tiptap#toggleItalic" class="w-7 h-7 flex items-center justify-center hover:bg-ink/5 dark:hover:bg-white/10 rounded-lg text-xs italic font-serif text-ink dark:text-white transition-colors cursor-pointer" title="Itálico (Ctrl+I)">I</button>
    <button type="button" data-action="click->tiptap#toggleStrike" class="w-7 h-7 flex items-center justify-center hover:bg-ink/5 dark:hover:bg-white/10 rounded-lg text-xs line-through text-ink dark:text-white transition-colors cursor-pointer" title="Tachado">S</button>
    
    <div class="w-px h-4 bg-ink/10 dark:bg-white/10 mx-1 shrink-0"></div>

    <!-- Headings / Styles Dropdown -->
    <div class="flex items-center gap-0.5 bg-white dark:bg-[#2C2C2C] border border-ink/15 dark:border-white/10 rounded-lg h-7 px-1 shadow-xs">
      <button type="button" data-action="click->tiptap#setParagraph" class="px-1.5 py-0.5 text-[11px] text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white rounded hover:bg-ink/5 dark:hover:bg-white/10 cursor-pointer" title="Texto Normal">Parágrafo</button>
      <button type="button" data-action="click->tiptap#toggleH1" class="px-1.5 py-0.5 text-[11px] text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white font-bold rounded hover:bg-ink/5 dark:hover:bg-white/10 cursor-pointer" title="Título 1">H1</button>
      <button type="button" data-action="click->tiptap#toggleH2" class="px-1.5 py-0.5 text-[11px] text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white font-bold rounded hover:bg-ink/5 dark:hover:bg-white/10 cursor-pointer" title="Título 2">H2</button>
      <button type="button" data-action="click->tiptap#toggleH3" class="px-1.5 py-0.5 text-[11px] text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white font-bold rounded hover:bg-ink/5 dark:hover:bg-white/10 cursor-pointer" title="Título 3">H3</button>
    </div>

    <div class="w-px h-4 bg-ink/10 dark:bg-white/10 mx-1 shrink-0"></div>

    <!-- Lists & Formatting -->
    <button type="button" data-action="click->tiptap#toggleBulletList" class="p-1.5 hover:bg-ink/5 dark:hover:bg-white/10 rounded-lg text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white transition-colors cursor-pointer" title="Lista de Marcadores">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
    </button>
    <button type="button" data-action="click->tiptap#toggleOrderedList" class="p-1.5 hover:bg-ink/5 dark:hover:bg-white/10 rounded-lg text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white transition-colors cursor-pointer" title="Lista Numerada">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"></line><line x1="10" y1="12" x2="21" y2="12"></line><line x1="10" y1="18" x2="21" y2="18"></line><path d="M4 6h1v4"></path><path d="M4 10h2"></path><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"></path></svg>
    </button>
    <button type="button" data-action="click->tiptap#toggleTaskList" class="p-1.5 hover:bg-ink/5 dark:hover:bg-white/10 rounded-lg text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white transition-colors cursor-pointer" title="Lista de Tarefas">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><polyline points="9 11 12 14 17 9"/></svg>
    </button>
    <button type="button" data-action="click->tiptap#toggleBlockquote" class="p-1.5 hover:bg-ink/5 dark:hover:bg-white/10 rounded-lg text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white transition-colors cursor-pointer" title="Citação">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path></svg>
    </button>
    <button type="button" data-action="click->tiptap#toggleCodeBlock" class="p-1.5 hover:bg-ink/5 dark:hover:bg-white/10 rounded-lg text-ink/70 dark:text-white/70 hover:text-ink dark:hover:text-white transition-colors cursor-pointer" title="Bloco de Código">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
    </button>
  </div>

  <!-- Right Actions -->
  <div class="flex items-center gap-3 shrink-0">
    <div class="flex items-center gap-1.5 text-xs text-ink-light dark:text-white/60">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span class="text-[11px]">Salvo</span>
    </div>

    <!-- Exit Focus Mode Button -->
    <button type="button" data-action="click->document-actions#toggleZenMode" class="flex items-center gap-1.5 px-3 py-1 bg-ink/5 dark:bg-white/10 hover:bg-red-500/15 hover:text-red-600 dark:hover:text-red-300 text-ink dark:text-white/80 rounded-lg text-xs font-medium transition-colors cursor-pointer" title="Sair do Modo Foco">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      <span>Sair do Modo Foco</span>
      <span class="text-[10px] font-mono opacity-60 ml-0.5 px-1 py-0.2 bg-ink/10 dark:bg-black/30 rounded">Esc</span>
    </button>
  </div>
</header>

