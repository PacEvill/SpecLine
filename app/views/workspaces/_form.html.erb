        <%= form_with(model: workspace, class: "space-y-10") do |form| %>
          <% if workspace.errors.any? %>
            <div class="bg-red-50 text-red-600 p-4 rounded-xl text-sm border border-red-100 flex gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
              <div>
                <p class="font-medium mb-1">Não foi possível salvar o Workspace:</p>
                <ul class="list-disc pl-5 opacity-90">
                  <% workspace.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>

          <!-- Seção: Perfil Básico -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 border-b border-ink/5 dark:border-white/5 pb-10">
            <div class="md:col-span-1">
              <h3 class="text-base font-semibold text-ink dark:text-fable">Perfil Básico</h3>
              <p class="mt-2 text-sm text-ink-light dark:text-white/60">Informações públicas sobre seu espaço de trabalho e o objetivo do seu time.</p>
            </div>

            <div class="md:col-span-2 bg-white dark:bg-ink-paper border border-ink/5 dark:border-white/5 rounded-2xl p-6 sm:p-8 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] space-y-6">
              <div>
                <%= form.label :name, "Nome do Workspace*", class: "block text-sm font-medium text-ink dark:text-fable mb-2" %>
                <%= form.text_field :name, class: "w-full px-4 py-3 bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-terracotta/50 focus:border-terracotta dark:focus:border-terracotta focus:bg-white dark:focus:bg-ink-paper transition-all text-ink dark:text-fable placeholder:text-ink-light/50 dark:placeholder:text-white/30 font-medium duration-500", placeholder: "Ex: Acme Corp", required: true, autofocus: true %>
              </div>

              <div>
                <%= form.label :description, "Descrição", class: "block text-sm font-medium text-ink dark:text-fable mb-2" %>
                <%= form.text_area :description, rows: 2, class: "w-full px-4 py-3 bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-terracotta/50 focus:border-terracotta dark:focus:border-terracotta focus:bg-white dark:focus:bg-ink-paper transition-all text-ink dark:text-fable placeholder:text-ink-light/50 dark:placeholder:text-white/30 text-sm duration-500", placeholder: "O que sua equipe está construindo?" %>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <%= form.label :industry, "Setor / Indústria", class: "block text-sm font-medium text-ink dark:text-fable mb-2" %>
                  <div class="relative">
                    <%= form.select :industry, ["Tecnologia / Software", "Agência / Marketing", "Educação", "Varejo / E-commerce", "Saúde", "Finanças", "Outros"], { prompt: "Selecione..." }, class: "w-full px-4 py-3 pr-10 bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-terracotta/50 focus:border-terracotta dark:focus:border-terracotta focus:bg-white dark:focus:bg-ink-paper transition-all text-ink dark:text-fable text-sm appearance-none duration-500" %>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-ink-light dark:text-white/60">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                  </div>
                </div>
                <div>
                  <%= form.label :team_size, "Tamanho da Equipe", class: "block text-sm font-medium text-ink dark:text-fable mb-2" %>
                  <div class="relative">
                    <%= form.select :team_size, ["Apenas eu", "2-10 pessoas", "11-50 pessoas", "51-200 pessoas", "201+ pessoas"], { prompt: "Selecione..." }, class: "w-full px-4 py-3 pr-10 bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-terracotta/50 focus:border-terracotta dark:focus:border-terracotta focus:bg-white dark:focus:bg-ink-paper transition-all text-ink dark:text-fable text-sm appearance-none duration-500" %>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-ink-light dark:text-white/60">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Seção: Identidade & Presença -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 border-b border-ink/5 dark:border-white/5 pb-10">
            <div class="md:col-span-1">
              <h3 class="text-base font-semibold text-ink dark:text-fable">Identidade & Presença</h3>
              <p class="mt-2 text-sm text-ink-light dark:text-white/60">Personalize a aparência do seu espaço para os membros e clientes convidados.</p>
            </div>

            <div class="md:col-span-2 bg-white dark:bg-ink-paper border border-ink/5 dark:border-white/5 rounded-2xl p-6 sm:p-8 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] space-y-6">
              
              <!-- Logo Upload -->
              <div data-controller="image-preview">
                <%= form.label :logo, "Logo do Workspace", class: "block text-sm font-medium text-ink dark:text-fable mb-3" %>
                <div class="flex items-center gap-6">
                  <% if workspace.logo.attached? %>
                    <%= image_tag workspace.logo, class: "w-16 h-16 rounded-xl object-cover border border-ink/10 dark:border-white/10 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] shrink-0", data: { image_preview_target: "preview" } %>
                  <% else %>
                    <img data-image-preview-target="preview" class="hidden w-16 h-16 rounded-xl object-cover border border-ink/10 dark:border-white/10 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] shrink-0" />
                    <div data-image-preview-target="placeholder" class="w-16 h-16 rounded-xl bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 border-dashed flex items-center justify-center text-ink-light dark:text-white/60 shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
                    </div>
                  <% end %>
                  <div class="flex-1">
                    <label class="btn-secondary px-4 py-2 text-xs cursor-pointer rounded-lg border border-ink/10 dark:border-white/10 bg-white dark:bg-ink-paper hover:bg-[#FDFBF7] dark:hover:bg-white/5 text-ink dark:text-fable font-medium inline-block transition-colors duration-500">
                      Escolher Imagem
                      <%= form.file_field :logo, class: "hidden", accept: "image/*", data: { image_preview_target: "input", action: "change->image-preview#preview" } %>
                    </label>
                    <p class="text-[11px] text-ink-light dark:text-white/60 mt-1.5">Recomendado: JPG, PNG ou GIF. Máximo 2MB.</p>
                  </div>
                </div>
              </div>

              <hr class="border-ink/5 dark:border-white/5 my-2">

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="sm:col-span-2">
                  <%= form.label :website, "Website Oficial", class: "block text-sm font-medium text-ink dark:text-fable mb-2" %>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-ink-light dark:text-white/60">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                    </div>
                    <%= form.text_field :website, class: "w-full pl-10 pr-4 py-3 bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-terracotta/50 focus:border-terracotta dark:focus:border-terracotta focus:bg-white dark:focus:bg-ink-paper transition-all text-ink dark:text-fable placeholder:text-ink-light/50 dark:placeholder:text-white/30 text-sm duration-500", placeholder: "https://acme.com" %>
                  </div>
                </div>
                
                <div class="sm:col-span-2">
                  <%= form.label :color, "Cor de Destaque", class: "block text-sm font-medium text-ink dark:text-fable mb-2" %>
                  <div class="relative flex items-center gap-4 bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 p-3 rounded-xl">
                    <%= form.color_field :color, class: "h-10 w-10 p-0.5 rounded border border-ink/20 dark:border-white/20 cursor-pointer bg-white dark:bg-ink-paper shrink-0" %>
                    <div class="text-sm">
                      <p class="text-ink dark:text-fable font-medium">Cor da Marca</p>
                      <p class="text-ink-light dark:text-white/60 text-xs">Usada em botões e destaques visuais.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Seção: Operacional & Privacidade -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 pb-4">
            <div class="md:col-span-1">
              <h3 class="text-base font-semibold text-ink dark:text-fable">Operacional & Privacidade</h3>
              <p class="mt-2 text-sm text-ink-light dark:text-white/60">Configurações regionais, dados de faturamento e controle de acesso.</p>
            </div>

            <div class="md:col-span-2 bg-white dark:bg-ink-paper border border-ink/5 dark:border-white/5 rounded-2xl p-6 sm:p-8 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <%= form.label :company_number, "CNPJ / Documento", class: "block text-sm font-medium text-ink dark:text-fable mb-2" %>
                  <%= form.text_field :company_number, class: "w-full px-4 py-3 bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-terracotta/50 focus:border-terracotta dark:focus:border-terracotta focus:bg-white dark:focus:bg-ink-paper transition-all text-ink dark:text-fable placeholder:text-ink-light/50 dark:placeholder:text-white/30 text-sm duration-500", placeholder: "00.000.000/0001-00" %>
                </div>
                <div>
                  <%= form.label :billing_email, "Email de Faturamento", class: "block text-sm font-medium text-ink dark:text-fable mb-2" %>
                  <%= form.email_field :billing_email, class: "w-full px-4 py-3 bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-terracotta/50 focus:border-terracotta dark:focus:border-terracotta focus:bg-white dark:focus:bg-ink-paper transition-all text-ink dark:text-fable placeholder:text-ink-light/50 dark:placeholder:text-white/30 text-sm duration-500", placeholder: "financeiro@acme.com" %>
                </div>
              </div>

              <hr class="border-ink/5 dark:border-white/5 my-2">

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <%= form.label :timezone, "Fuso Horário", class: "block text-sm font-medium text-ink dark:text-fable mb-2" %>
                  <div class="relative">
                    <%= form.time_zone_select :timezone, nil, { default: "Brasilia" }, class: "w-full px-4 py-3 pr-10 bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-terracotta/50 focus:border-terracotta dark:focus:border-terracotta focus:bg-white dark:focus:bg-ink-paper transition-all text-ink dark:text-fable text-sm appearance-none duration-500" %>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-ink-light dark:text-white/60">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                  </div>
                </div>
                <div>
                  <%= form.label :visibility, "Visibilidade", class: "block text-sm font-medium text-ink dark:text-fable mb-2" %>
                  <div class="relative">
                    <%= form.select :visibility, [["Privado (Apenas convidados)", "private"], ["Restrito (Via link)", "restricted"], ["Público", "public"]], {}, class: "w-full px-4 py-3 pr-10 bg-[#FDFBF7] dark:bg-ink-darker border border-ink/10 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-terracotta/50 focus:border-terracotta dark:focus:border-terracotta focus:bg-white dark:focus:bg-ink-paper transition-all text-ink dark:text-fable text-sm appearance-none duration-500" %>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-ink-light dark:text-white/60">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Botão Salvar -->
          <div class="flex items-center justify-end pt-4 mt-8 pb-8 sm:pb-0">
            <%= form.submit button_text, class: "w-full sm:w-auto btn-primary px-8 py-3.5 cursor-pointer rounded-xl bg-ink text-white font-medium hover:bg-ink/90 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 shadow-md text-center" %>
          </div>
        <% end %>
