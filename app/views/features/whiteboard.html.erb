                          <path d="M 0 1 L 10 5 L 0 9 z" fill="#D97A5E" />
                        </marker>
                      </defs>
                      <!-- Client -> Gateway -->
                      <path d="M 184 69 L 244 69" fill="none" stroke="#CFA055" stroke-width="2.5" stroke-dasharray="5,4" class="animate-data-flow" marker-end="url(#embed-arrow-ochre)"/>
                      <!-- Gateway -> Rails -->
                      <path d="M 430 69 L 484 69" fill="none" stroke="#4B6B78" stroke-width="2.5" stroke-dasharray="5,4" class="animate-data-flow" marker-end="url(#embed-arrow-ocean)"/>
                      <!-- Rails -> Postgres -->
                      <path d="M 520 103 C 520 150, 340 150, 340 179" fill="none" stroke="#A5B5A1" stroke-width="2.5" stroke-dasharray="5,4" marker-end="url(#embed-arrow-sage)"/>
                      <!-- Rails -> Worker -->
                      <path d="M 580 103 L 580 179" fill="none" stroke="#D97A5E" stroke-width="2.5" stroke-dasharray="5,4" class="animate-data-flow" marker-end="url(#embed-arrow-terracotta)"/>
                    </svg>

                    <!-- Mini Architecture Nodes (Scaled & High-Fidelity) -->
                    <!-- Node 1: Web Client -->
                    <div style="left: 24px; top: 35px; width: 160px;" class="absolute z-20 p-3 rounded-xl bg-white dark:bg-ink-paper border-2 border-ochre shadow-md text-left">
                      <div class="flex items-center justify-between text-[9px] font-mono text-ochre font-bold">
                        <span>CLIENTE</span>
                        <span class="w-1.5 h-1.5 rounded-full bg-sage"></span>
                      </div>
                      <div class="font-bold text-[11px] text-ink dark:text-white mt-0.5">Web / Mobile App</div>
                      <div class="text-[9px] font-mono text-ink-light/50 dark:text-white/40">Cache Local SQLite</div>
                    </div>

                    <!-- Node 2: Traefik Proxy -->
                    <div style="left: 250px; top: 35px; width: 180px;" class="absolute z-20 p-3 rounded-xl bg-white dark:bg-ink-paper border-2 border-ocean shadow-md text-left">
                      <div class="flex items-center justify-between text-[9px] font-mono text-ocean font-bold">
                        <span>GATEWAY</span>
                        <span class="w-1.5 h-1.5 rounded-full bg-ocean animate-ping"></span>
                      </div>
                      <div class="font-bold text-[11px] text-ink dark:text-white mt-0.5">Traefik Edge Proxy</div>
                      <div class="text-[9px] font-mono text-ink-light/50 dark:text-white/40">HTTP/3 + WebSockets</div>
                    </div>

                    <!-- Node 3: Rails Core -->
                    <div style="left: 490px; top: 35px; width: 180px;" class="absolute z-20 p-3 rounded-xl bg-white dark:bg-ink-paper border-2 border-terracotta shadow-md text-left">
                      <div class="flex items-center justify-between text-[9px] font-mono text-terracotta font-bold">
                        <span>BACKEND CORE</span>
                        <span class="text-[8px] bg-terracotta/20 text-terracotta px-1 rounded font-bold">v8.0</span>
                      </div>
                      <div class="font-bold text-[11px] text-ink dark:text-white mt-0.5">Rails 8 Monolith</div>
                      <div class="text-[9px] font-mono text-ink-light/50 dark:text-white/40">Solid Cable Engine</div>
                    </div>

                    <!-- Node 4: PostgreSQL -->
                    <div style="left: 250px; top: 185px; width: 180px;" class="absolute z-20 p-3 rounded-xl bg-white dark:bg-ink-paper border-2 border-sage shadow-md text-left">
                      <div class="flex items-center justify-between text-[9px] font-mono text-sage font-bold">
                        <span>BANCO ACID</span>
                        <span class="w-1.5 h-1.5 rounded-full bg-sage"></span>
                      </div>
                      <div class="font-bold text-[11px] text-ink dark:text-white mt-0.5">PostgreSQL 16</div>
                      <div class="text-[9px] font-mono text-ink-light/50 dark:text-white/40">Colunas JSONB</div>
                    </div>

                    <!-- Node 5: Solid Queue Worker -->
                    <div style="left: 490px; top: 185px; width: 180px;" class="absolute z-20 p-3 rounded-xl bg-white dark:bg-ink-paper border border-ink/20 dark:border-white/20 shadow-md text-left">
                      <div class="flex items-center justify-between text-[9px] font-mono text-ink/60 dark:text-white/60 font-bold">
                        <span>WORKER ASYNC</span>
                        <span class="text-ochre text-[8px] font-bold">SolidQueue</span>
                      </div>
                      <div class="font-bold text-[11px] text-ink dark:text-white mt-0.5">Export Daemon</div>
                      <div class="text-[9px] font-mono text-ink-light/50 dark:text-white/40">Gera SVG & PDF</div>
                    </div>

                    <!-- Sticky note on diagram -->
                    <div style="left: 24px; top: 185px; width: 160px;" class="absolute z-20 p-2.5 rounded-lg bg-[#FFF7D1] text-[#634A00] dark:bg-[#E6C84F] dark:text-[#2A2300] shadow-md rotate-[-2deg] text-[10px] font-sans border border-yellow-300">
                      <div class="font-mono text-[8px] font-bold uppercase mb-0.5">📌 Nota da RFC</div>
                      <div class="leading-tight">Atualizado via Whiteboard em tempo real.</div>
                    </div>

                  </div>
                </div>

                <!-- Whiteboard Embed Caption & Sync Helper -->
                <div class="px-4 py-2 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[10px] font-mono text-ink-light/60 dark:text-white/50 border-t border-ink/10 dark:border-white/10 mt-1">
                  <span>Figura 1.1 — Topologia de dados. Conectado dinamicamente ao Quadro #04.</span>
                  <span class="text-ochre font-semibold">Sem screenshots desatualizados: o diagrama vive no documento.</span>
                </div>

              </div>

            </div>

            <!-- Section 3: Conclusão e Critérios de Aceite -->
            <div class="space-y-3 pt-2">
              <h2 class="font-serif text-xl font-bold text-ink dark:text-white flex items-center gap-2">
                <span class="font-mono text-xs text-ochre font-normal">03.</span>
                Critérios de Aceite da Arquitetura
              </h2>
              
              <ul class="space-y-2 text-xs font-mono text-ink-light dark:text-white/80">
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-sage shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Conexões WebSockets estabelecidas em menos de 100ms pelo Traefik.</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-sage shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Solid Cable operando diretamente com persistência de buffer no PostgreSQL.</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-sage shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Sincronização bidirecional entre documentos técnicos e quadros visuais.</span>
                </li>
              </ul>
            </div>

          </article>

        </div>

      </div>

    </div>
  </section>

  <!-- ACTION TOAST NOTIFICATION -->
  <div data-whiteboard-workbench-target="toast" class="hidden fixed bottom-10 left-1/2 -translate-x-1/2 z-50 bg-ink dark:bg-white text-white dark:text-ink px-5 py-3 rounded-xl shadow-2xl font-mono text-xs font-bold flex items-center gap-2 border border-white/20 animate-pop-in">
    <span class="w-2 h-2 rounded-full bg-ochre animate-ping"></span>
    <span data-whiteboard-workbench-target="toastMsg">Ação executada com sucesso!</span>
  </div>

  <!-- OS 3 PILARES DO PENSAMENTO VISUAL -->
  <section class="border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#151517] p-8 md:p-20 relative">
    <div class="max-w-6xl mx-auto space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="font-mono text-xs text-ochre font-bold uppercase tracking-widest">Sem Fronteiras Entre Ideia e Código</span>
        <h2 class="text-3xl md:text-5xl font-serif font-light text-ink dark:text-white">
          Arquitetura visual conectada ao que é construído.
        </h2>
        <p class="font-serif italic text-lg text-ink-light dark:text-white/70">
          Chega de quadros brancos que viram screenshots obsoletos esquecidos em pastas remotas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="p-8 border border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper hover-card-lift space-y-3">
          <div class="font-mono text-xs text-ochre font-bold uppercase">[01] Código é Diagrama</div>
          <h3 class="font-serif text-xl font-bold text-ink dark:text-white">Mermaid.js Nativo</h3>
          <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
            Escreva fluxos, diagramas de sequência ou gráficos de arquitetura em texto puro. Mantenha diagramas versionados em commits sem precisar de designers para atualizar caixinhas.
          </p>
        </div>

        <div class="p-8 border border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper hover-card-lift space-y-3">
          <div class="font-mono text-xs text-sage font-bold uppercase">[02] Liberdade Espacial</div>
          <h3 class="font-serif text-xl font-bold text-ink dark:text-white">Canvas Infinito Suave</h3>
          <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
            Para brainstorming, wireframes e post-its rápidos, use o canvas infinito com navegação fluida a 60 FPS, conexões inteligentes entre formas e suporte a múltiplos quadros por projeto.
          </p>
        </div>

        <div class="p-8 border border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper hover-card-lift space-y-3">
          <div class="font-mono text-xs text-ocean font-bold uppercase">[03] Nativamente Integrado</div>
          <h3 class="font-serif text-xl font-bold text-ink dark:text-white">Incorporação em Specs</h3>
          <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
            Incorpore qualquer quadro ou recorte dentro de especificações e PRDs no SpecLine Docs. Quando alguém altera a arquitetura, a especificação se mantém sempre atualizada.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- CALL TO ACTION SECTION -->
  <section class="p-12 md:p-24 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-ink text-center relative overflow-hidden">
    <div class="max-w-3xl mx-auto space-y-6 relative z-10">
      <p class="font-mono text-xs tracking-widest text-ochre uppercase font-bold">Visual Primeiro, Código Sempre</p>
      <h2 class="font-serif font-light text-4xl md:text-6xl tracking-tight text-ink dark:text-white">
        Dê espaço para as ideias ganharem forma.
      </h2>
      <p class="font-serif italic text-lg text-ink-light dark:text-white/70">
        Quadros brancos infinitos e diagramas Mermaid integrados em um só lugar.
      </p>
      <div class="pt-4 flex justify-center">
        <%= link_to new_user_registration_path, class: "group px-8 py-4 bg-ink text-white dark:bg-white dark:text-ink hover:bg-ochre dark:hover:bg-ochre dark:hover:text-white font-mono text-xs uppercase tracking-widest font-semibold flex items-center gap-3 shadow-xl hover:scale-105 active:scale-95 transition-all cursor-pointer" do %>
          <span>Criar Conta Gratuita</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        <% end %>
      </div>
    </div>
  </section>

  <%= render 'shared/marketing_footer' %>
</div>
