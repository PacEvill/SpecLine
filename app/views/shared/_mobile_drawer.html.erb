<% current_ws = local_assigns[:workspace] || (@workspace&.persisted? ? @workspace : nil) || current_user&.workspaces&.first %>
<div class="md:hidden">
  <!-- Backdrop Overlay -->
  <div data-mobile-drawer-target="backdrop" data-action="click->mobile-drawer#close" class="fixed inset-0 bg-ink/40 dark:bg-black/60 backdrop-blur-xs z-50 transition-opacity duration-300 opacity-0 hidden"></div>

  <!-- Drawer Sliding Container -->
  <div data-mobile-drawer-target="drawer" class="fixed inset-y-0 left-0 w-80 max-w-[85vw] h-full bg-white dark:bg-ink-paper border-r border-ink/10 dark:border-white/10 shadow-2xl z-50 transform -translate-x-full transition-transform duration-300 flex flex-col overflow-y-auto">
    <!-- Header of Drawer -->
    <div class="px-5 py-4 border-b border-ink/5 dark:border-white/5 flex items-center justify-between bg-[#FDFBF7] dark:bg-ink-darker">
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-terracotta"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></svg>
        <span class="font-serif font-bold text-base text-ink dark:text-fable">SpecLine</span>
      </div>
      <button type="button" data-action="click->mobile-drawer#close" class="p-1.5 text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-white rounded-lg hover:bg-ink/5 dark:hover:bg-white/5 transition-colors cursor-pointer" aria-label="Fechar menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <% if current_ws&.persisted? %>
      <!-- Workspace Info -->
      <div class="px-5 py-4 border-b border-ink/5 dark:border-white/5 flex items-center justify-between">
        <div class="flex items-center gap-3 min-w-0">
          <% if current_ws.logo.attached? %>
            <%= image_tag current_ws.logo, class: "w-9 h-9 rounded-xl object-cover border border-ink/10 dark:border-white/10 shrink-0" %>
          <% else %>
            <div class="w-9 h-9 rounded-xl flex items-center justify-center font-serif text-sm font-bold shrink-0 shadow-sm" style="background-color: <%= current_ws.color.presence || '#D97A5E' %>15; color: <%= current_ws.color.presence || '#D97A5E' %>; border: 1px solid <%= current_ws.color.presence || '#D97A5E' %>40;">
              <%= current_ws.name[0].upcase %>
            </div>
          <% end %>
          <div class="flex flex-col min-w-0">
            <h2 class="text-sm font-serif font-bold text-ink dark:text-fable truncate leading-tight"><%= current_ws.name %></h2>
            <span class="text-[10px] text-ink-light/60 dark:text-white/40 truncate"><%= current_ws.projects.count %> projetos</span>
          </div>
        </div>
        <%= link_to workspaces_path, data: { action: "click->mobile-drawer#close" }, class: "text-xs text-terracotta font-medium hover:underline shrink-0" do %>
          Trocar
        <% end %>
      </div>

      <!-- Projetos do Workspace -->
      <div class="px-4 py-4 flex-1">
        <div class="flex items-center justify-between px-2 mb-2">
          <h3 class="text-[11px] font-bold uppercase tracking-wider text-ink-light/70 dark:text-white/40">Projetos</h3>
          <%= link_to new_workspace_project_path(current_ws), data: { turbo_frame: "modal", action: "click->mobile-drawer#close" }, class: "text-ink-light dark:text-white/50 hover:text-terracotta transition-colors p-1 rounded-lg hover:bg-ink/5 dark:hover:bg-white/5", title: "Novo Projeto" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <% end %>
        </div>

        <div class="space-y-1">
          <% current_ws.projects.select(&:persisted?).each do |proj| %>
            <% is_active = (defined?(@project) && @project&.persisted? && @project == proj) %>
            <%= link_to workspace_project_path(current_ws, proj), data: { action: "click->mobile-drawer#close" }, class: "group flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-all #{is_active ? 'bg-ink/5 dark:bg-white/10 text-ink dark:text-fable font-semibold shadow-xs' : 'text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/5 hover:text-ink dark:hover:text-fable'}" do %>
              <div class="flex items-center gap-2.5 min-w-0">
                <% if proj.logo.attached? %>
                  <%= image_tag proj.logo, class: "w-5 h-5 rounded-lg object-cover shrink-0" %>
                <% elsif proj.icon.present? %>
                  <span class="text-sm shrink-0 leading-none"><%= proj.icon %></span>
                <% else %>
                  <div class="w-5 h-5 rounded-lg flex items-center justify-center font-serif text-[10px] font-bold shrink-0 <%= is_active ? 'bg-terracotta/20 text-terracotta' : 'bg-ink/5 dark:bg-white/5 text-ink-light dark:text-white/60' %>">
                    <%= proj.identifier_prefix.presence || proj.name[0..1].upcase %>
                  </div>
                <% end %>
                <span class="truncate"><%= proj.name %></span>
              </div>
              <% if is_active %>
                <span class="w-1.5 h-1.5 rounded-full bg-terracotta shrink-0"></span>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <!-- Tags do Workspace -->
        <% persisted_labels = current_ws.labels.select(&:persisted?) %>
        <% if persisted_labels.any? %>
          <div class="mt-6 pt-4 border-t border-ink/5 dark:border-white/5 px-2">
            <h4 class="text-[11px] font-bold uppercase tracking-wider text-ink-light/70 dark:text-white/40 mb-2">Tags</h4>
            <div class="flex flex-wrap gap-1.5">
              <% persisted_labels.each do |label| %>
                <div class="inline-flex items-center text-[10px] font-semibold px-2 py-0.5 rounded-full border border-black/5" style="background-color: <%= label.color %>15; color: <%= label.color %>;">
                  <div class="w-1.5 h-1.5 rounded-full mr-1.5" style="background-color: <%= label.color %>"></div>
                  <%= label.name %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-6 text-center">
        <%= link_to "Ver todos os Workspaces", workspaces_path, data: { action: "click->mobile-drawer#close" }, class: "text-sm text-terracotta font-medium hover:underline" %>
      </div>
    <% end %>

    <!-- Drawer Footer: Profile & Logout -->
    <div class="px-5 py-4 border-t border-ink/5 dark:border-white/5 mt-auto bg-[#FDFBF7] dark:bg-ink-darker flex items-center justify-between">
      <div class="flex items-center gap-2.5 min-w-0">
        <% if current_user&.avatar&.attached? %>
          <%= image_tag current_user.avatar, class: "w-8 h-8 rounded-full object-cover border border-ink/10 dark:border-white/10 shrink-0" %>
        <% else %>
          <div class="w-8 h-8 rounded-full bg-terracotta/10 border border-terracotta/20 text-terracotta flex items-center justify-center font-serif text-xs font-bold shrink-0">
            <%= current_user&.full_name.presence&.[](0)&.upcase || 'U' %>
          </div>
        <% end %>
        <div class="flex flex-col min-w-0">
          <span class="text-xs font-medium text-ink dark:text-fable truncate leading-tight"><%= current_user&.full_name %></span>
          <span class="text-[10px] text-ink-light/60 dark:text-white/40 truncate"><%= current_user&.email %></span>
        </div>
      </div>
      <%= button_to destroy_user_session_path, method: :delete, data: { turbo: false }, class: "p-1.5 text-ink-light dark:text-white/60 hover:text-red-600 rounded-lg transition-colors cursor-pointer", title: "Sair" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
      <% end %>
    </div>
  </div>
</div>
