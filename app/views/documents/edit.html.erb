<div class="flex-1 bg-white dark:bg-ink-darker min-h-screen flex flex-col font-sans">
  <%= form_with(model: [@workspace, @project, @document], class: "h-full flex flex-col") do |form| %>
    <!-- Editor Header with Actions -->
    <header class="h-14 px-6 flex items-center justify-between sticky top-0 bg-white/95 dark:bg-ink-darker/95 backdrop-blur-md z-20 border-b border-ink/5 dark:border-white/5">
      <div class="flex items-center gap-2">
        <%= link_to workspace_project_document_path(@workspace, @project, @document), class: "p-1.5 text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 rounded transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        <% end %>
        <div class="text-sm text-ink-light dark:text-white/60 flex items-center gap-1.5 ml-1">
          <span class="hover:underline cursor-pointer"><%= @project.name %></span>
          <span class="text-ink/30 dark:text-white/30 text-xs">/</span>
          <span class="text-ink dark:text-fable font-medium truncate max-w-[200px]"><%= @document.title %></span>
        </div>
      </div>
      
      <div class="flex items-center gap-3">
        <span class="text-[11px] text-ink-light/50 dark:text-white/40">Editando documento</span>
        <%= form.submit "Salvar Alterações", class: "px-4 py-1.5 bg-ink text-white dark:bg-fable dark:text-ink text-xs font-semibold rounded-lg shadow-sm hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white transition-all cursor-pointer" %>
      </div>
    </header>

    <!-- Editor Body -->
    <main class="flex-1 w-full max-w-[800px] mx-auto px-8 sm:px-12 py-10 lg:py-16">
      
      <!-- Icon/Emoji Selector -->
      <div class="mb-4">
        <div class="group relative inline-flex items-center justify-center w-24 h-24 rounded-2xl hover:bg-ink/5 dark:hover:bg-white/5 transition-colors cursor-pointer border border-transparent hover:border-ink/10 dark:hover:border-white/10">
          <%= form.text_field :icon, 
              class: "w-full h-full text-[56px] leading-none bg-transparent border-none p-0 text-center cursor-pointer outline-none focus:ring-0", 
              style: "box-shadow: none;", 
              placeholder: "📄", 
              oninput: "this.value = this.value.replace(/[a-zA-Z0-9]/g, ''); if(this.value.length > 2) this.value = this.value.slice(0, 2);",
              title: "Cole um emoji aqui" %>
          
          <div class="absolute -top-8 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-ink dark:bg-fable text-white dark:text-ink text-[11px] font-medium py-1 px-2.5 rounded whitespace-nowrap pointer-events-none z-10 shadow-sm">
            Cole um emoji (Ctrl+Cmd+Space)
          </div>
        </div>
      </div>

      <!-- Title -->
      <div class="mb-6">
        <%= form.text_area :title, rows: 1, class: "w-full text-4xl sm:text-5xl font-bold tracking-tight bg-transparent border-none p-0 text-ink dark:text-fable placeholder-ink/20 dark:placeholder-white/20 resize-none overflow-hidden outline-none focus:ring-0", style: "box-shadow: none;", placeholder: "Título sem nome", required: true, oninput: "this.style.height = ''; this.style.height = this.scrollHeight + 'px'" %>
      </div>

      <!-- Tiptap Editor Container -->
      <div data-controller="tiptap" class="mt-8">
        <div class="hidden">
          <%= form.rich_text_area :content %>
        </div>
        <div data-tiptap-target="editor" class="w-full"></div>
      </div>
    </main>
  <% end %>
</div>
