<% content_for(:sidebar) do %>
  <%= render "shared/workspace_sidebar", workspace: @workspace, current_project: @project %>
<% end %>

<div class="flex-1 bg-white dark:bg-ink min-h-screen flex flex-row font-sans overflow-hidden transition-colors duration-500" data-controller="document-actions">
  <div class="flex-1 flex flex-col min-w-0 h-screen overflow-y-auto hide-scrollbar">
    <%= form_with(model: [@workspace, @project, @document], class: "min-h-full flex flex-col") do |form| %>
      <%= form.hidden_field :parent_id %>
      <%= form.hidden_field :is_folder %>
      
      <!-- Top Bar -->
      <header class="h-14 px-4 sm:px-8 flex items-center justify-between sticky top-0 bg-white/90 dark:bg-ink/90 backdrop-blur-xl z-50 border-b border-ink/5 dark:border-white/5 shrink-0 transition-colors">
        <div class="flex items-center gap-2 min-w-0">
          <%= link_to workspace_project_path(@workspace, @project, view: 'documents'), class: "p-2 text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable hover:bg-ink/5 dark:hover:bg-white/10 rounded-xl transition-colors shrink-0", title: "Voltar para Documentos" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
          <% end %>
          
          <nav class="flex items-center text-xs font-medium text-ink-light dark:text-white/50 truncate">
            <%= link_to @project.name, workspace_project_path(@workspace, @project, view: 'documents'), class: "hover:text-ink dark:hover:text-fable transition-colors cursor-pointer truncate max-w-[140px]" %>
            <span class="mx-1.5 text-ink/20 dark:text-white/20">/</span>
            <% if @document.parent %>
              <%= link_to @document.parent.title.presence || "Documento", workspace_project_document_path(@workspace, @project, @document.parent), class: "hover:text-ink dark:hover:text-fable transition-colors truncate max-w-[140px]" %>
              <span class="mx-1.5 text-ink/20 dark:text-white/20">/</span>
            <% end %>
            <span class="text-ink dark:text-fable font-semibold truncate max-w-[200px] flex items-center gap-1.5">
              <span class="shrink-0 flex items-center"><%= document_icon_tag(@document, size_class: "w-3.5 h-3.5") %></span>
              <span><%= @document.is_folder? ? "Nova Pasta" : "Novo Documento" %></span>
            </span>
          </nav>
        </div>

        <div class="flex items-center gap-2">
          <%= link_to "Descartar", workspace_project_path(@workspace, @project, view: 'documents'), class: "px-3.5 py-1.5 text-xs font-medium text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable hover:bg-ink/5 dark:hover:bg-white/10 rounded-xl transition-colors" %>
          <%= form.submit @document.is_folder? ? "Criar Pasta" : "Criar Documento", class: "px-4 py-1.5 bg-ink text-fable dark:bg-fable dark:text-ink text-xs font-bold rounded-xl shadow-sm hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white transition-all cursor-pointer" %>
        </div>
      </header>

      <div data-controller="tiptap" class="flex-1 w-full flex flex-col items-center relative">
        
        <!-- Cover Banner Image Container -->
        <%= form.hidden_field :cover_image, value: @document.cover_image.to_s, data: { document_actions_target: "coverInput" } %>
        
        <div data-document-actions-target="coverContainer" class="w-full h-44 sm:h-52 relative group transition-all duration-300 overflow-hidden" style="<%= @document.cover_image.present? ? "background: #{@document.cover_image}; background-size: cover; background-position: center;" : 'display: none;' %>">
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-end p-4 gap-2">
            <button type="button" data-action="click->document-actions#toggleCoverPicker" class="px-3 py-1.5 bg-black/60 hover:bg-black/80 backdrop-blur-md text-white text-xs font-medium rounded-xl border border-white/20 transition-all flex items-center gap-1.5 shadow-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
              Alterar Capa
            </button>
            <button type="button" data-action="click->document-actions#removeCover" class="px-3 py-1.5 bg-black/60 hover:bg-red-600/80 backdrop-blur-md text-white text-xs font-medium rounded-xl border border-white/20 transition-all flex items-center gap-1.5 shadow-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              Remover
            </button>
          </div>
        </div>

        <!-- Floating Selection Bubble Menu & Slash Commands Popover -->
        <%= render "documents/editor_menus" %>

        <!-- Sticky Formatting Toolbar -->
        <div class="w-full sticky top-14 z-40 bg-white/95 dark:bg-ink/95 backdrop-blur-md border-b border-ink/5 dark:border-white/5 flex justify-center py-2 px-4 shadow-sm transition-colors">
          <div data-tiptap-target="toolbar" class="hidden flex items-center gap-1 w-full max-w-[850px] overflow-x-auto hide-scrollbar">
            <button type="button" data-action="click->tiptap#toggleH1" class="px-2.5 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors text-xs font-bold whitespace-nowrap" title="Título Principal (H1)">H1</button>
            <button type="button" data-action="click->tiptap#toggleH2" class="px-2.5 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors text-xs font-bold whitespace-nowrap" title="Subtítulo (H2)">H2</button>
            <button type="button" data-action="click->tiptap#toggleH3" class="px-2.5 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors text-xs font-bold whitespace-nowrap" title="Seção (H3)">H3</button>
            <div class="w-px h-4 bg-ink/10 dark:bg-white/10 mx-1 shrink-0"></div>
            
            <button type="button" data-action="click->tiptap#toggleBold" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors font-bold font-serif shrink-0 text-sm" title="Negrito (Ctrl+B)">B</button>
            <button type="button" data-action="click->tiptap#toggleItalic" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors italic font-serif shrink-0 text-sm" title="Itálico (Ctrl+I)">I</button>
            <button type="button" data-action="click->tiptap#toggleStrike" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors line-through font-serif shrink-0 text-sm" title="Riscado">S</button>
            <button type="button" data-action="click->tiptap#toggleCode" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors font-mono shrink-0 text-xs" title="Código Inline">&lt;/&gt;</button>
            <button type="button" data-action="click->tiptap#setLink" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors shrink-0" title="Inserir Link">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            </button>
            <div class="w-px h-4 bg-ink/10 dark:bg-white/10 mx-1 shrink-0"></div>
            
            <button type="button" data-action="click->tiptap#toggleBulletList" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors shrink-0" title="Lista com Marcadores">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            </button>
            <button type="button" data-action="click->tiptap#toggleOrderedList" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors shrink-0" title="Lista Numerada">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"></line><line x1="10" y1="12" x2="21" y2="12"></line><line x1="10" y1="18" x2="21" y2="18"></line><path d="M4 6h1v4"></path><path d="M4 10h2"></path><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"></path></svg>
            </button>
            <button type="button" data-action="click->tiptap#toggleTaskList" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors shrink-0" title="Lista de Tarefas">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><polyline points="9 11 12 14 17 9"/></svg>
            </button>
            <button type="button" data-action="click->tiptap#toggleBlockquote" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors shrink-0" title="Citação">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path></svg>
            </button>
            <button type="button" data-action="click->tiptap#toggleCodeBlock" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors shrink-0" title="Bloco de Código">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            </button>
            <button type="button" data-action="click->tiptap#setHorizontalRule" class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors shrink-0" title="Linha Divisória">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"></line></svg>
            </button>
          </div>
        </div>

        <!-- Document Content Canvas -->
        <main class="w-full max-w-[850px] px-6 sm:px-12 py-10 lg:py-14">
          
          <!-- Hover Header Controls -->
          <div class="flex items-center gap-2 mb-4">
            <button type="button" data-action="click->document-actions#toggleCoverPicker" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-medium text-ink-light dark:text-white/50 hover:text-ink dark:hover:text-fable hover:bg-ink/5 dark:hover:bg-white/5 transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              <span><%= @document.cover_image.present? ? "Alterar Capa" : "Adicionar Capa" %></span>
            </button>

            <!-- Cover Presets Picker Popover -->
            <div data-document-actions-target="coverPicker" class="hidden absolute top-28 left-6 sm:left-12 z-50 p-4 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-2xl shadow-2xl w-80 animate-[scale-in_0.15s_ease-out_forwards]">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-ink-light dark:text-white/60">Escolha uma Capa</span>
                <button type="button" data-action="click->document-actions#closeCoverPicker" class="text-ink-light hover:text-ink dark:text-white/40 dark:hover:text-white">✕</button>
              </div>
              <div class="grid grid-cols-2 gap-2 mb-3">
                <button type="button" data-action="click->document-actions#setPresetCover" data-gradient="linear-gradient(135deg, #D97A5E, #3D5A80)" class="h-14 rounded-xl border border-white/20 shadow-sm relative group overflow-hidden" style="background: linear-gradient(135deg, #D97A5E, #3D5A80);">
                  <span class="text-[10px] text-white font-medium drop-shadow absolute bottom-1 left-2">Terracotta Dusk</span>
                </button>
                <button type="button" data-action="click->document-actions#setPresetCover" data-gradient="linear-gradient(135deg, #10B981, #047857)" class="h-14 rounded-xl border border-white/20 shadow-sm relative group overflow-hidden" style="background: linear-gradient(135deg, #10B981, #047857);">
                  <span class="text-[10px] text-white font-medium drop-shadow absolute bottom-1 left-2">Emerald Forest</span>
                </button>
                <button type="button" data-action="click->document-actions#setPresetCover" data-gradient="linear-gradient(135deg, #6366F1, #4338CA)" class="h-14 rounded-xl border border-white/20 shadow-sm relative group overflow-hidden" style="background: linear-gradient(135deg, #6366F1, #4338CA);">
                  <span class="text-[10px] text-white font-medium drop-shadow absolute bottom-1 left-2">Indigo Waves</span>
                </button>
                <button type="button" data-action="click->document-actions#setPresetCover" data-gradient="linear-gradient(135deg, #F59E0B, #D97706)" class="h-14 rounded-xl border border-white/20 shadow-sm relative group overflow-hidden" style="background: linear-gradient(135deg, #F59E0B, #D97706);">
                  <span class="text-[10px] text-white font-medium drop-shadow absolute bottom-1 left-2">Amber Sunset</span>
                </button>
                <button type="button" data-action="click->document-actions#setPresetCover" data-gradient="linear-gradient(135deg, #374151, #111827)" class="h-14 rounded-xl border border-white/20 shadow-sm relative group overflow-hidden" style="background: linear-gradient(135deg, #374151, #111827);">
                  <span class="text-[10px] text-white font-medium drop-shadow absolute bottom-1 left-2">Minimal Slate</span>
                </button>
                <button type="button" data-action="click->document-actions#setPresetCover" data-gradient="linear-gradient(135deg, #EC4899, #8B5CF6)" class="h-14 rounded-xl border border-white/20 shadow-sm relative group overflow-hidden" style="background: linear-gradient(135deg, #EC4899, #8B5CF6);">
                  <span class="text-[10px] text-white font-medium drop-shadow absolute bottom-1 left-2">Cyberpunk</span>
                </button>
              </div>
              <% if @document.cover_image.present? %>
                <button type="button" data-action="click->document-actions#removeCover" class="w-full py-1.5 text-xs text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-xl transition-colors font-medium">Remover Capa</button>
              <% end %>
            </div>
          </div>
          
          <% if @document.is_folder? %>
            <!-- Fixed Non-Editable Vector Folder Icon -->
            <div class="mb-6 w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-amber-500/10 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center justify-center shadow-xs select-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="currentColor" class="opacity-90"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
            </div>
          <% else %>
            <!-- Emoji Icon Picker (Document Only) -->
            <div class="mb-6 relative inline-block" data-controller="emoji-picker">
              <%= form.hidden_field :icon, data: { emoji_picker_target: "input" } %>
              
              <button type="button" 
                      data-action="click->emoji-picker#togglePicker"
                      data-emoji-picker-target="button"
                      class="flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 text-4xl sm:text-5xl rounded-2xl hover:bg-ink/5 dark:hover:bg-white/5 transition-all border border-transparent hover:border-ink/10 dark:hover:border-white/10 leading-none cursor-pointer group"
                      title="Clique para escolher um emoji">
                <% if @document.icon.present? %>
                  <span><%= @document.icon %></span>
                <% else %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-terracotta"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                <% end %>
              </button>
              
              <!-- Emoji Picker Popover -->
              <div data-emoji-picker-target="pickerContainer" class="hidden absolute top-full left-0 z-50 mt-2 shadow-2xl rounded-2xl overflow-hidden border border-ink/10 dark:border-white/10">
                <!-- Web component goes here -->
              </div>
            </div>
          <% end %>

          <!-- Document Title Input -->
          <div class="mb-8">
            <%= form.text_area :title, rows: 1, class: "w-full text-4xl sm:text-5xl lg:text-6xl font-serif font-bold tracking-tight bg-transparent border-none p-0 text-ink dark:text-fable placeholder-ink/20 dark:placeholder-white/20 resize-none overflow-hidden outline-none focus:ring-0", style: "box-shadow: none;", placeholder: @document.is_folder? ? "Nome da Pasta" : "Sem Título", autofocus: true, required: true, oninput: "this.style.height = ''; this.style.height = this.scrollHeight + 'px'" %>
          </div>

          <!-- Tiptap Editor Root -->
          <div class="relative min-h-[500px]">
            <div class="hidden">
              <%= form.hidden_field :content, value: @document.content.to_s, id: "document_content_hidden", data: { tiptap_target: "input" } %>
            </div>
            <div data-tiptap-target="editor" class="w-full"></div>
          </div>
        </main>
      </div>
    <% end %>
  </div>
</div>
