<div class="h-screen w-full flex bg-fable-light dark:bg-ink">
  
  <!-- Left Side: Brutalist Art -->
  <div class="hidden lg:flex w-1/2 bg-fable-dark dark:bg-ink-darker text-ink dark:text-white flex-col justify-between p-12 border-r border-ink/15 dark:border-white/10 relative overflow-hidden group">
    <div class="absolute inset-0 bg-grid"></div>
    <div class="absolute inset-0 bg-noise pointer-events-none"></div>
    
    <div class="relative z-20">
      <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-terracotta"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></svg>
        <span class="font-sans font-semibold text-2xl tracking-tight text-ink dark:text-white">SpecLine</span>
      </a>
    </div>

    <!-- Art Concept -->
    <div class="relative z-20 flex flex-col justify-center h-full">
      <!-- Animated Lines (Terracotta & Sage) -->
      <div class="flex gap-2 mb-8">
        <div class="w-12 h-1 bg-terracotta transition-all duration-700 group-hover:w-24"></div>
        <div class="w-4 h-1 bg-sage transition-all duration-700 delay-100 group-hover:w-16"></div>
      </div>
      
      <div class="font-serif text-6xl xl:text-[5.5rem] 2xl:text-[6.5rem] leading-[0.9] tracking-tighter text-ink/50 dark:text-white/50 select-none transition-colors duration-700 group-hover:text-ink/75 dark:group-hover:text-white/75">
        TRABALHO<br>
        PROFUNDO<br>
        <span class="font-serif-italic italic text-terracotta/60 dark:text-terracotta/30 group-hover:text-terracotta dark:group-hover:text-terracotta/90 transition-colors duration-700">EXIGE</span><br>
        <span class="text-sage/70 dark:text-sage/30 group-hover:text-sage dark:group-hover:text-sage/90 transition-colors duration-700 delay-100">SILÊNCIO</span>
      </div>
    </div>
    
    <div class="relative z-20 flex justify-between items-end">
  <p class="text-ink/40 dark:text-white/40 text-[10px] uppercase tracking-widest font-mono mb-4">Construa o futuro. Evite a entropia.</p>
</div>

<!-- Miniature Marquee -->
<div class="w-full overflow-hidden whitespace-nowrap border-t border-ink/10 dark:border-white/10 pt-4 pb-4 absolute bottom-0 left-0 z-20 group/marquee">
  <div class="font-mono text-[9px] tracking-[0.3em] uppercase text-terracotta animate-marquee group-hover/marquee:[animation-play-state:paused] opacity-80">
++ A CLAREZA ANTECEDE A EXECUÇÃO ++ O TRABALHO INVISÍVEL É O MAIS IMPORTANTE ++ SISTEMAS RÍGIDOS, MENTES CRIATIVAS ++ ORGANIZE O CAOS, DOMINE O TEMPO ++ A DISCIPLINA É A VERDADEIRA LIBERDADE ++ ++ A CLAREZA ANTECEDE A EXECUÇÃO ++ O TRABALHO INVISÍVEL É O MAIS IMPORTANTE ++ SISTEMAS RÍGIDOS, MENTES CRIATIVAS ++ ORGANIZE O CAOS, DOMINE O TEMPO ++ A DISCIPLINA É A VERDADEIRA LIBERDADE ++ ++ A CLAREZA ANTECEDE A EXECUÇÃO ++ O TRABALHO INVISÍVEL É O MAIS IMPORTANTE ++ SISTEMAS RÍGIDOS, MENTES CRIATIVAS ++ ORGANIZE O CAOS, DOMINE O TEMPO ++ A DISCIPLINA É A VERDADEIRA LIBERDADE ++ ++ A CLAREZA ANTECEDE A EXECUÇÃO ++ O TRABALHO INVISÍVEL É O MAIS IMPORTANTE ++ SISTEMAS RÍGIDOS, MENTES CRIATIVAS ++ ORGANIZE O CAOS, DOMINE O TEMPO ++ A DISCIPLINA É A VERDADEIRA LIBERDADE ++ 
  </div>
</div>

  </div>

  <!-- Right Side: Form (Signup) -->
  <div class="w-full lg:w-1/2 flex flex-col justify-center px-8 sm:px-16 xl:px-24">
    
    <div class="w-full max-w-sm mx-auto">
      
      <!-- Mobile Logo -->
      <a href="/" class="flex lg:hidden items-center gap-3 mb-12 hover:opacity-80 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-terracotta"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></svg>
        <span class="font-sans font-semibold text-2xl tracking-tight text-ink dark:text-fable-light">SpecLine</span>
      </a>

      <div>
        <h2 class="text-4xl font-serif font-light text-ink dark:text-fable-light mb-3">A fundação começa aqui</h2>
        <p class="text-ink-light/80 dark:text-white/60 font-sans text-sm">
          Crie seu workspace ou <%= link_to "acesse sua conta", new_session_path(resource_name), class: "text-terracotta hover:text-sage dark:hover:text-sage underline decoration-sage/50 underline-offset-4 transition-colors font-medium" %>.
        </p>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6 mt-8" }) do |f| %>
        
        <!-- Flashes -->
        <% if flash[:alert] %>
          <div class="text-terracotta text-sm mb-4"><%= flash[:alert] %></div>
        <% end %>
        <% if flash[:notice] %>
          <div class="text-sage text-sm mb-4"><%= flash[:notice] %></div>
        <% end %>

        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="group relative">
          <%= f.label :name, "Nome Completo", class: "block font-mono text-[10px] tracking-[0.1em] uppercase text-ink-light/80 dark:text-white/60 mb-2" %>
          <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Como devemos te chamar?", class: "w-full bg-transparent border-0 border-b border-ink/20 dark:border-white/20 focus:border-terracotta focus:ring-0 outline-none transition-all duration-300 py-2 font-sans text-lg text-ink dark:text-white placeholder:text-ink/30 dark:placeholder:text-white/30" %>
        </div>

        <div class="group relative mt-6">
          <%= f.label :email, "E-mail Corporativo ou Pessoal", class: "block font-mono text-[10px] tracking-[0.1em] uppercase text-ink-light/80 dark:text-white/60 mb-2" %>
          <%= f.email_field :email, autocomplete: "email", placeholder: "exemplo@empresa.com", class: "w-full bg-transparent border-0 border-b border-ink/20 dark:border-white/20 focus:border-terracotta focus:ring-0 outline-none transition-all duration-300 py-2 font-sans text-lg text-ink dark:text-white placeholder:text-ink/30 dark:placeholder:text-white/30" %>
        </div>
        
        <div class="group relative mt-6">
          <%= f.label :password, "Defina uma Senha", class: "block font-mono text-[10px] tracking-[0.1em] uppercase text-ink-light/80 dark:text-white/60 mb-2" %>
          <%= f.password_field :password, autocomplete: "new-password", placeholder: "Mínimo de 6 caracteres", class: "w-full bg-transparent border-0 border-b border-ink/20 dark:border-white/20 focus:border-sage focus:ring-0 outline-none transition-all duration-300 py-2 font-sans text-lg text-ink dark:text-white placeholder:text-ink/30 dark:placeholder:text-white/30" %>
        </div>

        <div class="group relative mt-6">
          <%= f.label :password_confirmation, "Confirmar Senha", class: "block font-mono text-[10px] tracking-[0.1em] uppercase text-ink-light/80 dark:text-white/60 mb-2" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repita a mesma senha", class: "w-full bg-transparent border-0 border-b border-ink/20 dark:border-white/20 focus:border-terracotta focus:ring-0 outline-none transition-all duration-300 py-2 font-sans text-lg text-ink dark:text-white placeholder:text-ink/30 dark:placeholder:text-white/30" %>
        </div>

        <% if ENV['CLOUDFLARE_TURNSTILE_SITE_KEY'].present? %>
  <div data-controller="turnstile" data-turnstile-sitekey-value="<%= ENV['CLOUDFLARE_TURNSTILE_SITE_KEY'] %>" class="my-4 flex justify-center"></div>
<% end %>

        <%= f.button type: "submit", class: "group w-full bg-ink text-white dark:bg-fable-light dark:text-ink hover:bg-terracotta hover:text-white dark:hover:bg-terracotta dark:hover:text-white transition-all duration-500 py-4 font-sans font-medium tracking-wide flex items-center justify-center gap-2 mt-6 cursor-pointer" do %>
          Criar Conta
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        <% end %>
      <% end %>

      <div class="relative flex items-center py-6">
        <div class="flex-grow border-t border-ink/10 dark:border-white/10"></div>
        <span class="flex-shrink-0 mx-4 text-ink-light/40 dark:text-white/30 text-xs font-mono uppercase tracking-[0.2em]">ou redes sociais</span>
        <div class="flex-grow border-t border-ink/10 dark:border-white/10"></div>
      </div>

      <div class="space-y-4">
        <!-- Brutalist Auth Buttons -->
        <!-- Just UI placeholders for now, actual implementation needs Omniauth routes if configured -->
        <button type="button" class="group w-full border border-ink/20 dark:border-white/20 bg-transparent hover:bg-ink hover:text-white dark:hover:bg-white dark:hover:text-ink transition-all duration-300 py-3.5 px-4 font-sans font-medium text-sm flex items-center justify-center gap-3">
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
  Continuar com GitHub
</button>
        <%= link_to user_google_oauth2_omniauth_authorize_path, data: { turbo_method: :post }, class: "group w-full border border-ink/20 dark:border-white/20 bg-transparent hover:bg-ink hover:text-white dark:hover:bg-white dark:hover:text-ink transition-all duration-300 py-3.5 px-4 font-sans font-medium text-sm flex items-center justify-center gap-3" do %>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="group-hover:scale-110 transition-transform"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
  Continuar com Google
<% end %>
        <button type="button" class="group w-full border border-ink/20 dark:border-white/20 bg-transparent hover:bg-ink hover:text-white dark:hover:bg-white dark:hover:text-ink transition-all duration-300 py-3.5 px-4 font-sans font-medium text-sm flex items-center justify-center gap-3">
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="group-hover:scale-110 transition-transform"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.702z"/></svg>
  Continuar com Apple
</button>
      </div>

    </div>
  </div>

</div>
