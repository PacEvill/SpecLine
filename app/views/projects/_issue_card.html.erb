<%# Reusable issue card for Kanban and Turbo Stream broadcasts %>
<% priority_border = case issue.priority
   when "urgent" then "border-l-[3px] border-l-rust"
   when "high" then "border-l-[3px] border-l-ochre"
   when "medium" then "border-l-[3px] border-l-ochre"
   when "low" then "border-l-[3px] border-l-slate"
   else "border-l-[3px] border-l-transparent"
   end %>

<div id="<%= dom_id(issue) %>"
     class="bg-white dark:bg-ink-paper rounded-xl p-3.5 border border-ink/5 dark:border-white/5 <%= priority_border %> shadow-[0_1px_3px_rgba(0,0,0,0.04)] hover:shadow-md hover:border-ink/15 dark:hover:border-white/15 transition-all duration-200 cursor-grab active:cursor-grabbing group flex flex-col justify-between"
     data-issue-id="<%= issue.id %>"
     data-kanban-target="card">
  
  <div>
    <!-- Header: Priority & ID & Milestone -->
    <div class="flex items-center justify-between gap-1 mb-2">
      <div class="flex items-center gap-1.5 min-w-0">
        <span class="text-[10px] font-mono font-semibold text-ink-light dark:text-white/60 shrink-0"><%= issue.identifier %></span>
        <% if issue.milestone %>
          <span class="inline-flex items-center gap-1 text-[9px] font-medium px-1.5 py-0.5 rounded-md bg-slate/10 text-slate dark:text-slate truncate max-w-[110px]" title="<%= issue.milestone.title %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span class="truncate"><%= issue.milestone.title %></span>
          </span>
        <% end %>
      </div>

      <!-- Priority Icon -->
      <div class="shrink-0">
        <% case issue.priority %>
        <% when "urgent" %>
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-rust/10 text-rust text-[9px] font-bold">
            <span class="w-1.5 h-1.5 rounded-full bg-rust animate-pulse"></span>
            Urgente
          </span>
        <% when "high" %>
          <span class="w-4 h-4 text-ochre flex items-center justify-center" title="Alta prioridade">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m18 15-6-6-6 6"/></svg>
          </span>
        <% when "medium" %>
          <span class="w-4 h-4 text-ochre flex items-center justify-center" title="Média prioridade">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/></svg>
          </span>
        <% when "low" %>
          <span class="w-4 h-4 text-slate flex items-center justify-center" title="Baixa prioridade">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
          </span>
        <% end %>
      </div>
    </div>

    <!-- Title & Description -->
    <%= link_to edit_workspace_project_issue_path(workspace, project, issue),
        data: { turbo_frame: "modal" },
        class: "block mb-2.5 group-hover:text-terracotta transition-colors duration-300" do %>
      <h4 class="text-xs font-semibold text-ink dark:text-fable leading-snug line-clamp-2 mb-1 group-hover:text-terracotta transition-colors duration-300"><%= issue.title %></h4>
      <% if issue.description.present? %>
        <p class="text-[11px] text-ink-light dark:text-white/60 line-clamp-2 leading-relaxed font-normal"><%= issue.description %></p>
      <% end %>
    <% end %>
  </div>

  <!-- Metadata Row: Labels, Subtasks, Comments & Assignee -->
  <div class="pt-2 border-t border-ink/[0.03] dark:border-white/[0.03]">
    <div class="flex items-center justify-between gap-1">
      
      <!-- Left side: Labels, Subtasks, Comments -->
      <div class="flex items-center flex-wrap gap-1.5 min-w-0">
        <% issue.labels.first(2).each do |label| %>
          <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded-md" style="background-color: <%= label.color %>20; color: <%= label.color %>">
            <%= label.name %>
          </span>
        <% end %>

        <!-- Sub-tasks badge -->
        <% if issue.sub_issues.any? %>
          <% sub_done = issue.sub_issues.select { |s| s.issue_status&.category == 'done' }.count %>
          <span class="inline-flex items-center gap-1 text-[9px] font-mono text-ink-light dark:text-white/50 bg-ink/5 dark:bg-white/5 px-1.5 py-0.5 rounded-md" title="<%= sub_done %> de <%= issue.sub_issues.count %> sub-tarefas concluídas">
            <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <span><%= sub_done %>/<%= issue.sub_issues.count %></span>
          </span>
        <% end %>

        <!-- Comments count -->
        <% if issue.comments.any? %>
          <span class="inline-flex items-center gap-1 text-[9px] font-mono text-ink-light dark:text-white/50 bg-ink/5 dark:bg-white/5 px-1.5 py-0.5 rounded-md" title="<%= pluralize(issue.comments.count, 'comentário') %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span><%= issue.comments.count %></span>
          </span>
        <% end %>

        <!-- Due date badge -->
        <% if issue.due_date.present? %>
          <span class="inline-flex items-center gap-1 text-[9px] font-mono px-1.5 py-0.5 rounded-md <%= issue.due_date < Date.current ? 'bg-rust/10 text-rust font-semibold' : 'bg-ink/5 dark:bg-white/5 text-ink-light dark:text-white/50' %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span><%= issue.due_date.strftime("%d %b") %></span>
          </span>
        <% end %>
      </div>

      <!-- Right side: Assignee Avatar -->
      <% if issue.assignee %>
        <div class="w-6 h-6 rounded-full bg-ink text-white dark:bg-ink-darker dark:text-fable border border-ink/10 dark:border-white/10 flex items-center justify-center text-[9px] font-bold shrink-0" title="Responsável: <%= issue.assignee.email %>">
          <%= issue.assignee.email[0].upcase %>
        </div>
      <% end %>

    </div>
  </div>

</div>
