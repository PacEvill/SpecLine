<% content_for(:sidebar) do %>
  <%= render "shared/workspace_sidebar", workspace: @workspace %>
<% end %>

<%= turbo_frame_tag "modal" do %>
  <div data-controller="modal" data-modal-open-value="true" class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-ink/30 backdrop-blur-sm transition-opacity duration-500" data-modal-target="backdrop" data-action="click->modal#close"></div>

    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
      <div class="flex min-h-full items-center justify-center p-3 sm:p-0">
        <div class="relative transform overflow-hidden bg-white dark:bg-ink-paper text-left shadow-2xl transition-all sm:my-8 w-full max-w-2xl rounded-2xl border border-ink/10 dark:border-white/10 flex flex-col duration-500 max-h-[92dvh] sm:max-h-[90vh]" data-modal-target="panel">
          
          <div class="flex items-center justify-between px-4 sm:px-6 py-3.5 sm:py-4 border-b border-ink/5 dark:border-white/5 bg-[#FDFBF7] dark:bg-ink-darker sticky top-0 z-10">
            <h3 class="text-base font-serif font-semibold text-ink dark:text-white" id="modal-title">
              Agendar Prática Extensionista Presencial
            </h3>
            <button type="button" class="p-1 rounded-lg text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors duration-300" data-action="modal#close">
              <span class="sr-only">Fechar</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>

          <div class="px-4 sm:px-6 py-5 sm:py-6 overflow-y-auto">
            <%= render "form" %>
          </div>

        </div>
      </div>
    </div>
  </div>
<% end %>
