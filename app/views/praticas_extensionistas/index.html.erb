<% content_for :title, "Seu projeto em 3 perguntas — SpecLine · PEI VI" %>
<% content_for :description, "Em 10 minutos, responda 3 perguntas e saia com um documento curto, 3 tarefas com prazo e um fluxograma simples. Oficina gratuita do SpecLine em Maricá." %>

<% content_for :head do %>
  <style>
    @media print {
      .no-print { display: none !important; }
      .print-page { background: #fff !important; color: #000 !important; }
      .print-page * { border-color: #d9d9d9 !important; box-shadow: none !important; }
      .print-page .print-card { background: #fff !important; color: #000 !important; break-inside: avoid; page-break-inside: avoid; }
      .print-page .print-invert { background: #fff !important; color: #000 !important; border-color: #d9d9d9 !important; }
      .print-page .print-invert * { color: #000 !important; }
      html, body { background: #fff !important; }
      .print-page { min-height: 0 !important; }
      .print-page .print-page-break { break-before: page; page-break-before: always; }
      .print-page thead { display: table-header-group; }
      .print-page tr { break-inside: avoid; page-break-inside: avoid; }
      .print-page a { color: #000 !important; text-decoration: none !important; }
      .print-page .print-break { break-inside: avoid; page-break-inside: avoid; }
      .print-page section { padding-top: 1rem !important; padding-bottom: 1rem !important; }
      .print-page header { padding-top: 1rem !important; padding-bottom: 1rem !important; }
      .print-page h1, .print-page h2, .print-page h3 { break-after: avoid; }
      .print-page section .max-w-3xl { break-inside: avoid; }
      .print-page .print-intro { break-inside: avoid; }
      .print-page .print-button { background: #fff !important; color: #000 !important; border: 1px solid #999 !important; }
      .print-page .print-flow { display: block !important; }
      .print-page .print-flow > * { display: block !important; float: left; width: calc(50% - 0.5rem); margin-bottom: 1rem; break-inside: avoid; page-break-inside: avoid; }
      .print-page .print-flow > *:nth-child(odd) { margin-right: 1rem; }
      .print-page .print-flow::after { content: ""; display: block; clear: both; }
      .print-page p { orphans: 3; widows: 3; }
      .print-page table { break-inside: avoid; }
    }
  </style>
<% end %>

<div class="print-page min-h-screen flex flex-col bg-fable-light dark:bg-[#18181A] text-ink dark:text-white font-sans selection:bg-terracotta/30 selection:text-ink transition-colors duration-500">
  <div class="no-print"><%= render "shared/academic_header" %></div>

  <main class="flex-grow w-full">
    <!-- HERO PÚBLICO -->
    <header class="relative overflow-hidden border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#18181A] px-6 py-16 md:px-12 md:py-24">
      <div class="absolute top-1/2 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[620px] h-[340px] bg-terracotta/10 dark:bg-terracotta/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-terracotta/10 text-terracotta text-[11px] font-mono font-bold tracking-wide uppercase border border-terracotta/20">
              <span class="w-1.5 h-1.5 rounded-full bg-terracotta"></span>
              SpecLine · PEI VI · Maricá
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-sage/10 text-sage text-[11px] font-mono font-bold tracking-wide uppercase border border-sage/20">
              Sem cadastro · sem senha
            </span>
          </div>

          <h1 class="font-serif font-light text-5xl md:text-7xl leading-[0.95] tracking-tight text-ink dark:text-fable">
            Seu projeto em<br>
            <i class="text-terracotta">3 perguntas.</i>
          </h1>

          <p class="max-w-2xl text-base md:text-lg text-ink-light dark:text-white/70 leading-relaxed">
            Em <strong class="text-ink dark:text-white">10 minutos</strong>, você sai com um documento curto, 3 tarefas com prazo e um fluxograma simples. No celular, sem instalar e sem criar conta.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2 no-print">
            <a href="#tres-perguntas" class="inline-flex items-center gap-2 px-5 py-3 bg-ink text-white dark:bg-white dark:text-ink hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white font-mono text-[11px] uppercase tracking-widest font-semibold transition-all">
              Ver como funciona
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </a>
            <a href="#roteiro" class="inline-flex items-center gap-2 px-5 py-3 border border-ink/20 dark:border-white/20 hover:border-terracotta hover:text-terracotta font-mono text-[11px] uppercase tracking-widest font-semibold transition-all">
              Roteiro de 10 min
            </a>
            <button type="button" data-controller="print" data-action="click->print#print" class="inline-flex items-center gap-2 px-5 py-3 border border-ink/20 dark:border-white/20 hover:border-terracotta hover:text-terracotta font-mono text-[11px] uppercase tracking-widest font-semibold transition-all cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
              Imprimir / salvar em PDF
            </button>
          </div>

          <p class="font-mono text-[10px] uppercase tracking-widest text-ink-light/70 dark:text-white/45">
            Oficina gratuita · Campus Maricá (FUSVE) · Maricá/RJ
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="print-card p-6 md:p-7 rounded-2xl bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 shadow-sm space-y-5">
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-[10px] uppercase tracking-widest text-ink-light/70 dark:text-white/45">No dia</span>
              <span class="px-2 py-1 rounded-md bg-terracotta/10 text-terracotta font-mono text-[10px] font-bold uppercase tracking-wider border border-terracotta/20 whitespace-nowrap">10 min</span>
            </div>

            <div>
              <h2 class="font-serif text-2xl md:text-3xl text-ink dark:text-fable leading-tight">Do zero ao projeto<br><i class="text-terracotta">em 10 minutos.</i></h2>
              <p class="text-xs text-ink-light dark:text-white/60 mt-2">Uma pessoa, um celular, um projeto no fim.</p>
            </div>

            <div class="space-y-2.5 pt-1">
              <% @roteiro_10.each do |passo| %>
                <div class="flex items-center gap-3">
                  <span class="font-mono text-[10px] text-terracotta w-14 shrink-0"><%= passo[:tempo] %></span>
                  <span class="text-xs font-semibold text-ink dark:text-white"><%= passo[:titulo] %></span>
                </div>
              <% end %>
            </div>

            <div class="pt-4 border-t border-ink/10 dark:border-white/10 flex items-center justify-between gap-3">
              <p class="text-[10px] text-ink-light/70 dark:text-white/45 leading-relaxed">Sem cadastro. Sem senha.<br>Direto no navegador.</p>
              <a href="#roteiro" class="font-mono text-[10px] font-bold uppercase tracking-wider text-terracotta hover:underline">Ver roteiro</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- NÚMEROS SIMPLES -->
    <section class="border-b border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper py-8 px-6">
      <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div class="space-y-1">
          <div class="font-mono text-3xl md:text-4xl font-bold text-terracotta">3</div>
          <div class="font-sans text-[11px] uppercase tracking-wider text-ink-light/80 dark:text-white/60">Perguntas para começar</div>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-3xl md:text-4xl font-bold text-sage">10 min</div>
          <div class="font-sans text-[11px] uppercase tracking-wider text-ink-light/80 dark:text-white/60">Por pessoa</div>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-3xl md:text-4xl font-bold text-ochre">4–6</div>
          <div class="font-sans text-[11px] uppercase tracking-wider text-ink-light/80 dark:text-white/60">Pessoas por grupo</div>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-3xl md:text-4xl font-bold text-olive">R$ 0,00</div>
          <div class="font-sans text-[11px] uppercase tracking-wider text-ink-light/80 dark:text-white/60">Custo para participar</div>
        </div>
      </div>
    </section>

    <!-- POR QUE ESTE PROJETO (linguagem para o público) -->
    <section class="border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#18181A] py-14 px-6 md:px-12 md:py-20">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="max-w-3xl space-y-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta font-bold">Por que este projeto existe</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-fable leading-tight">
            Antes da oficina,<br><i class="text-terracotta">a gente ouviu Maricá.</i>
          </h2>
          <p class="text-sm md:text-base text-ink-light dark:text-white/65 leading-relaxed">
            Este é um projeto da Universidade de Vassouras — Campus Maricá, feito por estudantes de engenharia de software para a cidade. Antes de construir qualquer coisa, aplicamos uma pesquisa com a própria comunidade. O resultado explicou o problema e moldou a ação:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <% @impacto_publico.each do |item| %>
            <div class="print-card p-6 rounded-2xl bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 space-y-3">
              <div class="font-mono text-4xl font-bold text-<%= item[:cor] %>"><%= item[:numero] %></div>
              <p class="text-sm text-ink-light dark:text-white/65 leading-relaxed"><%= item[:texto] %></p>
            </div>
          <% end %>
        </div>

        <div class="print-card p-6 rounded-2xl bg-white dark:bg-ink-paper border border-sage/25 space-y-3">
          <p class="text-sm md:text-base text-ink-light dark:text-white/70 leading-relaxed">
            <strong class="text-ink dark:text-white">Por que isso é projeto de extensão?</strong> Porque não termina dentro da sala de aula: leva o que a universidade produz de melhor — método e ferramenta profissional — para quem normalmente nunca recebe isso. A oficina acontece em Maricá, com pessoas de Maricá, diante dos números acima. Todo mundo sai com um projeto real organizado — e a comunidade fica com a ferramenta, de graça, para continuar usando depois.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <%= link_to "Responder à pesquisa da comunidade", @links[:forms], target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center gap-2 px-5 py-2.5 bg-ink text-white dark:bg-white dark:text-ink hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white font-mono text-[11px] uppercase tracking-widest font-semibold transition-all" %>
            <span class="font-mono text-[10px] uppercase tracking-wider text-ink-light/60 dark:text-white/40">sua resposta entra no próximo diagnóstico</span>
          </div>
        </div>
      </div>
    </section>

    <!-- MEU PROJETO EM 3 PERGUNTAS -->
    <section id="tres-perguntas" class="scroll-mt-24 px-6 py-14 md:px-12 md:py-20 border-b border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="print-intro max-w-3xl space-y-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta font-bold">O centro de tudo</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-fable leading-tight">
            Meu projeto<br><i class="text-terracotta">em 3 perguntas.</i>
          </h2>
          <p class="text-sm md:text-base text-ink-light dark:text-white/65 leading-relaxed">
            Uma tela só. Você responde e o SpecLine monta o resto: um documento curto, 3 tarefas com prazo e um fluxograma simples.
          </p>
          <p class="text-sm text-ink-light dark:text-white/65 leading-relaxed">
            Você preenche em uns 5 minutos e já vê o resultado das três funcionalidades do SpecLine sem precisar aprender a usar cada uma.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          <div class="lg:col-span-7 space-y-3">
            <% @tres_perguntas.each do |pergunta| %>
              <div class="print-card p-5 rounded-2xl border border-ink/10 dark:border-white/10 bg-fable-light dark:bg-[#18181A] flex items-start gap-4">
                <span class="w-9 h-9 rounded-full bg-terracotta/10 text-terracotta flex items-center justify-center font-mono text-xs font-bold shrink-0"><%= pergunta[:numero] %></span>
                <div class="space-y-1">
                  <h3 class="font-serif text-lg md:text-xl font-bold text-ink dark:text-white"><%= pergunta[:pergunta] %></h3>
                  <p class="text-xs text-ink-light dark:text-white/60 leading-relaxed"><%= pergunta[:exemplo] %></p>
                </div>
              </div>
            <% end %>
          </div>

          <div class="lg:col-span-5">
            <div class="print-card h-full p-6 rounded-2xl border border-terracotta/20 bg-fable-light dark:bg-[#18181A] space-y-4">
              <div class="flex items-center justify-between gap-3">
                <span class="font-mono text-[10px] uppercase tracking-widest text-terracotta font-bold">Exemplo pronto</span>
                <span class="font-mono text-[9px] uppercase tracking-wider text-ink-light/60 dark:text-white/40">Para copiar o formato</span>
              </div>

              <div>
                <h3 class="font-serif text-2xl font-bold text-ink dark:text-white">Bolos da Dona Ana</h3>
                <p class="text-xs text-ink-light dark:text-white/60">Um negócio de bairro, organizado em 3 respostas.</p>
              </div>

              <div class="space-y-3 pt-2 border-t border-ink/10 dark:border-white/10">
                <div>
                  <p class="font-mono text-[9px] uppercase tracking-wider text-ink-light/60 dark:text-white/40">O que organizar</p>
                  <p class="text-sm font-semibold text-ink dark:text-white">Vender bolo por encomenda</p>
                </div>
                <div>
                  <p class="font-mono text-[9px] uppercase tracking-wider text-ink-light/60 dark:text-white/40">Os 3 primeiros passos</p>
                  <p class="text-sm font-semibold text-ink dark:text-white">Definir sabores → montar preços → divulgar no bairro</p>
                </div>
                <div>
                  <p class="font-mono text-[9px] uppercase tracking-wider text-ink-light/60 dark:text-white/40">Até quando</p>
                  <p class="text-sm font-semibold text-ink dark:text-white">Até 15/11</p>
                </div>
              </div>

              <div class="pt-3 border-t border-ink/10 dark:border-white/10 space-y-2">
                <p class="font-mono text-[9px] uppercase tracking-wider text-terracotta font-bold">O app monta sozinho</p>
                <div class="flex flex-wrap gap-1.5">
                  <span class="px-2 py-1 rounded-md bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 text-[10px] font-mono text-ink-light dark:text-white/60">Documento curto</span>
                  <span class="px-2 py-1 rounded-md bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 text-[10px] font-mono text-ink-light dark:text-white/60">3 tarefas</span>
                  <span class="px-2 py-1 rounded-md bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 text-[10px] font-mono text-ink-light dark:text-white/60">Fluxograma</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="print-card p-5 rounded-2xl bg-fable-light dark:bg-[#18181A] border border-ink/10 dark:border-white/10 space-y-2">
            <span class="font-mono text-[10px] font-bold text-terracotta">01</span>
            <h3 class="font-serif text-lg font-bold text-ink dark:text-white">Documento curto</h3>
            <p class="text-xs text-ink-light dark:text-white/60 leading-relaxed">Um resumo do projeto para guardar e mostrar.</p>
          </div>
          <div class="print-card p-5 rounded-2xl bg-fable-light dark:bg-[#18181A] border border-ink/10 dark:border-white/10 space-y-2">
            <span class="font-mono text-[10px] font-bold text-sage">02</span>
            <h3 class="font-serif text-lg font-bold text-ink dark:text-white">3 tarefas com prazo</h3>
            <p class="text-xs text-ink-light dark:text-white/60 leading-relaxed">O que fazer primeiro, segundo e terceiro.</p>
          </div>
          <div class="print-card p-5 rounded-2xl bg-fable-light dark:bg-[#18181A] border border-ink/10 dark:border-white/10 space-y-2">
            <span class="font-mono text-[10px] font-bold text-ochre">03</span>
            <h3 class="font-serif text-lg font-bold text-ink dark:text-white">Fluxograma simples</h3>
            <p class="text-xs text-ink-light dark:text-white/60 leading-relaxed">Passo 1 → 2 → 3, sem editor complicado.</p>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-sage/10 border border-sage/20 text-sm text-ink-light dark:text-white/70 leading-relaxed">
          <strong class="text-ink dark:text-white">Leve uma ideia:</strong> de TCC, de negócio ou de ação de bairro. Não precisa estar pronta. A equipe ajuda a organizar no dia.
        </div>

        <%# Mini-formulário de captação — escondido dentro de um bloco colapsado. %>
        <details id="inscricao" class="scroll-mt-24 group/details no-print p-5 rounded-2xl bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10">
          <summary class="cursor-pointer select-none flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-sage"></span>
              <span class="font-mono text-[11px] uppercase tracking-widest text-ink-light dark:text-white/60 font-bold group-open/details:text-terracotta transition-colors">Quer garantir vaga? Guarde seu lugar aqui</span>
            </div>
            <span class="text-xs font-mono text-ink-light/60 dark:text-white/40">abrir ▾</span>
          </summary>

          <div class="mt-5 pt-5 border-t border-ink/10 dark:border-white/10">
            <p class="text-xs text-ink-light dark:text-white/55 leading-relaxed mb-4">
              Deixa só seu nome e um contato. A gente usa <strong class="text-ink dark:text-white">só para chamar você antes da oficina</strong> desta página — nada de conta, senha ou e-mail marketing.
            </p>

            <%= form_with url: pratica_registro_path, method: :post, local: true, html: { class: "space-y-3" }, data: { turbo: false }, id: "form-inscricao" do %>
              <%# Honeypot: campo invisível para bots %>
              <div style="position:absolute;left:-9999px" aria-hidden="true">
                <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <%= label_tag :nome, "Seu nome", class: "block font-mono text-[10px] uppercase tracking-wider text-ink-light/70 dark:text-white/50 mb-1" %>
                  <%= text_field_tag :nome, nil, required: true, maxlength: 80, placeholder: "Como a gente te chama", class: "w-full px-3 py-2.5 rounded-xl border border-ink/15 dark:border-white/15 bg-fable-light dark:bg-[#18181A] text-sm text-ink dark:text-white placeholder:text-ink-light/40 dark:placeholder:text-white/30 focus:outline-none focus:border-terracotta focus:ring-2 focus:ring-terracotta/20" %>
                </div>
                <div>
                  <%= label_tag :contato, "Contato (WhatsApp, e-mail…)", class: "block font-mono text-[10px] uppercase tracking-wider text-ink-light/70 dark:text-white/50 mb-1" %>
                  <%= text_field_tag :contato, nil, required: true, maxlength: 120, placeholder: "Por onde avisar você", class: "w-full px-3 py-2.5 rounded-xl border border-ink/15 dark:border-white/15 bg-fable-light dark:bg-[#18181A] text-sm text-ink dark:text-white placeholder:text-ink-light/40 dark:placeholder:text-white/30 focus:outline-none focus:border-terracotta focus:ring-2 focus:ring-terracotta/20" %>
                </div>
              </div>

              <div>
                <%= label_tag :ideia, "Sua ideia (opcional)", class: "block font-mono text-[10px] uppercase tracking-wider text-ink-light/70 dark:text-white/50 mb-1" %>
                <%= text_area_tag :ideia, nil, rows: 2, maxlength: 500, placeholder: "Ex.: vender bolo por encomenda, organizar o TCC…", class: "w-full px-3 py-2.5 rounded-xl border border-ink/15 dark:border-white/15 bg-fable-light dark:bg-[#18181A] text-sm text-ink dark:text-white placeholder:text-ink-light/40 dark:placeholder:text-white/30 focus:outline-none focus:border-terracotta focus:ring-2 focus:ring-terracotta/20" %>
              </div>

              <div class="flex items-center justify-between gap-3 pt-1">
                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-ink text-white dark:bg-white dark:text-ink hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white font-mono text-[11px] uppercase tracking-widest font-semibold transition-all">
                  Guardar meu lugar
                </button>
                <span class="text-[10px] font-mono text-ink-light/50 dark:text-white/35">dias antes da ação · usado só pela oficina</span>
              </div>
            <% end %>
          </div>
        </details>
      </div>
    </section>

    <!-- ROTEIRO DE 10 MINUTOS -->
    <section id="roteiro" class="scroll-mt-24 px-6 py-14 md:px-12 md:py-20 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#18181A]">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="print-intro max-w-3xl space-y-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta font-bold">Roteiro de 10 minutos</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-fable leading-tight">
            Dez minutos,<br><i class="text-terracotta">uma pessoa, um projeto.</i>
          </h2>
          <p class="text-sm md:text-base text-ink-light dark:text-white/65 leading-relaxed">
            O aluno explica uma vez para o grupo inteiro. Cada um faz no próprio celular, no ritmo dele. O aluno só passa para destravar quem empacar.
          </p>
        </div>

        <div class="print-card overflow-hidden rounded-2xl border border-ink/10 dark:border-white/10 bg-white dark:bg-ink-paper">
          <% @roteiro_10.each_with_index do |passo, index| %>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 px-5 py-4 <%= index.zero? ? "" : "border-t border-ink/10 dark:border-white/10" %>">
              <div class="sm:w-28 shrink-0 font-mono text-sm font-bold text-terracotta"><%= passo[:tempo] %></div>
              <div class="sm:w-40 shrink-0 font-serif text-lg font-bold text-ink dark:text-white"><%= passo[:titulo] %></div>
              <p class="text-sm text-ink-light dark:text-white/65 leading-relaxed"><%= passo[:descricao] %></p>
            </div>
          <% end %>
        </div>

        <div class="print-card p-6 rounded-2xl bg-white dark:bg-ink-paper border border-terracotta/25 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1">
            <h3 class="font-serif text-xl font-bold text-ink dark:text-white">Pesquisa + certificado</h3>
            <p class="text-sm text-ink-light dark:text-white/65">No fim do roteiro, responda à pesquisa no celular. Ela registra sua participação e libera o certificado.</p>
          </div>
          <%= link_to "Abrir pesquisa", @links[:forms], target: "_blank", rel: "noopener noreferrer", class: "print-button inline-flex items-center justify-center gap-2 px-5 py-3 bg-ink text-white dark:bg-white dark:text-ink hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white font-mono text-[11px] uppercase tracking-widest font-semibold transition-all shrink-0" %>
        </div>
      </div>
    </section>

    <!-- ATENDER VÁRIAS PESSOAS -->
    <section id="atendimento" class="scroll-mt-24 px-6 py-14 md:px-12 md:py-20 border-b border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="print-intro max-w-3xl space-y-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta font-bold">Várias pessoas ao mesmo tempo</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-fable leading-tight">
            O aluno não ensina<br><i class="text-terracotta">um por um.</i>
          </h2>
          <p class="text-sm md:text-base text-ink-light dark:text-white/65 leading-relaxed">
            Ele só destrava quem empacar. O resto a pessoa faz sozinha, com o passo a passo no telão. É assim que a oficina atende várias pessoas sem virar fila.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @atendimento.each_with_index do |item, index| %>
            <div class="print-card p-5 rounded-2xl bg-fable-light dark:bg-[#18181A] border border-ink/10 dark:border-white/10 space-y-2">
              <span class="font-mono text-[10px] font-bold text-terracotta"><%= format("%02d", index + 1) %></span>
              <h3 class="font-serif text-lg font-bold text-ink dark:text-white"><%= item[:titulo] %></h3>
              <p class="text-xs text-ink-light dark:text-white/60 leading-relaxed"><%= item[:descricao] %></p>
            </div>
          <% end %>
        </div>

        <div class="p-5 rounded-2xl bg-sage/10 border border-sage/20 text-sm text-ink-light dark:text-white/70 leading-relaxed">
          <strong class="text-ink dark:text-white">Isso também vira evidência:</strong> o painel mostra quantas pessoas entraram, quantas concluíram e quantas exportaram. Esses números entram no relatório da extensão.
        </div>
      </div>
    </section>

    <!-- CORTES E PRIORIDADES -->
    <section class="px-6 py-14 md:px-12 md:py-20 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#18181A]">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="print-card p-6 md:p-8 rounded-2xl bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 space-y-5">
          <div class="space-y-2">
            <span class="font-mono text-[10px] uppercase tracking-widest text-terracotta font-bold">Para ser rápido</span>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-ink dark:text-white">O que fica de fora</h2>
            <p class="text-sm text-ink-light dark:text-white/60 leading-relaxed">Menos etapas no dia, mais gente atendida.</p>
          </div>
          <ul class="space-y-4">
            <% @cortes.each do |corte| %>
              <li class="flex gap-3">
                <span class="w-5 h-5 rounded-full bg-rust/10 text-rust flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">×</span>
                <div>
                  <p class="text-sm font-semibold text-ink dark:text-white"><%= corte[:titulo] %></p>
                  <p class="text-xs text-ink-light dark:text-white/60 leading-relaxed"><%= corte[:descricao] %></p>
                </div>
              </li>
            <% end %>
          </ul>
        </div>

        <div class="print-card p-6 md:p-8 rounded-2xl bg-white dark:bg-ink-paper border border-terracotta/20 space-y-5">
          <div class="space-y-2">
            <span class="font-mono text-[10px] uppercase tracking-widest text-terracotta font-bold">Próximos dias</span>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-ink dark:text-white">O que a equipe está preparando</h2>
            <p class="text-sm text-ink-light dark:text-white/60 leading-relaxed">Prioridade antes da ação, para o roteiro funcionar de verdade.</p>
          </div>
          <ul class="space-y-4">
            <% @prioridades.each do |prioridade| %>
              <li class="flex gap-3">
                <span class="w-5 h-5 rounded-full bg-terracotta/10 text-terracotta flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">→</span>
                <div>
                  <p class="text-sm font-semibold text-ink dark:text-white"><%= prioridade[:titulo] %></p>
                  <p class="text-xs text-ink-light dark:text-white/60 leading-relaxed"><%= prioridade[:descricao] %></p>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </section>

    <!-- DIVISOR: PARA A DISCIPLINA -->
    <section id="para-disciplina" class="print-invert print-page-break scroll-mt-24 border-y border-white/10 bg-ink dark:bg-ink-darker text-white px-6 py-12 md:px-12 md:py-16">
      <div class="max-w-6xl mx-auto space-y-8">
        <div class="print-intro max-w-3xl space-y-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta font-bold">Para a disciplina</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-white leading-tight">
            Datas, evidências<br><i class="text-terracotta">e relatório.</i>
          </h2>
          <p class="text-sm md:text-base text-white/65 leading-relaxed">
            O que a professora pediu, o que precisa ser guardado e o que entra na Mostra de Extensão. O público pode pular esta parte.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-4 pt-6 border-t border-white/10">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-white/40">Data de referência</p>
            <p class="font-serif text-2xl text-white"><%= @acao[:data] %></p>
            <p class="text-[10px] text-white/50"><%= @acao[:horario] %></p>
            <p class="text-[10px] text-white/35">Confirme com a equipe antes de divulgar.</p>
          </div>
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-white/40">Local</p>
            <p class="font-serif text-2xl text-white"><%= @acao[:local] %></p>
            <p class="text-[10px] text-white/35"><%= @acao[:endereco] %></p>
          </div>
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-white/40">Entrega final</p>
            <p class="font-serif text-2xl text-white">19/11/2026</p>
            <p class="text-[10px] text-white/35">Relatório Final + evidências (P2).</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CRONOGRAMA -->
    <section id="cronograma" class="scroll-mt-24 px-6 py-14 md:px-12 md:py-20 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#18181A]">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="print-intro max-w-3xl space-y-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta font-bold">Datas que importam</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-fable leading-tight">
            Cronograma<br><i class="text-terracotta">oficial da disciplina.</i>
          </h2>
          <p class="text-sm text-ink-light dark:text-white/65 leading-relaxed">
            Calendário atualizado a partir da orientação de 22/10/2026. Os status são recalculados automaticamente conforme a data de hoje.
          </p>
          <p class="text-[11px] text-ink-light/70 dark:text-white/50 leading-relaxed">
            “Concluído” indica que a data já passou; o registro de que a entrega foi feita fica no relatório e nas evidências.
          </p>
        </div>

        <div class="space-y-3">
          <% @cronograma.each do |item| %>
            <div class="print-card print-break p-5 md:p-6 rounded-2xl bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
              <div class="shrink-0 md:w-24">
                <p class="font-mono text-lg font-bold text-ink dark:text-white"><%= item[:rotulo] %></p>
                <p class="font-mono text-[10px] uppercase tracking-wider text-ink-light/65 dark:text-white/45"><%= item[:tipo] %></p>
              </div>

              <div class="flex-grow">
                <h3 class="font-serif text-lg md:text-xl font-bold text-ink dark:text-white"><%= item[:titulo] %></h3>
                <p class="text-sm text-ink-light dark:text-white/60 leading-relaxed mt-1"><%= item[:descricao] %></p>
              </div>

              <div class="shrink-0">
                <% status_class = case item[:status]
                   when "Concluído" then "bg-sage/15 text-sage border-sage/20"
                   when "Hoje" then "bg-terracotta/15 text-terracotta border-terracotta/20"
                   else "bg-ink/5 dark:bg-white/5 text-ink-light dark:text-white/60 border-ink/10 dark:border-white/10"
                   end %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border font-mono text-[10px] font-bold uppercase tracking-wider <%= status_class %>">
                  <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                  <%= item[:status] %>
                </span>
              </div>
            </div>
          <% end %>
        </div>

        <div class="p-5 rounded-2xl bg-rust/10 border border-rust/20 text-sm text-ink-light dark:text-white/70 leading-relaxed">
          <strong class="text-rust">Atenção:</strong> a ação precisa estar feita antes de <strong class="text-ink dark:text-white">19/11</strong>. Sem ação realizada, a P2 é zero e não há aprovação. Quanto mais cedo a ação acontecer, mais tempo sobra para organizar as provas e o relatório.
        </div>
      </div>
    </section>

    <!-- ANTES, DURANTE E DEPOIS -->
    <section class="print-page-break px-6 py-14 md:px-12 md:py-20 border-b border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="print-intro max-w-3xl space-y-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta font-bold">Execução do plano</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-fable leading-tight">
            O que fazer<br><i class="text-terracotta">em cada etapa.</i>
          </h2>
          <p class="text-sm text-ink-light dark:text-white/65 leading-relaxed">
            O Plano de Ação é o roteiro. Agora é fazer o que ele promete, no local e na data certos, e guardar a prova de cada coisa.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
          <div class="print-card p-6 md:p-7 rounded-2xl border border-ink/10 dark:border-white/10 bg-fable-light dark:bg-[#18181A] space-y-4">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-terracotta/15 text-terracotta flex items-center justify-center font-mono text-xs font-bold">1</span>
              <h3 class="font-serif text-xl font-bold text-ink dark:text-white">Antes</h3>
            </div>
            <ul class="space-y-3 text-sm text-ink-light dark:text-white/70 leading-relaxed">
              <li class="flex gap-2"><span class="text-terracotta shrink-0">✓</span><span>Confirmar com o parceiro do local: data, horário e autorização do espaço.</span></li>
              <li class="flex gap-2"><span class="text-terracotta shrink-0">✓</span><span>Imprimir o kit de campo: lista de presença, termos de imagem e voz, termo para menor com responsável e avaliação.</span></li>
              <li class="flex gap-2"><span class="text-terracotta shrink-0">✓</span><span>Dividir papéis: quem recepciona, quem registra e quem aplica a avaliação.</span></li>
              <li class="flex gap-2"><span class="text-terracotta shrink-0">✓</span><span>Testar o app e os materiais antes de chegar.</span></li>
            </ul>
          </div>

          <div class="print-card p-6 md:p-7 rounded-2xl border border-ink/10 dark:border-white/10 bg-fable-light dark:bg-[#18181A] space-y-4">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-sage/15 text-sage flex items-center justify-center font-mono text-xs font-bold">2</span>
              <h3 class="font-serif text-xl font-bold text-ink dark:text-white">Durante</h3>
            </div>
            <ul class="space-y-3 text-sm text-ink-light dark:text-white/70 leading-relaxed">
              <li class="flex gap-2"><span class="text-sage shrink-0">✓</span><span>Lista de presença na entrada, com nome e atividade.</span></li>
              <li class="flex gap-2"><span class="text-sage shrink-0">✓</span><span>Termo de imagem e voz assinado antes de fotografar.</span></li>
              <li class="flex gap-2"><span class="text-sage shrink-0">✓</span><span>Fotos com data e legenda padrão, sem rosto de quem não autorizou.</span></li>
              <li class="flex gap-2"><span class="text-sage shrink-0">✓</span><span>Avaliação aplicada no fim, em papel ou formulário.</span></li>
              <li class="flex gap-2"><span class="text-sage shrink-0">✓</span><span>Anotar depoimentos curtos e quantas pessoas participaram.</span></li>
            </ul>
          </div>

          <div class="print-card p-6 md:p-7 rounded-2xl border border-ink/10 dark:border-white/10 bg-fable-light dark:bg-[#18181A] space-y-4">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-ochre/15 text-ochre flex items-center justify-center font-mono text-xs font-bold">3</span>
              <h3 class="font-serif text-xl font-bold text-ink dark:text-white">Depois</h3>
            </div>
            <ul class="space-y-3 text-sm text-ink-light dark:text-white/70 leading-relaxed">
              <li class="flex gap-2"><span class="text-ochre shrink-0">✓</span><span>Tabular as avaliações: quantas respostas por item.</span></li>
              <li class="flex gap-2"><span class="text-ochre shrink-0">✓</span><span>Comparar metas previstas x alcançadas do plano.</span></li>
              <li class="flex gap-2"><span class="text-ochre shrink-0">✓</span><span>Organizar fotos e legendas no anexo do relatório.</span></li>
              <li class="flex gap-2"><span class="text-ochre shrink-0">✓</span><span>Somar a carga horária de cada integrante.</span></li>
              <li class="flex gap-2"><span class="text-ochre shrink-0">✓</span><span>Escrever as dificuldades e o que o grupo aprendeu.</span></li>
            </ul>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-ochre/10 border border-ochre/20 text-sm text-ink-light dark:text-white/70 leading-relaxed">
          <strong class="text-ink dark:text-white">Riscos reais:</strong> pouco público, chuva, internet fora ou local que não libera. O Plano de Ação já tem a coluna de riscos e mitigação. Use o que o grupo escreveu e anote o que de fato aconteceu.
        </div>
      </div>
    </section>

    <!-- EVIDÊNCIAS -->
    <section id="evidencias" class="scroll-mt-24 px-6 py-14 md:px-12 md:py-20 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#18181A]">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="print-intro max-w-3xl space-y-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta font-bold">Provas da ação</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-fable leading-tight">
            O que guardar<br><i class="text-terracotta">para o relatório.</i>
          </h2>
          <p class="text-sm text-ink-light dark:text-white/65 leading-relaxed">
            A professora pede provas. Estas são as principais. As que têm link usam os modelos oficiais do kit de campo ou o formulário online.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @evidencias.each_with_index do |evidencia, index| %>
            <div class="print-card p-5 rounded-2xl bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 space-y-3">
              <div class="flex items-start justify-between gap-3">
                <span class="font-mono text-[10px] font-bold text-terracotta"><%= format("%02d", index + 1) %></span>
                <span class="font-mono text-[9px] uppercase tracking-wider text-ink-light/65 dark:text-white/45 text-right"><%= evidencia[:detalhe] %></span>
              </div>
              <h3 class="font-serif text-lg font-bold text-ink dark:text-white"><%= evidencia[:titulo] %></h3>
              <p class="text-xs text-ink-light dark:text-white/65 leading-relaxed"><%= evidencia[:descricao] %></p>
              <% if evidencia[:link].present? %>
                <%= link_to "Abrir modelo", evidencia[:link], target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center gap-1 text-[11px] font-mono font-bold text-terracotta hover:underline" %>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="print-card p-6 rounded-2xl bg-white dark:bg-ink-paper border border-terracotta/25 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1">
            <h3 class="font-serif text-xl font-bold text-ink dark:text-white">Pesquisa + certificado</h3>
            <p class="text-sm text-ink-light dark:text-white/65">Responda pelo celular. Leva menos de 1 minuto, registra sua participação e libera o certificado.</p>
          </div>
          <%= link_to "Abrir formulário", @links[:forms], target: "_blank", rel: "noopener noreferrer", class: "print-button inline-flex items-center justify-center gap-2 px-5 py-3 bg-ink text-white dark:bg-white dark:text-ink hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white font-mono text-[11px] uppercase tracking-widest font-semibold transition-all shrink-0" %>
        </div>
      </div>
    </section>

    <!-- RESULTADOS -->
    <section class="print-page-break px-6 py-14 md:px-12 md:py-20 border-b border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="print-intro max-w-3xl space-y-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta font-bold">Resultados</span>
          <h2 class="font-serif font-light text-3xl md:text-5xl text-ink dark:text-fable leading-tight">
            Metas x<br><i class="text-terracotta">alcançado.</i>
          </h2>
          <p class="text-sm text-ink-light dark:text-white/65 leading-relaxed">
            Os números abaixo saem do Plano de Ação. A coluna “alcançado” será preenchida depois da ação e é o que entra no Relatório Final e na Mostra de Extensão.
          </p>
        </div>

        <div class="print-card overflow-x-auto rounded-2xl border border-ink/10 dark:border-white/10">
          <table class="w-full min-w-[480px] text-left text-sm">
            <caption class="sr-only">Metas do Plano de Ação e resultados alcançados</caption>
            <thead class="bg-fable-light dark:bg-[#18181A] border-b border-ink/10 dark:border-white/10">
              <tr>
                <th scope="col" class="px-5 py-4 font-mono text-[10px] uppercase tracking-wider text-ink-light/60 dark:text-white/45">Indicador</th>
                <th scope="col" class="px-5 py-4 font-mono text-[10px] uppercase tracking-wider text-ink-light/60 dark:text-white/45">Meta do plano</th>
                <th scope="col" class="px-5 py-4 font-mono text-[10px] uppercase tracking-wider text-ink-light/60 dark:text-white/45">Alcançado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink/5 dark:divide-white/5">
              <% @metas.each do |meta| %>
                <tr class="bg-white dark:bg-ink-paper">
                  <td class="px-5 py-4 font-medium text-ink dark:text-white"><%= meta[:indicador] %></td>
                  <td class="px-5 py-4 text-ink-light dark:text-white/60"><%= meta[:meta] %></td>
                  <td class="px-5 py-4 font-mono text-ink-light dark:text-white/55"><%= meta[:realizado] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="print-card p-6 rounded-2xl bg-fable-light dark:bg-[#18181A] border border-ink/10 dark:border-white/10 space-y-3">
            <span class="font-mono text-[10px] uppercase tracking-widest text-terracotta font-bold">Depoimentos</span>
            <p class="text-sm text-ink-light dark:text-white/65 italic leading-relaxed">“Espaço para duas ou três falas curtas de participantes. Copie a frase exata, com autorização, e guarde o nome ou o perfil de quem falou.”</p>
          </div>
          <div class="print-card p-6 rounded-2xl bg-fable-light dark:bg-[#18181A] border border-ink/10 dark:border-white/10 space-y-3">
            <span class="font-mono text-[10px] uppercase tracking-widest text-terracotta font-bold">Aprendizados</span>
            <p class="text-sm text-ink-light dark:text-white/65 italic leading-relaxed">“Espaço para o que o grupo aprendeu: o que funcionou, o que travou e o que faria diferente na próxima ação.”</p>
