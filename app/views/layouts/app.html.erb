<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Spec Line" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet">
    <script>
      // Apply theme before render to prevent flash
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[#FDFBF7] dark:bg-ink-darker text-ink dark:text-fable overflow-hidden h-screen flex transition-colors duration-500">
    
    <%= render "shared/global_sidebar" %>
    <% if content_for?(:sidebar) %>
      <%= yield :sidebar %>
    <% end %>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col min-w-0 bg-[#FDFBF7] dark:bg-ink-darker relative h-full transition-colors duration-500">
      <%= yield %>
    </main>

    <turbo-frame id="modal"></turbo-frame>
  </body>
</html>
