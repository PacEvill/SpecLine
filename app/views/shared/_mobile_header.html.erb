<% current_ws = local_assigns[:workspace] || (@workspace&.persisted? ? @workspace : nil) || current_user&.workspaces&.first %>
<header class="md:hidden flex items-center justify-between px-4 py-2.5 bg-white/90 dark:bg-ink-paper/90 backdrop-blur-md border-b border-ink/5 dark:border-white/5 sticky top-0 z-30 shrink-0 transition-colors duration-500">
  <div class="flex items-center gap-2.5 min-w-0">
    <!-- Hamburger Button -->
    <button type="button" data-action="click->mobile-drawer#open" class="p-2 -ml-1 text-ink dark:text-fable hover:text-terracotta hover:bg-ink/5 dark:hover:bg-white/5 rounded-xl transition-colors cursor-pointer shrink-0" aria-label="Abrir Menu de Navegação">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>

    <!-- SpecLine Logo / Current Workspace Badge -->
    <%= link_to (current_ws&.persisted? ? workspace_path(current_ws) : workspaces_path), class: "flex items-center gap-2 text-ink dark:text-fable min-w-0" do %>
      <div class="w-7 h-7 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-terracotta"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></svg>
      </div>
      <span class="font-serif font-bold text-base tracking-tight shrink-0">SpecLine</span>
      <% if current_ws&.persisted? %>
        <span class="text-[11px] font-sans font-medium text-ink-light dark:text-white/50 bg-ink/5 dark:bg-white/5 px-2 py-0.5 rounded-md border border-ink/5 dark:border-white/5 max-w-[110px] truncate"><%= current_ws.name %></span>
      <% end %>
    <% end %>
  </div>

  <div class="flex items-center gap-1 shrink-0">
    <!-- Quick Search -->
    <%= link_to search_path, data: { turbo_frame: "modal" }, class: "p-2 text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable hover:bg-ink/5 dark:hover:bg-white/5 rounded-xl transition-colors", title: "Buscar (⌘K)" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <% end %>
  </div>
</header>
