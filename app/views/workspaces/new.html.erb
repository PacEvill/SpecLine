<div class="h-full overflow-y-auto bg-[#FDFBF7] dark:bg-ink-darker flex flex-col">
  <!-- Top Navigation -->
  <header class="bg-transparent pt-8 px-8">
    <%= link_to workspaces_path, class: "inline-flex items-center gap-2 text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors font-sans text-sm group duration-500" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform duration-300"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Voltar para o Painel
    <% end %>
  </header>

  <main class="flex-1 flex justify-center p-6 pt-12 pb-24">
    <div class="w-full max-w-3xl animate-fade-in-up">
      <!-- Icon/Header -->
      <div class="text-center mb-10">
        <div class="w-16 h-16 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink dark:text-fable"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></svg>
        </div>
        <h1 class="text-3xl font-serif text-ink dark:text-fable tracking-tight mb-2">Crie seu Workspace</h1>
        <p class="text-ink-light dark:text-white/60 font-sans text-base">O nome da sua empresa, agência ou organização.</p>
      </div>

        <%= render "form", workspace: @workspace, button_text: "Criar Workspace" %>
      
      <p class="text-center text-xs text-ink-light dark:text-white/60 mt-8">Você poderá convidar membros para sua equipe logo depois.</p>
    </div>
  </main>
</div>
