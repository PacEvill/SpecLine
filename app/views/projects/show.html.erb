<% content_for(:sidebar) do %>
  <%= render "shared/workspace_sidebar", workspace: @workspace, current_project: @project %>
<% end %>

<%= render "projects/header", workspace: @workspace, project: @project, view: @view %>

<!-- Content Area -->
<div class="flex-1 overflow-y-auto">
  <% if @view == "board" %>
    <% if params[:group_by] == "board" %>
      <div class="space-y-12 pb-12">
        <!-- Sem Quadro -->
        <div class="bg-white dark:bg-ink-paper border-y md:border md:rounded-2xl border-ink/5 dark:border-white/5 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] overflow-hidden flex flex-col mt-6 mx-0 md:mx-6">
          <div class="px-6 py-4 border-b border-ink/5 dark:border-white/5 bg-[#FDFBF7] dark:bg-ink-darker flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-ink/5 dark:bg-white/5 text-ink dark:text-fable flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
              </div>
              <h2 class="text-lg font-serif font-medium text-ink dark:text-fable">Backlog Geral (Sem Quadro)</h2>
              <span class="text-xs font-semibold text-ink-light dark:text-white/60 bg-ink/5 dark:bg-white/5 px-2 py-0.5 rounded-full"><%= @issues.where(board_id: nil).count %> issues</span>
            </div>
          </div>
          <div class="p-0">
            <%= render "projects/board", statuses: @statuses, issues: @issues.where(board_id: nil), workspace: @workspace, project: @project, board_id: "" %>
          </div>
        </div>

        <!-- Por Quadro (Board) -->
        <% @project.boards.each do |board| %>
          <div class="bg-white dark:bg-ink-paper border-y md:border md:rounded-2xl border-ink/5 dark:border-white/5 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] overflow-hidden flex flex-col mx-0 md:mx-6">
            <div class="px-6 py-4 border-b border-ink/5 dark:border-white/5 bg-[#FDFBF7] dark:bg-ink-darker flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-terracotta/10 text-terracotta flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                </div>
                <div>
                  <h2 class="text-lg font-serif font-medium text-ink dark:text-fable leading-none mb-1"><%= board.name %></h2>
                  <% if board.description.present? %>
                    <p class="text-[11px] font-medium text-ink-light dark:text-white/60"><%= board.description %></p>
                  <% end %>
                </div>
                <span class="text-xs font-semibold text-ink-light dark:text-white/60 bg-ink/5 dark:bg-white/5 px-2 py-0.5 rounded-full"><%= @issues.where(board_id: board.id).count %> issues</span>
              </div>
              
              <!-- Board Actions -->
              <div class="flex items-center gap-1">
                <%= link_to edit_workspace_project_board_path(@workspace, @project, board), data: { turbo_frame: "modal" }, class: "p-1.5 rounded-lg text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white hover:bg-ink/5 dark:hover:bg-white/5 transition-colors duration-500", title: "Editar Quadro" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                <% end %>
                <%= button_to workspace_project_board_path(@workspace, @project, board), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir este quadro? As tarefas não serão excluídas, apenas voltarão para o Backlog Geral." }, class: "p-1.5 rounded-lg text-ink-light dark:text-white/60 hover:text-red-500 hover:bg-red-50 transition-colors duration-500", title: "Excluir Quadro" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                <% end %>
              </div>
            </div>
            <div class="p-0">
              <%= render "projects/board", statuses: @statuses, issues: @issues.where(board_id: board.id), workspace: @workspace, project: @project, board_id: board.id %>
            </div>
          </div>
        <% end %>
      </div>
    <% elsif params[:group_by] == "assignee" %>
      <% assignees = @issues.map(&:assignee).compact.uniq %>
      
      <div class="border-b border-ink/5 dark:border-white/5">
        <div class="px-6 lg:px-8 py-3 bg-[#FDFBF7] dark:bg-ink-darker border-b border-ink/5 dark:border-white/5 sticky top-0 z-10 flex items-center gap-2">
          <div class="w-6 h-6 rounded-full bg-ink/10 flex items-center justify-center text-[10px] text-ink dark:text-fable font-bold">?</div>
          <h2 class="text-sm font-medium text-ink dark:text-fable">Sem Responsável</h2>
          <span class="text-[10px] text-ink-light dark:text-white/60 bg-ink/5 dark:bg-white/5 px-1.5 py-0.5 rounded-full font-semibold"><%= @issues.select { |i| i.assignee.nil? }.count %></span>
        </div>
        <div class="min-h-[200px]">
          <%= render "projects/board", statuses: @statuses, issues: @issues.select { |i| i.assignee.nil? }, workspace: @workspace, project: @project, assignee_id: "" %>
        </div>
      </div>

      <% assignees.each do |assignee| %>
        <div class="border-b border-ink/5 dark:border-white/5">
          <div class="px-6 lg:px-8 py-3 bg-[#FDFBF7] dark:bg-ink-darker border-b border-ink/5 dark:border-white/5 sticky top-0 z-10 flex items-center gap-2">
            <div class="w-6 h-6 rounded-full bg-ink border border-ink/10 dark:border-white/10 flex items-center justify-center text-[10px] text-white font-bold"><%= assignee.email[0].upcase %></div>
            <h2 class="text-sm font-medium text-ink dark:text-fable"><%= assignee.email %></h2>
            <span class="text-[10px] text-ink-light dark:text-white/60 bg-ink/5 dark:bg-white/5 px-1.5 py-0.5 rounded-full font-semibold"><%= @issues.select { |i| i.assignee_id == assignee.id }.count %></span>
          </div>
          <div class="min-h-[200px]">
            <%= render "projects/board", statuses: @statuses, issues: @issues.select { |i| i.assignee_id == assignee.id }, workspace: @workspace, project: @project, assignee_id: assignee.id %>
          </div>
        </div>
      <% end %>
    <% else %>
      <%= render "projects/board", statuses: @statuses, issues: @issues, workspace: @workspace, project: @project %>
    <% end %>
  <% elsif @view == "list" %>
    <%= render "projects/list_view", issues: @issues, workspace: @workspace, project: @project %>
  <% elsif @view == "milestones" %>
    <%= render "projects/milestones_view", milestones: @milestones, workspace: @workspace, project: @project %>
  <% elsif @view == "documents" %>
    <%= render "projects/documents_view", documents: @documents, workspace: @workspace, project: @project %>
  <% elsif @view == "whiteboards" %>
    <%= render "projects/whiteboards_view", whiteboards: @whiteboards, workspace: @workspace, project: @project %>
  <% elsif @view == "overview" %>
    <%= render "projects/overview_view", workspace: @workspace, project: @project %>
  <% end %>
</div>
