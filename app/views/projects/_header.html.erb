<!-- Project Header -->
<header class="border-b border-ink/5 dark:border-white/5 bg-white/60 dark:bg-ink-paper/80 backdrop-blur-md sticky top-0 z-10 transition-colors duration-500">
  <div class="px-4 sm:px-6 lg:px-8 py-3 sm:py-4">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <% if @project.logo.attached? %>
          <%= image_tag @project.logo, class: "w-8 h-8 sm:w-9 sm:h-9 rounded-xl object-cover border border-ink/5 dark:border-white/5 shadow-sm shrink-0" %>
        <% elsif @project.icon.present? %>
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center text-base sm:text-lg shrink-0 shadow-sm border border-ink/5 dark:border-white/5 bg-ink/5 dark:bg-white/5">
            <%= @project.icon %>
          </div>
        <% else %>
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center text-xs sm:text-sm font-serif font-bold shrink-0 shadow-sm border border-ink/5 dark:border-white/5 bg-terracotta/10 text-terracotta">
            <%= @project.identifier_prefix.presence || @project.name[0..1].upcase %>
          </div>
        <% end %>
        <div class="min-w-0">
          <h1 class="text-base sm:text-lg font-serif font-medium text-ink dark:text-fable truncate leading-tight"><%= @project.name %></h1>
          <p class="text-[10px] sm:text-[11px] text-ink-light dark:text-white/60 font-sans truncate"><%= @project.issues.count %> issues · <%= @project.issues.joins(:issue_status).where(issue_statuses: { category: "done" }).count %> concluídas</p>
        </div>
      </div>
      
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <%= link_to new_workspace_project_board_path(@workspace, @project), data: { turbo_frame: "modal" }, class: "inline-flex items-center gap-1 px-2.5 sm:px-3 py-1.5 text-xs font-medium text-ink dark:text-fable bg-ink/5 dark:bg-white/5 rounded-lg hover:bg-ink/10 transition-colors duration-500", title: "Criar um sub-board para organizar as tarefas" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
          <span class="hidden md:inline">Novo Board</span>
        <% end %>

        <%= link_to new_workspace_project_issue_path(@workspace, @project), data: { turbo_frame: "modal" }, class: "inline-flex items-center gap-1 px-2.5 sm:px-3 py-1.5 text-xs font-medium text-white bg-terracotta rounded-lg hover:bg-[#c26244] transition-colors duration-500" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span class="hidden sm:inline">Nova Issue</span>
          <span class="sm:hidden">Issue</span>
        <% end %>

        <!-- Project Settings Button -->
        <%= link_to edit_workspace_project_path(@workspace, @project), data: { turbo_frame: "modal" }, class: "inline-flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 text-ink-light dark:text-white/60 bg-ink/5 dark:bg-white/5 rounded-lg hover:bg-ink/10 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors duration-500" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Tabs Navigation -->
  <nav class="px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-between bg-white dark:bg-ink-paper border-b border-transparent transition-colors duration-500 gap-2 sm:gap-0">
    <div class="flex items-center gap-1 -mb-px overflow-x-auto hide-scrollbar scroll-smooth py-1 sm:py-0.5 -mx-4 sm:mx-0 px-4 sm:px-0">
      <%= link_to workspace_project_path(@workspace, @project, view: "overview"),
          class: "px-3 py-2 text-xs font-medium border-b-2 transition-colors shrink-0 whitespace-nowrap #{@view == 'overview' ? 'text-terracotta border-terracotta font-bold' : 'text-ink-light dark:text-white/60 border-transparent hover:text-ink dark:hover:text-fable dark:hover:text-white hover:border-ink/20'} duration-500" do %>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Visão Geral
        </span>
      <% end %>

      <%= link_to workspace_project_path(@workspace, @project, view: "board"),
          class: "px-3 py-2 text-xs font-medium border-b-2 transition-colors shrink-0 whitespace-nowrap #{@view == 'board' ? 'text-terracotta border-terracotta font-bold' : 'text-ink-light dark:text-white/60 border-transparent hover:text-ink dark:hover:text-fable dark:hover:text-white hover:border-ink/20'} duration-500" do %>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          Quadro Kanban
        </span>
      <% end %>
      
      <%= link_to workspace_project_path(@workspace, @project, view: "list"),
          class: "px-3 py-2 text-xs font-medium border-b-2 transition-colors shrink-0 whitespace-nowrap #{@view == 'list' ? 'text-terracotta border-terracotta font-bold' : 'text-ink-light dark:text-white/60 border-transparent hover:text-ink dark:hover:text-fable dark:hover:text-white hover:border-ink/20'} duration-500" do %>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          Lista
        </span>
      <% end %>

      <%= link_to workspace_project_path(@workspace, @project, view: "milestones"),
          class: "px-3 py-2 text-xs font-medium border-b-2 transition-colors shrink-0 whitespace-nowrap #{@view == 'milestones' ? 'text-terracotta border-terracotta font-bold' : 'text-ink-light dark:text-white/60 border-transparent hover:text-ink dark:hover:text-fable dark:hover:text-white hover:border-ink/20'} duration-500" do %>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          Milestones
        </span>
      <% end %>

      <%= link_to workspace_project_path(@workspace, @project, view: "documents"),
          class: "px-3 py-2 text-xs font-medium border-b-2 transition-colors shrink-0 whitespace-nowrap #{@view == 'documents' ? 'text-terracotta border-terracotta font-bold' : 'text-ink-light dark:text-white/60 border-transparent hover:text-ink dark:hover:text-fable dark:hover:text-white hover:border-ink/20'} duration-500" do %>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          Documentos
        </span>
      <% end %>

      <%= link_to workspace_project_path(@workspace, @project, view: "whiteboards"),
          class: "px-3 py-2 text-xs font-medium border-b-2 transition-colors shrink-0 whitespace-nowrap #{@view == 'whiteboards' ? 'text-terracotta border-terracotta font-bold' : 'text-ink-light dark:text-white/60 border-transparent hover:text-ink dark:hover:text-fable dark:hover:text-white hover:border-ink/20'} duration-500" do %>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="14" x="3" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
          Whiteboard
        </span>
      <% end %>
    </div>
    
    <% if @view == "board" %>
      <div class="flex items-center justify-end gap-2 shrink-0 py-1 sm:py-0">
        <div class="flex items-center gap-1.5 text-xs">
          <span class="text-[11px] text-ink-light dark:text-white/60 font-medium">Agrupar:</span>
          <%= form_with url: workspace_project_path(@workspace, @project), method: :get, data: { turbo_frame: "_top" }, class: "inline-block" do |f| %>
            <%= f.hidden_field :view, value: "board" %>
            <%= f.select :group_by, [["Sem agrupamento", ""], ["Por Boards", "board"], ["Por Responsável", "assignee"]], { selected: params[:group_by] }, class: "text-xs border-ink/10 dark:border-white/10 rounded-md bg-[#FDFBF7] dark:bg-ink-darker font-medium text-ink dark:text-fable focus:ring-terracotta/20 py-1 pl-2 pr-6 cursor-pointer shadow-xs", onchange: "this.form.submit()" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </nav>
</header>
