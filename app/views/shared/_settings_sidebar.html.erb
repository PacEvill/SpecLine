<div class="flex flex-col gap-6 py-2">
  <div>
    <div class="px-6 pb-2 text-[10px] uppercase font-bold text-ink-light/50 dark:text-white/50 tracking-wider">Conta</div>
    <nav class="px-4 space-y-1">
      <%= link_to edit_user_registration_path, data: { turbo_frame: "settings_content" }, class: "flex items-center justify-between p-2.5 rounded-xl transition-all group #{current_page?(edit_user_registration_path) ? 'bg-[#FDFBF7] dark:bg-ink-paper border border-ink/5 dark:border-white/5 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)]' : 'hover:bg-ink/5 dark:hover:bg-white/5'} duration-500" do %>
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="<%= current_page?(edit_user_registration_path) ? 'text-terracotta' : 'text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable' %>"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span class="text-sm font-medium <%= current_page?(edit_user_registration_path) ? 'text-ink dark:text-fable' : 'text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable' %>">Perfil da Conta</span>
        </div>
      <% end %>
      
      <%= link_to preferences_path, data: { turbo_frame: "settings_content" }, class: "flex items-center justify-between p-2.5 rounded-xl transition-all group #{current_page?(preferences_path) ? 'bg-[#FDFBF7] dark:bg-ink-paper border border-ink/5 dark:border-white/5 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)]' : 'hover:bg-ink/5 dark:hover:bg-white/5'} duration-500" do %>
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="<%= current_page?(preferences_path) ? 'text-terracotta' : 'text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable' %>"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          <span class="text-sm font-medium <%= current_page?(preferences_path) ? 'text-ink dark:text-fable' : 'text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable' %>">Preferências & Tema</span>
        </div>
      <% end %>

      <button onclick="alert('Funcionalidade em desenvolvimento.')" class="w-full flex items-center justify-between p-2.5 rounded-xl transition-all group hover:bg-ink/5 dark:hover:bg-white/5 duration-500">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span class="text-sm font-medium text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable">Segurança & Login</span>
        </div>
      </button>
    </nav>
  </div>

  <div>
    <div class="px-6 pb-2 text-[10px] uppercase font-bold text-ink-light/50 dark:text-white/50 tracking-wider">Notificações</div>
    <nav class="px-4 space-y-1">
      <button onclick="alert('Funcionalidade em desenvolvimento.')" class="w-full flex items-center justify-between p-2.5 rounded-xl transition-all group hover:bg-ink/5 dark:hover:bg-white/5 duration-500">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          <span class="text-sm font-medium text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable">Notificações por Email</span>
        </div>
      </button>
      <button onclick="alert('Funcionalidade em desenvolvimento.')" class="w-full flex items-center justify-between p-2.5 rounded-xl transition-all group hover:bg-ink/5 dark:hover:bg-white/5 duration-500">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span class="text-sm font-medium text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable">Telegram & Slack</span>
        </div>
      </button>
    </nav>
  </div>
  
  <div>
    <div class="px-6 pb-2 text-[10px] uppercase font-bold text-ink-light/50 dark:text-white/50 tracking-wider">Geral</div>
    <nav class="px-4 space-y-1 mb-8">
      <button onclick="alert('Funcionalidade em desenvolvimento.')" class="w-full flex items-center justify-between p-2.5 rounded-xl transition-all group hover:bg-ink/5 dark:hover:bg-white/5 duration-500">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          <span class="text-sm font-medium text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable">Sessões Ativas</span>
        </div>
      </button>
      <button onclick="alert('Funcionalidade em desenvolvimento.')" class="w-full flex items-center justify-between p-2.5 rounded-xl transition-all group hover:bg-ink/5 dark:hover:bg-white/5 duration-500">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          <span class="text-sm font-medium text-ink-light dark:text-white/60 group-hover:text-ink dark:group-hover:text-fable">Assinatura e Cobrança</span>
        </div>
      </button>
    </nav>
  </div>
</div>
