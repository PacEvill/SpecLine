                <span class="font-mono text-[10px] uppercase text-ink/50 dark:text-white/50 font-bold">Horas de Foco Devolvidas / Mês</span>
                <div id="stat-hours-saved" class="text-3xl md:text-4xl font-mono font-bold text-sage">154h</div>
                <span class="text-xs text-ink/60 dark:text-white/60 font-sans">Equivalente a 1 dev sênior a mais</span>
              </div>

              <div class="p-6 bg-fable-light dark:bg-ink-darker border border-ink/15 dark:border-white/10 rounded-xl space-y-1">
                <span class="font-mono text-[10px] uppercase text-ink/50 dark:text-white/50 font-bold">Economia em Retrabalho</span>
                <div id="stat-rework-saved" class="text-3xl md:text-4xl font-mono font-bold text-ocean">R$ 21.500</div>
