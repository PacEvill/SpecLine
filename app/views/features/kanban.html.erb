<div class="w-full min-h-screen flex flex-col bg-fable-light dark:bg-[#18181A] text-ink dark:text-white bg-grain selection:bg-terracotta/30 selection:text-ink font-sans transition-colors duration-500 relative" data-controller="tasks-workbench">

