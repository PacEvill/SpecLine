<div class="w-full min-h-screen flex flex-col bg-fable-light dark:bg-[#18181A] text-ink dark:text-white bg-grain selection:bg-terracotta/30 selection:text-ink font-sans transition-colors duration-500" data-controller="docs-workbench">

  <%= render 'shared/marketing_header' %>

  <!-- HERO SECTION: Clean, Focused Editorial Presentation -->
  <header class="p-8 md:p-20 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#18181A] relative overflow-hidden text-center">
    
    <!-- Ambient Light Flare -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[320px] bg-terracotta/10 dark:bg-terracotta/5 blur-[120px] rounded-full pointer-events-none animate-glow-pulse"></div>

    <div class="max-w-4xl mx-auto space-y-6 relative z-10">
      <div class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.25em] uppercase text-terracotta font-bold">
        <span class="w-2 h-2 rounded-full bg-terracotta inline-block"></span>
        Arquitetura do Conhecimento // Escrita Sem Ruído
      </div>
      
      <h1 class="font-serif font-light text-5xl md:text-7xl lg:text-8xl leading-[0.95] tracking-tight text-ink dark:text-fable">
        Clareza absoluta.<br>
        <i class="text-sage font-serif-italic">Documentação viva.</i>
      </h1>

      <p class="max-w-2xl mx-auto text-lg md:text-xl text-ink-light dark:text-white/70 font-serif italic leading-relaxed pt-2">
        Esqueça wikis desorganizadas e arquivos perdidos. O editor do SpecLine une a fluidez do Markdown, diagramação nativa em Mermaid, blocos inteligentes e um ambiente sereno projetado para o estado de fluxo.
      </p>

      <!-- Action Button -->
      <div class="pt-6 flex justify-center items-center">
        <%= link_to new_user_registration_path, class: "group px-8 py-4 bg-ink text-white dark:bg-white dark:text-ink hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white font-mono text-xs uppercase tracking-widest font-semibold flex items-center gap-3 shadow-md hover:scale-105 active:scale-95 transition-all cursor-pointer" do %>
          <span>Começar Gratuitamente</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        <% end %>
      </div>
    </div>
  </header>

  <!-- INTERACTIVE WORKBENCH SHOWCASE (Seamlessly switches between Normal & Zen Mode) -->
  <section id="editor-showcase" class="border-b border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper p-6 md:p-16">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-ink/15 dark:border-white/10 pb-6">
        <div>
          <span class="font-mono text-xs text-sage font-bold tracking-widest uppercase">Canvas Interativo</span>
          <h2 class="text-3xl md:text-4xl font-serif font-light text-ink dark:text-white mt-1">
            A interface se molda ao seu momento.
          </h2>
        </div>

        <!-- Integrated View Switcher (Normal vs Zen) -->
        <div class="flex items-center gap-3">
          <div class="inline-flex border border-ink/20 dark:border-white/20 p-1 bg-fable-light dark:bg-[#18181A]">
            <button type="button"
                    data-action="click->docs-workbench#setMode"
                    data-mode="normal"
                    data-docs-workbench-target="btnNormal"
                    class="px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider bg-ink text-white dark:bg-white dark:text-ink font-semibold transition-all shadow-sm cursor-pointer">
              Visão Completa
            </button>
            <button type="button"
                    data-action="click->docs-workbench#setMode"
                    data-mode="zen"
                    data-docs-workbench-target="btnZen"
                    class="px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider text-ink/60 dark:text-white/60 hover:text-ink dark:hover:text-white transition-all flex items-center gap-1.5 cursor-pointer">
              <span class="w-1.5 h-1.5 rounded-full bg-terracotta"></span>
              Modo Zen (Foco)
            </button>
          </div>
        </div>
      </div>

      <!-- Workbench Frame -->
      <div class="border border-ink/20 dark:border-white/15 shadow-2xl bg-fable-light dark:bg-ink-darker overflow-hidden grid grid-cols-12 min-h-[580px] transition-all">
        
        <!-- Left Sub-Sidebar (Collapsible in Zen Mode) -->
        <div data-docs-workbench-target="sidebar" class="col-span-12 md:col-span-4 lg:col-span-3 border-b md:border-b-0 md:border-r border-ink/15 dark:border-white/10 p-5 bg-fable-dark/40 dark:bg-ink flex flex-col justify-between transition-all">
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs font-mono text-ink/60 dark:text-white/60 uppercase tracking-wider pb-2 border-b border-ink/10 dark:border-white/10">
              <span>Árvore do Projeto</span>
              <span class="text-terracotta font-bold text-[10px]">+ Documento</span>
            </div>

            <!-- Folder 1: Engenharia -->
            <div class="space-y-1 text-sm font-sans">
              <div class="flex items-center gap-2 text-ink/80 dark:text-white/80 font-medium py-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sage"><path d="m6 9 6 6 6-6"/></svg>
                <span>📁 01. Arquitetura Core</span>
              </div>
              <div class="pl-6 space-y-1 font-mono text-xs">
                <div class="p-1.5 bg-ink/10 dark:bg-white/10 text-terracotta font-semibold flex items-center justify-between">
                  <span>📄 RFC-089: Sync Engine</span>
                  <span class="w-1.5 h-1.5 rounded-full bg-sage animate-pulse"></span>
                </div>
                <div class="p-1.5 text-ink/60 dark:text-white/60 hover:text-ink dark:hover:text-white transition-colors">
                  <span>📄 ADR-012: Data Isolation</span>
                </div>
              </div>
            </div>

            <!-- Folder 2: Guias -->
            <div class="space-y-1 text-sm font-sans pt-2">
              <div class="flex items-center gap-2 text-ink/80 dark:text-white/80 font-medium py-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sage"><path d="m6 9 6 6 6-6"/></svg>
                <span>📁 02. Padrões de Design</span>
              </div>
              <div class="pl-6 space-y-1 font-mono text-xs text-ink/60 dark:text-white/60">
                <div class="p-1.5 hover:text-ink dark:hover:text-white transition-colors">
                  <span>📄 Design Tokens & Brutalism</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Status in Sidebar -->
          <div class="pt-4 border-t border-ink/10 dark:border-white/10 flex items-center justify-between text-xs font-mono text-ink-light/60 dark:text-white/50">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-sage"></div>
              <span>Sincronizado</span>
            </div>
            <span>2 autores online</span>
          </div>
        </div>

        <!-- Document Sheet Canvas -->
        <div data-docs-workbench-target="canvas" class="col-span-12 md:col-span-8 lg:col-span-9 p-6 md:p-12 bg-white dark:bg-ink-paper overflow-y-auto max-h-[640px] transition-all duration-500">
          
          <div class="space-y-6">
            <!-- Document Meta Header -->
            <div class="space-y-2 border-b border-ink/10 dark:border-white/10 pb-5">
              <div class="flex items-center gap-3">
                <span class="font-mono text-[11px] bg-terracotta/10 text-terracotta px-2.5 py-0.5 font-bold">RFC-089</span>
                <span class="font-mono text-xs text-sage font-medium">● Status: Aprovado</span>
                <span class="font-mono text-[10px] text-ink-light/40 dark:text-white/40 ml-auto">428 palavras · 2 min de leitura</span>
              </div>
              <h1 class="text-3xl md:text-4xl font-serif font-bold text-ink dark:text-white tracking-tight">
                Engine de Sincronização & Persistência Local
              </h1>
              <p class="text-xs font-mono text-ink-light/60 dark:text-white/50">
                Atualizado pelo <b class="text-ink dark:text-white">Time de Arquitetura</b> há 3 minutos
              </p>
            </div>

            <!-- Callout Block (Dimmed in Typewriter focus unless active) -->
            <div data-docs-workbench-target="typewriter" class="p-5 border-l-4 border-terracotta bg-terracotta/5 text-ink dark:text-white font-sans text-sm space-y-1">
              <div class="font-mono font-bold text-xs uppercase tracking-wider text-terracotta">💡 Invariante Arquitetural</div>
              <p class="leading-relaxed">
                Todas as operações de edição devem suportar latência zero (*Optimistic UI*) com fallback para fila de reconciliação em background.
              </p>
            </div>

            <div class="prose dark:prose-invert max-w-none text-ink-light dark:text-white/80 font-sans space-y-4">
              <h3 data-docs-workbench-target="typewriter" class="font-serif text-xl font-bold text-ink dark:text-white">1. Visão Geral da Arquitetura</h3>
              
              <!-- Active Line with subtle typewriter marker -->
              <p class="relative pl-4 border-l-2 border-terracotta text-sm leading-relaxed text-ink dark:text-white font-normal">
                Para atingir o padrão brutalista de velocidade, a renderização dos blocos e árvores do documento opera através de nós imutáveis. Abaixo está a topologia de concorrência:
              </p>

              <!-- Code & Diagram Mockup -->
              <div data-docs-workbench-target="typewriter" class="bg-fable-light dark:bg-ink-darker border border-ink/20 dark:border-white/15 p-4 font-mono text-xs space-y-2 rounded-sm">
                <div class="flex justify-between text-[10px] text-ink/40 dark:text-white/40 uppercase tracking-widest border-b border-ink/10 dark:border-white/10 pb-2">
                  <span>mermaid.js // Sequence Flow</span>
                  <span class="text-sage">Live Preview</span>
                </div>
                <div class="text-terracotta">
                  Client(UI) --[Action: InsertBlock]--> Cache(IndexedDB)<br>
                  Cache --[Async Stream]--> WebSockets(SolidCable)<br>
                  SolidCable --[Broadcast]--> Collaborators(Peers)
                </div>
              </div>

              <h3 data-docs-workbench-target="typewriter" class="font-serif text-xl font-bold text-ink dark:text-white pt-2">2. Validações de Sistema</h3>
              <ul data-docs-workbench-target="typewriter" class="space-y-2 text-sm font-sans list-none pl-0">
                <li class="flex items-center gap-2"><span class="text-sage font-bold">✓</span> Suporte completo a atalhos de Markdown (<code>#</code>, <code>&gt;</code>, <code>```</code>, <code>[]</code>)</li>
                <li class="flex items-center gap-2"><span class="text-sage font-bold">✓</span> Preservação de histórico com diffs linha a linha</li>
                <li class="flex items-center gap-2"><span class="text-terracotta font-bold">○</span> Integração de menções de Kanban (<code>@issue-402</code>)</li>
              </ul>
            </div>

            <!-- Zen Mode Live Footer Status Bar (Only visible when Zen is active) -->
            <div data-docs-workbench-target="zenStatus" class="hidden pt-6 border-t border-ink/10 dark:border-white/10 flex items-center justify-between text-xs font-mono text-ink-light/50 dark:text-white/40">
              <span>Modo Zen Ativo · Pressione ESC para visão completa</span>
              <span class="text-sage font-semibold">● Foco Contínuo</span>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EDITORIAL DEEP DIVE: FOCO PROFUNDO & MODO ZEN -->
  <section class="border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-[#151517] p-8 md:p-20 relative overflow-hidden">
    <div class="max-w-6xl mx-auto space-y-16">
      
      <!-- Philosophy Statement -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-5 space-y-4">
          <div class="font-mono text-xs text-terracotta font-bold uppercase tracking-widest">
            Filosofia de Escrita
          </div>
          <h2 class="text-3xl md:text-5xl font-serif font-light text-ink dark:text-white leading-[1.05]">
            O silêncio é a base do trabalho técnico.
          </h2>
        </div>
        <div class="lg:col-span-7 space-y-4 font-serif text-lg md:text-xl text-ink-light dark:text-white/80 italic leading-relaxed">
          <p>
            "A documentação técnica mais valiosa não é aquela cheia de botões e animações desnecessárias. É aquela onde o engenheiro ou designer pôde sentar e pensar sem interrupções."
          </p>
          <p class="font-sans text-sm text-ink-light/70 dark:text-white/60 not-italic">
            No SpecLine, o <b>Modo Zen</b> não é um modo secundário — é o coração do nosso editor. Com um único atalho (<kbd class="font-mono text-xs bg-ink/5 dark:bg-white/10 px-1.5 py-0.5 text-terracotta">ESC</kbd>), toda a interface periférica se dissolve, deixando apenas a folha de pensamento puro.
          </p>
        </div>
      </div>

      <!-- 3 Zen Mechanics Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="p-8 border border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper hover-card-lift space-y-4">
          <div class="font-mono text-xs text-terracotta font-bold uppercase tracking-wider">
            [01] Ocultação Fluida
          </div>
          <h3 class="font-serif text-2xl text-ink dark:text-white font-medium">Zero Distrações</h3>
          <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
            Nenhum pop-up, aviso ou menu concorre pela sua atenção. A barra lateral e cabeçalhos recolhem suavemente sem quebrar o layout.
          </p>
        </div>

        <div class="p-8 border border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper hover-card-lift space-y-4">
          <div class="font-mono text-xs text-sage font-bold uppercase tracking-wider">
            [02] Tipografia Editorial
          </div>
          <h3 class="font-serif text-2xl text-ink dark:text-white font-medium">Contraste Térmico</h3>
          <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
            Fontes serifadas e espaçamentos calibrados para leitura prolongada em pergaminho suave (<span class="font-mono text-xs">#F0F0F3</span>) ou nanquim escuro (<span class="font-mono text-xs">#18181A</span>).
          </p>
        </div>

        <div class="p-8 border border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper hover-card-lift space-y-4">
          <div class="font-mono text-xs text-ochre font-bold uppercase tracking-wider">
            [03] Foco de Máquina de Escrever
          </div>
          <h3 class="font-serif text-2xl text-ink dark:text-white font-medium">Typewriter Focus</h3>
          <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
            Os parágrafos ao redor da linha ativa suavizam suavemente, mantendo a sua mente 100% ancorada no parágrafo em desenvolvimento.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- 4 BENTO PILLARS OF SPECLINE DOCS -->
  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border-b border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper">
    
    <!-- Pillar 1 -->
    <div class="p-8 md:p-10 border-b md:border-b-0 md:border-r border-ink/15 dark:border-white/10 hover-card-lift group bg-white dark:bg-ink-paper">
      <div class="space-y-4">
        <span class="font-mono text-[10px] text-terracotta font-bold tracking-widest uppercase">01 // FLUIDEZ</span>
        <h3 class="font-serif text-2xl font-light text-ink dark:text-white">Editor Sem Atrito</h3>
        <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
          Digite <code class="font-mono text-xs bg-ink/5 dark:bg-white/10 px-1 text-terracotta">/</code> para invocar títulos, listas, tabelas, código ou callouts sem nunca tirar as mãos do teclado.
        </p>
      </div>
    </div>

    <!-- Pillar 2 -->
    <div class="p-8 md:p-10 border-b md:border-b-0 md:border-r border-ink/15 dark:border-white/10 hover-card-lift group bg-white dark:bg-ink-paper">
      <div class="space-y-4">
        <span class="font-mono text-[10px] text-sage font-bold tracking-widest uppercase">02 // ENGENHARIA</span>
        <h3 class="font-serif text-2xl font-light text-ink dark:text-white">Mermaid & Código</h3>
        <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
          Crie fluxogramas, diagramas de sequência e modelos de banco de dados renderizados nativamente em tempo real.
        </p>
      </div>
    </div>

    <!-- Pillar 3 -->
    <div class="p-8 md:p-10 border-b md:border-b-0 md:border-r border-ink/15 dark:border-white/10 hover-card-lift group bg-white dark:bg-ink-paper">
      <div class="space-y-4">
        <span class="font-mono text-[10px] text-ochre font-bold tracking-widest uppercase">03 // ESTRUTURA</span>
        <h3 class="font-serif text-2xl font-light text-ink dark:text-white">Árvore Infinita</h3>
        <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
          Organize por pastas, subpastas e projetos. Cada documento pode conter filhos sem perder a hierarquia lógica.
        </p>
      </div>
    </div>

    <!-- Pillar 4 -->
    <div class="p-8 md:p-10 hover-card-lift group bg-white dark:bg-ink-paper">
      <div class="space-y-4">
        <span class="font-mono text-[10px] text-ocean font-bold tracking-widest uppercase">04 // SOBERANIA</span>
        <h3 class="font-serif text-2xl font-light text-ink dark:text-white">Exportação Aberta</h3>
        <p class="font-sans text-sm text-ink-light dark:text-white/70 leading-relaxed">
          Exporte documentos em PDF executivo de alta fidelidade, Markdown puro ou JSON consolidado com um único clique.
        </p>
      </div>
    </div>
  </section>


  <!-- CALL TO ACTION SECTION -->
  <section class="p-12 md:p-24 border-b border-ink/15 dark:border-white/10 bg-fable-light dark:bg-ink text-center relative overflow-hidden">
    <div class="max-w-3xl mx-auto space-y-6 relative z-10">
      <p class="font-mono text-xs tracking-widest text-terracotta uppercase font-bold">Comece a Documentar com Clareza</p>
      <h2 class="font-serif font-light text-4xl md:text-6xl tracking-tight text-ink dark:text-white">
        A sua equipe merece um ambiente desenhado para o foco.
      </h2>
      <p class="font-serif italic text-lg text-ink-light dark:text-white/70">
        Disponível no plano gratuito para até 5 pessoas com documentos e árvores ilimitadas.
      </p>
      <div class="pt-4 flex justify-center">
        <%= link_to new_user_registration_path, class: "group px-8 py-4 bg-ink text-white dark:bg-white dark:text-ink hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white font-mono text-xs uppercase tracking-widest font-semibold flex items-center gap-3 shadow-xl hover:scale-105 active:scale-95 transition-all cursor-pointer" do %>
          <span>Criar Conta Gratuita</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        <% end %>
      </div>
    </div>
  </section>

  <%= render 'shared/marketing_footer' %>
</div>
