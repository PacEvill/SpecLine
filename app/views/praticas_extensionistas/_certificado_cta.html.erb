<%# Certificado de participação: a pessoa digita o nome e baixa em PDF. %>
<div class="print-card p-6 rounded-2xl bg-white dark:bg-ink-paper border border-sage/25 flex flex-col md:flex-row md:items-center justify-between gap-4">
  <div class="space-y-1">
    <h3 class="font-serif text-xl font-bold text-ink dark:text-white">Certificado na hora</h3>
    <p class="text-sm text-ink-light dark:text-white/65">Digita seu nome e o certificado de participação sai pronto em PDF — você mesmo baixa e guarda.</p>
  </div>
  <%= form_with url: pratica_certificado_path, method: :get, local: true, html: { class: "flex flex-col sm:flex-row items-stretch sm:items-center gap-2 shrink-0" }, data: { turbo: false } do %>
    <%= text_field_tag :nome, nil, required: true, maxlength: 80, placeholder: "Seu nome", class: "w-full sm:w-48 px-3 py-2.5 rounded-xl border border-ink/15 dark:border-white/15 bg-fable-light dark:bg-[#18181A] text-sm text-ink dark:text-white placeholder:text-ink-light/40 dark:placeholder:text-white/30 focus:outline-none focus:border-terracotta focus:ring-2 focus:ring-terracotta/20" %>
    <%= submit_tag "Baixar certificado", class: "print-button inline-flex items-center justify-center gap-2 px-5 py-3 bg-ink text-white dark:bg-white dark:text-ink hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white font-mono text-[11px] uppercase tracking-widest font-semibold transition-all cursor-pointer" %>
  <% end %>
</div>
