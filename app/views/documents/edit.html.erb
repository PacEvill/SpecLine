<div class="flex-1 bg-white dark:bg-ink-darker min-h-screen flex flex-col">
  <!-- Editor Header -->
  <header class="h-14 px-4 border-b border-ink/5 dark:border-white/5 flex items-center justify-between sticky top-0 bg-white/90 dark:bg-ink-darker/90 backdrop-blur-sm z-10">
    <div class="flex items-center gap-3">
      <%= link_to workspace_project_document_path(@workspace, @project, @document), class: "p-2 text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable hover:bg-ink/5 dark:hover:bg-white/5 rounded-lg transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      <% end %>
      <div class="text-sm font-sans text-ink-light dark:text-white/60 flex items-center gap-2">
        <span><%= @project.name %></span>
        <span class="text-ink/20 dark:text-white/20">/</span>
        <span class="text-ink dark:text-fable font-medium truncate max-w-[200px]"><%= @document.title %></span>
        <span class="text-ink/20 dark:text-white/20">/</span>
        <span class="text-ink dark:text-fable font-medium">Editar</span>
      </div>
    </div>
  </header>

  <!-- Editor Body -->
  <main class="flex-1 max-w-4xl w-full mx-auto p-8 lg:p-12">
    <%= form_with(model: [@workspace, @project, @document], class: "h-full flex flex-col") do |form| %>
      
      <div class="mb-6 flex">
        <div class="group relative">
          <%= form.text_field :icon, class: "w-16 h-16 text-4xl bg-transparent border-none focus:ring-0 p-0 hover:bg-ink/5 dark:hover:bg-white/5 rounded-2xl text-center transition-colors cursor-pointer", placeholder: "📄" %>
          <div class="absolute -top-8 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-ink dark:bg-fable text-white dark:text-ink text-[10px] py-1 px-2 rounded whitespace-nowrap pointer-events-none">
            Ícone do doc
          </div>
        </div>
      </div>

      <div class="mb-8">
        <%= form.text_field :title, class: "w-full text-4xl lg:text-5xl font-serif font-bold bg-transparent border-none focus:ring-0 p-0 text-ink dark:text-fable placeholder-ink-light/30 dark:placeholder-white/20 resize-none overflow-hidden", placeholder: "Título do Documento", required: true %>
      </div>

      <div class="flex-1 prose prose-ink dark:prose-invert prose-lg max-w-none prose-headings:font-serif prose-a:text-terracotta focus-within:prose-a:text-terracotta">
        <%= form.rich_text_area :content, class: "min-h-[500px] border-none focus:ring-0 p-0 outline-none", placeholder: "Escreva algo brilhante..." %>
      </div>

      <div class="fixed bottom-6 right-6 lg:right-12 flex items-center gap-3 animate-fade-in-up">
        <%= link_to "Cancelar", workspace_project_document_path(@workspace, @project, @document), class: "px-5 py-2.5 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 text-ink dark:text-fable text-sm font-medium rounded-full shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300" %>
        <%= form.submit "Atualizar Documento", class: "px-5 py-2.5 bg-terracotta text-white text-sm font-medium rounded-full shadow-lg shadow-terracotta/20 hover:shadow-xl hover:shadow-terracotta/30 hover:-translate-y-0.5 hover:bg-[#c26244] transition-all cursor-pointer duration-300" %>
      </div>
    <% end %>
  </main>
</div>
