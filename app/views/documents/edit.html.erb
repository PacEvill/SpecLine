<div class="flex-1 bg-white dark:bg-ink min-h-screen flex flex-col font-sans">
  <%= form_with(model: [@workspace, @project, @document], class: "h-full flex flex-col") do |form| %>
    <!-- Header fino sticky -->
    <header class="h-14 px-4 sm:px-6 flex items-center justify-between sticky top-0 bg-white/80 dark:bg-ink/80 backdrop-blur-xl z-50 border-b border-ink/5 dark:border-white/5">
      <div class="flex items-center gap-2">
        <button type="button" class="p-1.5 mr-2 text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 rounded transition-colors hidden md:flex" title="Alternar barra lateral">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
        </button>
        <div class="text-sm text-ink-light dark:text-white/60 flex items-center gap-1.5">
          <%= link_to @project.name, workspace_project_path(@workspace, @project, view: 'documents'), class: "hover:text-ink dark:hover:text-fable transition-colors cursor-pointer" %>
          <span class="text-ink/20 dark:text-white/20 text-xs">/</span>
          <span class="text-ink dark:text-fable font-medium truncate max-w-[200px]"><%= @document.title.presence || "Sem Título" %></span>
        </div>
      </div>
      
      <div class="flex items-center gap-4">
        <span class="text-[11px] font-medium text-ink-light/50 dark:text-white/40 uppercase tracking-wider hidden sm:block">Modo Edição</span>
        <%= form.submit "Salvar", class: "px-4 py-1.5 bg-ink text-fable dark:bg-fable dark:text-ink text-xs font-bold rounded-md shadow-sm hover:bg-terracotta dark:hover:bg-terracotta dark:hover:text-white transition-all cursor-pointer" %>
      </div>
    </header>

    <!-- Corpo do Editor -->
    <main class="flex-1 w-full max-w-[800px] mx-auto px-6 sm:px-12 py-16 lg:py-24 relative z-10">
      
      <!-- Icon Selector (Simplificado) -->
      <div class="mb-4">
        <%= form.text_field :icon, 
            class: "w-20 h-20 text-[56px] leading-none bg-transparent border-none p-0 cursor-pointer outline-none focus:ring-0 placeholder-ink/20 dark:placeholder-white/20", 
            style: "box-shadow: none;", 
            placeholder: "📄", 
            maxlength: 5,
            title: "Ícone" %>
      </div>

      <!-- Título Grande Serifado -->
      <div class="mb-10">
        <%= form.text_area :title, rows: 1, class: "w-full text-5xl sm:text-6xl font-serif font-bold tracking-tight bg-transparent border-none p-0 text-ink dark:text-fable placeholder-ink/20 dark:placeholder-white/20 resize-none overflow-hidden outline-none focus:ring-0", style: "box-shadow: none;", placeholder: "Título sem nome", required: true, oninput: "this.style.height = ''; this.style.height = this.scrollHeight + 'px'" %>
      </div>

      <!-- Tiptap Editor Container -->
      <div data-controller="tiptap" class="mt-4 relative">
        <div class="hidden">
          <%= form.rich_text_area :content %>
        </div>
        
        <!-- Bubble Menu UI (Escondido inicialmente, gerenciado pelo Tiptap) -->
        <div data-tiptap-target="bubbleMenu" class="hidden flex items-center gap-1 p-1 rounded-lg bg-white dark:bg-[#2c2c24] border border-ink/10 dark:border-white/10 shadow-xl shadow-ink/5 dark:shadow-black/20">
          <button type="button" data-action="click->tiptap#toggleBold" class="w-8 h-8 rounded flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors font-bold font-serif" title="Negrito">B</button>
          <button type="button" data-action="click->tiptap#toggleItalic" class="w-8 h-8 rounded flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors italic font-serif" title="Itálico">I</button>
          <button type="button" data-action="click->tiptap#toggleStrike" class="w-8 h-8 rounded flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors line-through font-serif" title="Riscado">S</button>
          <div class="w-px h-4 bg-ink/10 dark:bg-white/10 mx-1"></div>
          <button type="button" data-action="click->tiptap#toggleH1" class="w-8 h-8 rounded flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors text-xs font-bold" title="Título 1">H1</button>
          <button type="button" data-action="click->tiptap#toggleH2" class="w-8 h-8 rounded flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors text-xs font-bold" title="Título 2">H2</button>
          <div class="w-px h-4 bg-ink/10 dark:bg-white/10 mx-1"></div>
          <button type="button" data-action="click->tiptap#toggleBulletList" class="w-8 h-8 rounded flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors" title="Lista">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          </button>
          <button type="button" data-action="click->tiptap#toggleBlockquote" class="w-8 h-8 rounded flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors" title="Citação">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path></svg>
          </button>
        </div>
        
        <div data-tiptap-target="editor" class="w-full"></div>
      </div>
    </main>
  <% end %>
</div>
