          <% end %>
          <%= link_to "Ver Planos & Preços", pricing_path, class: "px-6 py-4 border border-ink/20 dark:border-white/20 text-ink dark:text-white hover:border-sage hover:text-sage font-mono text-xs uppercase tracking-widest font-semibold transition-all" %>
        </div>
