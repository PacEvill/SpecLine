    </section>

    <!-- INTERACTIVE SIMULATOR 2: SPRINT WASTE & VELOCITY DIAGNOSTIC -->
    <section class="py-24 px-6 border-b border-ink/15 dark:border-white/10 bg-white dark:bg-ink-paper">
      <div class="max-w-6xl mx-auto space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-3">
