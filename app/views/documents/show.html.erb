<% content_for(:sidebar) do %>
  <%= render "shared/workspace_sidebar", workspace: @workspace, current_project: @project %>
<% end %>

<div class="flex-1 bg-white dark:bg-ink min-h-screen flex flex-col font-sans">
  <!-- Top Bar -->
  <header class="h-14 px-6 flex items-center justify-between sticky top-0 bg-white/80 dark:bg-ink/80 backdrop-blur-xl z-50 border-b border-ink/5 dark:border-white/5">
    <div class="flex items-center gap-2">
      <%= link_to workspace_project_path(@workspace, @project, view: 'documents'), class: "p-1.5 text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/10 rounded transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      <% end %>
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center text-sm text-ink-light dark:text-white/60 ml-1">
        <%= link_to @project.name, workspace_project_path(@workspace, @project, view: 'documents'), class: "hover:text-ink dark:hover:text-fable hover:underline transition-colors" %>
        <span class="mx-1.5 text-ink/30 dark:text-white/30 text-xs">/</span>
        <% if @document.parent %>
          <%= link_to @document.parent.title, workspace_project_document_path(@workspace, @project, @document.parent), class: "hover:text-ink dark:hover:text-fable hover:underline transition-colors truncate max-w-[120px]" %>
          <span class="mx-1.5 text-ink/30 dark:text-white/30 text-xs">/</span>
        <% end %>
        <span class="text-ink dark:text-fable font-medium truncate max-w-[200px]"><%= @document.title.presence || "Sem Título" %></span>
      </nav>
    </div>

    <div class="flex items-center gap-1">
      <div class="flex items-center gap-2 mr-3 text-[11px] text-ink-light/70 dark:text-white/50 font-medium">
        <div class="w-5 h-5 rounded bg-ink/10 dark:bg-white/10 flex items-center justify-center font-bold text-[10px] text-ink dark:text-fable uppercase">
          <%= @document.author.email[0] %>
        </div>
        <span><%= l(@document.updated_at.to_date, format: :short) %></span>
      </div>

      <div class="w-px h-4 bg-ink/10 dark:bg-white/10 mx-2"></div>

      <%= link_to new_workspace_project_document_path(@workspace, @project, parent_id: @document.id), class: "p-1.5 text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable hover:bg-ink/5 dark:hover:bg-white/10 rounded transition-colors", title: "Adicionar Sub-página" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
      <% end %>

      <%= link_to edit_workspace_project_document_path(@workspace, @project, @document), class: "p-1.5 text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable hover:bg-ink/5 dark:hover:bg-white/10 rounded transition-colors", title: "Editar Documento" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
      <% end %>

      <%= button_to workspace_project_document_path(@workspace, @project, @document), method: :delete, data: { turbo_confirm: "Tem certeza? Esta ação apagará o documento e todas as suas sub-páginas." }, class: "p-1.5 text-ink-light dark:text-white/60 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 rounded transition-colors ml-1", title: "Excluir Documento" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
      <% end %>
    </div>
  </header>

  <!-- Document Cover Pattern -->
  <div class="w-full h-48 lg:h-64 relative group" style="background-image: radial-gradient(circle at 2px 2px, rgba(150,150,150,0.15) 1px, transparent 0); background-size: 24px 24px;">
    <div class="absolute inset-0 bg-gradient-to-br from-terracotta/5 via-transparent to-sage/10 dark:from-terracotta/10 dark:via-ink dark:to-sage/10"></div>
  </div>

  <!-- Document Content -->
  <main class="flex-1 overflow-y-auto z-10 -mt-16 lg:-mt-20">
    <article class="w-full max-w-[800px] mx-auto px-6 sm:px-12 pb-32 group/article relative">
      
      <!-- Icon -->
      <div class="mb-6">
        <% if @document.icon.present? %>
          <div class="inline-flex items-center justify-center w-[100px] h-[100px] rounded-2xl bg-white dark:bg-ink border-4 border-white dark:border-ink shadow-sm text-[64px] leading-none"><%= @document.icon %></div>
        <% else %>
          <!-- Empty Icon Placeholder (maintains layout) -->
          <div class="inline-flex items-center justify-center w-[100px] h-[100px] rounded-2xl bg-white/50 dark:bg-ink/50 border-4 border-white dark:border-ink backdrop-blur-sm opacity-0 group-hover/article:opacity-100 transition-all">
            <%= link_to edit_workspace_project_document_path(@workspace, @project, @document), class: "inline-flex flex-col items-center gap-1 text-xs font-medium text-ink-light dark:text-white/40 hover:text-ink dark:hover:text-fable" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
              Adicionar ícone
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Title -->
      <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-ink dark:text-fable mb-10 leading-tight"><%= @document.title.presence || "Sem Título" %></h1>

      <!-- ActionText Content -->
      <div class="mt-4 prose prose-ink dark:prose-invert max-w-none prose-p:text-[17px] prose-p:leading-loose prose-headings:font-bold prose-headings:tracking-tight prose-a:text-terracotta hover:prose-a:text-[#c26244] prose-img:rounded-xl prose-pre:bg-ink-paper prose-pre:border prose-pre:border-white/10">
        <%= @document.content %>
      </div>

      <!-- Sub-pages List -->
      <% if @children.any? %>
        <div class="mt-16 pt-8 border-t border-ink/5 dark:border-white/5">
          <div class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-ink-light dark:text-white/40 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
            Páginas Aninhadas
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% @children.each do |child| %>
              <%= link_to workspace_project_document_path(@workspace, @project, child), class: "flex items-center gap-4 p-4 rounded-xl border border-ink/5 dark:border-white/5 bg-[#FDFBF7] dark:bg-ink-paper hover:border-ink/20 dark:hover:border-white/20 hover:shadow-md hover:-translate-y-0.5 transition-all group" do %>
                <span class="text-2xl shrink-0 leading-none"><%= child.icon.presence || "📄" %></span>
                <span class="font-medium text-base text-ink dark:text-fable group-hover:text-terracotta transition-colors truncate"><%= child.title.presence || "Sem Título" %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </article>
  </main>
</div>
