<!-- Lumen Studio Style Marketing Footer -->
<footer class="relative bg-fable-light dark:bg-ink text-ink dark:text-fable-light pt-24 pb-8 overflow-hidden border-t-0">
  
  <!-- Light Burst Effect (Mountain/Sand shape) -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[80vw] h-[50vh] bg-ink/5 dark:bg-fable-light/10 blur-[100px] rounded-[100%] pointer-events-none animate-glow-pulse"></div>

  <div class="max-w-[1400px] mx-auto px-8 md:px-16 relative z-10 grid grid-cols-1 md:grid-cols-12 gap-12 mb-32">
    <!-- Brand & Tagline -->
    <div class="col-span-1 md:col-span-4 space-y-6">
      <div class="flex items-center gap-3 group cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-terracotta group-hover:rotate-12 transition-transform duration-300"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></svg>
        <span class="font-sans font-semibold text-2xl tracking-tight text-ink dark:text-white">SpecLine</span>
      </div>
      <p class="font-sans text-ink-light dark:text-white/60 text-base leading-relaxed max-w-xs">
        Ambiente de foco e produtividade para equipes, projetos e profissionais operarem com clareza todos os dias.
      </p>
      <div class="flex gap-4 pt-4 text-ink/50 dark:text-white/50">
        <!-- X / Twitter -->
        <a href="#" aria-label="Twitter/X" class="hover:text-ink dark:hover:text-white hover:-translate-y-1 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
        </a>
        <!-- LinkedIn -->
        <a href="#" aria-label="LinkedIn" class="hover:text-ink dark:hover:text-white hover:-translate-y-1 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <!-- GitHub -->
        <a href="#" aria-label="GitHub" class="hover:text-ink dark:hover:text-white hover:-translate-y-1 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
        <!-- Email / Gmail -->
        <a href="mailto:contato@specline.com" aria-label="Email" class="hover:text-ink dark:hover:text-white hover:-translate-y-1 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Links Grid -->
    <div class="col-span-1 md:col-span-8 grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="space-y-6">
        <h4 class="font-mono text-[10px] tracking-widest uppercase text-ink-light/60 dark:text-white/40">Produto</h4>
        <ul class="space-y-4 font-sans text-sm text-ink-light dark:text-white/80">
          <li><%= link_to "Funcionalidades", "/features", class: "hover:text-terracotta hover:translate-x-1 inline-block transition-all" %></li>
          <li><%= link_to "Soluções", "/solutions", class: "hover:text-terracotta hover:translate-x-1 inline-block transition-all" %></li>
          <li><%= link_to "Preços", pricing_path, class: "hover:text-terracotta hover:translate-x-1 inline-block transition-all" %></li>
          <li><%= link_to "Changelog", "/changelog", class: "hover:text-terracotta hover:translate-x-1 inline-block transition-all" %></li>
        </ul>
      </div>
      <div class="space-y-6">
        <h4 class="font-mono text-[10px] tracking-widest uppercase text-ink-light/60 dark:text-white/40">Empresa</h4>
        <ul class="space-y-4 font-sans text-sm text-ink-light dark:text-white/80">
          <li><%= link_to "Filosofia SpecLine", "/philosophy", class: "hover:text-terracotta hover:translate-x-1 inline-block transition-all" %></li>
          <li><%= link_to "Sobre Nós", "/philosophy/vision", class: "hover:text-terracotta hover:translate-x-1 inline-block transition-all" %></li>
          <li><a href="#" class="hover:text-terracotta hover:translate-x-1 inline-block transition-all">Carreiras</a></li>
          <li><%= link_to "Contato", "/contact", class: "hover:text-terracotta hover:translate-x-1 inline-block transition-all" %></li>
        </ul>
      </div>
      <div class="space-y-6">
        <h4 class="font-mono text-[10px] tracking-widest uppercase text-ink-light/60 dark:text-white/40">Recursos</h4>
        <ul class="space-y-4 font-sans text-sm text-ink-light dark:text-white/80">
          <li><%= link_to "Documentação", "/features/docs", class: "hover:text-terracotta hover:translate-x-1 inline-block transition-all" %></li>
          <li><a href="#" class="hover:text-terracotta hover:translate-x-1 inline-block transition-all">Blog</a></li>
          <li><a href="#" class="hover:text-terracotta hover:translate-x-1 inline-block transition-all">Comunidade</a></li>
          <li><a href="#" class="hover:text-terracotta hover:translate-x-1 inline-block transition-all">Tutoriais</a></li>
        </ul>
      </div>
      <div class="space-y-6">
        <h4 class="font-mono text-[10px] tracking-widest uppercase text-ink-light/60 dark:text-white/40">Legal</h4>
        <ul class="space-y-4 font-sans text-sm text-ink-light dark:text-white/80">
          <li><%= link_to "Privacidade", privacy_path, class: "hover:text-terracotta hover:translate-x-1 inline-block transition-all" %></li>
          <li><%= link_to "Termos", terms_path, class: "hover:text-terracotta hover:translate-x-1 inline-block transition-all" %></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Giant Typography Background at the bottom -->
  <div class="relative w-full overflow-hidden flex justify-center pb-12 z-10 pointer-events-none">
    <div class="text-[18vw] leading-[0.75] font-sans font-bold tracking-tighter text-ink/10 dark:text-white/10" style="margin-bottom: -6vw;">
      SpecLine
    </div>
  </div>

  <!-- Bottom Copyright Bar -->
  <div class="max-w-[1400px] mx-auto px-8 md:px-16 relative z-20 flex flex-col md:flex-row justify-between items-center text-xs font-sans text-ink-light/60 dark:text-white/40 pb-4">
    <div>© 2026 SpecLine. All rights reserved.</div>
    <div class="mt-4 md:mt-0">Feito com <span class="text-terracotta">♥</span> no Brasil</div>
  </div>
</footer>
