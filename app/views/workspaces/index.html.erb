<!-- Top Header Bar -->
<header class="h-16 border-b border-ink/5 dark:border-white/5 flex items-center justify-between px-8 bg-[#FDFBF7]/80 dark:bg-ink-darker/80 backdrop-blur-md sticky top-0 z-10 shrink-0">
  <div class="flex items-center gap-3">
    <div class="w-8 h-8 rounded-lg bg-ink/5 dark:bg-white/5 flex items-center justify-center text-ink dark:text-fable">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
    </div>
    <h2 class="text-sm font-semibold text-ink dark:text-fable">Dashboard Global</h2>
  </div>
  
  <div class="flex items-center gap-4">
    <!-- Global Search -->
    <div class="relative hidden md:block">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-light dark:text-white/60"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" placeholder="Busca rápida..." class="bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-full py-1.5 pl-9 pr-14 text-xs focus:outline-none focus:ring-1 focus:ring-terracotta focus:border-terracotta dark:focus:border-terracotta text-ink dark:text-fable w-64 transition-all shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] placeholder:text-ink-light/60 dark:placeholder:text-white/60 duration-500">
      <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-0.5">
        <kbd class="font-sans text-[9px] bg-[#FDFBF7] dark:bg-ink-darker text-ink-light dark:text-white/60 px-1.5 py-0.5 rounded border border-ink/10 dark:border-white/10 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)]">⌘</kbd>
        <kbd class="font-sans text-[9px] bg-[#FDFBF7] dark:bg-ink-darker text-ink-light dark:text-white/60 px-1.5 py-0.5 rounded border border-ink/10 dark:border-white/10 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)]">K</kbd>
      </div>
    </div>
    
    <div class="h-4 w-px bg-ink/10 hidden sm:block"></div>
    
    <!-- Help -->
    <button class="relative w-8 h-8 hidden sm:flex items-center justify-center rounded-full hover:bg-ink/5 dark:hover:bg-white/5 transition-colors text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white duration-500">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
    </button>

    <!-- Notifications -->
    <button class="relative w-8 h-8 flex items-center justify-center rounded-full hover:bg-ink/5 dark:hover:bg-white/5 transition-colors text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white duration-500">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
      <span class="absolute top-1.5 right-2 w-2 h-2 bg-terracotta rounded-full border border-[#FDFBF7] dark:border-ink-darker"></span>
    </button>
  </div>
</header>

<div class="p-8 lg:p-12 max-w-6xl mx-auto w-full">
  <!-- Hero / Welcome Dashboard -->
  <!-- Classic Clean Hero Section -->
  <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6 animate-fade-in-up">
    <div>
      <h1 class="text-3xl font-serif text-ink dark:text-fable font-medium mb-2">
        Bem-vindo de volta, <%= current_user.email.split('@').first.capitalize %>
      </h1>
      <p class="text-ink-light dark:text-white/60 text-sm">
        Você tem <strong class="text-ink dark:text-fable font-medium"><%= @workspaces.count %> workspaces</strong> ativos no momento.
      </p>
    </div>
    
    <%= link_to new_workspace_path, class: "inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-terracotta rounded-lg hover:bg-[#c26244] transition-colors shrink-0 duration-500" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Novo Workspace
    <% end %>
  </div>

  <!-- Quick Stats Row -->
  <% if @workspaces.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6 mb-12 animate-fade-in-up-delay-1">
      <!-- Stat 1 -->
      <div class="bg-white dark:bg-ink-paper rounded-2xl p-5 border border-ink/5 dark:border-white/5 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.02)] hover:shadow-md hover:border-ink/10 transition-all duration-300 flex items-center gap-4 group">
        <div class="w-12 h-12 rounded-xl bg-[#FDFBF7] dark:bg-ink-darker border border-ink/5 dark:border-white/5 text-ink dark:text-fable flex items-center justify-center shrink-0 group-hover:bg-terracotta/5 group-hover:text-terracotta transition-colors duration-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        </div>
        <div>
          <p class="text-[10px] text-ink-light dark:text-white/60 font-bold uppercase tracking-wider mb-1">Workspaces</p>
          <p class="text-2xl font-serif text-ink dark:text-fable leading-none"><%= @workspaces.count %></p>
        </div>
      </div>

      <!-- Stat 2 -->
      <div class="bg-white dark:bg-ink-paper rounded-2xl p-5 border border-ink/5 dark:border-white/5 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.02)] hover:shadow-md hover:border-ink/10 transition-all duration-300 flex items-center gap-4 group">
        <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-100/50 text-blue-600 flex items-center justify-center shrink-0 group-hover:bg-blue-100 transition-colors duration-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <p class="text-[10px] text-ink-light dark:text-white/60 font-bold uppercase tracking-wider mb-1">Projetos Ativos</p>
          <p class="text-2xl font-serif text-ink dark:text-fable leading-none"><%= Project.where(workspace_id: @workspaces.pluck(:id)).where.not(status: 'Concluído').count %></p>
        </div>
      </div>

      <!-- Stat 3 -->
      <div class="bg-white dark:bg-ink-paper rounded-2xl p-5 border border-ink/5 dark:border-white/5 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.02)] hover:shadow-md hover:border-ink/10 transition-all duration-300 flex items-center gap-4 group">
        <div class="w-12 h-12 rounded-xl bg-sage/10 border border-sage/20 text-sage-dark flex items-center justify-center shrink-0 group-hover:bg-sage/20 transition-colors duration-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div>
          <p class="text-[10px] text-ink-light dark:text-white/60 font-bold uppercase tracking-wider mb-1">Projetos Concluídos</p>
          <p class="text-2xl font-serif text-ink dark:text-fable leading-none"><%= Project.where(workspace_id: @workspaces.pluck(:id), status: 'Concluído').count %></p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Workspaces Grid Section -->
  <div class="flex flex-col lg:flex-row gap-8 xl:gap-12 w-full">
    
    <!-- Left: Workspaces -->
    <div class="flex-1 min-w-0" data-controller="view-toggle">
      <div class="flex items-center justify-between border-b border-ink/10 dark:border-white/10 pb-4 mb-6">
        <h2 class="text-lg font-serif text-ink dark:text-fable font-medium flex items-center gap-2">
          Meus Espaços de Trabalho
          <span class="bg-ink/5 dark:bg-white/5 text-ink dark:text-fable text-[10px] font-bold px-2 py-0.5 rounded-full"><%= @workspaces.count %></span>
        </h2>
        <div class="flex items-center gap-2 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-lg p-1 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)]">
          <button data-action="click->view-toggle#showList" data-view-toggle-target="listButton" class="text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white hover:bg-ink/5 dark:hover:bg-white/5 rounded p-1.5 transition-colors duration-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          </button>
          <button data-action="click->view-toggle#showGrid" data-view-toggle-target="gridButton" class="text-terracotta bg-terracotta/10 rounded p-1.5 transition-colors duration-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          </button>
        </div>
      </div>

      <% if @workspaces.any? %>
        <!-- Grid View -->
        <div data-view-toggle-target="gridView" class="grid grid-cols-1 sm:grid-cols-2 gap-6 animate-fade-in-up-delay-1">
          <% @workspaces.each do |workspace| %>
            <div class="bg-white dark:bg-ink-paper border border-ink/5 dark:border-white/5 rounded-2xl p-6 h-full shadow-[0_2px_10px_-4px_rgba(0,0,0,0.04)] hover:shadow-[0_8px_30px_-4px_rgba(0,0,0,0.08)] hover:-translate-y-1 hover:border-ink/15 dark:hover:border-white/15 transition-all duration-300 relative overflow-hidden flex flex-col group cursor-pointer" onclick="if(!event.target.closest('details')) window.location='<%= workspace_path(workspace) %>'">
              
              <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-terracotta/40 to-sage/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

              <div class="flex justify-between items-start mb-5">
                <% ws_color = workspace.color.presence || '#c26244' %>
                <% if workspace.logo.attached? %>
                  <%= image_tag workspace.logo, class: "w-12 h-12 rounded-xl object-cover border border-ink/10 dark:border-white/10 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] transition-transform group-hover:scale-105 duration-300 shrink-0" %>
                <% else %>
                  <div class="w-12 h-12 rounded-xl border border-ink/10 dark:border-white/10 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] flex items-center justify-center transition-transform group-hover:scale-105 duration-300 shrink-0" style="background-color: <%= ws_color %>15; color: <%= ws_color %>;">
                    <span class="font-serif text-xl font-bold"><%= workspace.name[0].upcase %></span>
                  </div>
                <% end %>
                
                <details class="relative z-10" data-action="click->dropdown#toggle">
                  <summary class="list-none cursor-pointer text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white p-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300 focus:outline-none focus:opacity-100">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
                  </summary>
                  
                  <div class="absolute right-0 mt-2 w-48 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-xl shadow-[0_8px_30px_-4px_rgba(0,0,0,0.12)] py-1.5 z-50">
                    <%= link_to edit_workspace_path(workspace), class: "flex items-center gap-2.5 px-3 py-2 text-sm text-ink dark:text-fable hover:bg-[#FDFBF7] dark:hover:bg-white/5 transition-colors duration-500" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                      Configurações
                    <% end %>
                    <div class="h-px bg-ink/5 dark:bg-white/5 my-1"></div>
                    <%= button_to workspace_path(workspace), method: :delete, form: { data: { turbo_confirm: "Tem certeza que deseja excluir '#{workspace.name}'? Isso apagará todos os projetos vinculados." } }, class: "w-full flex items-center gap-2.5 px-3 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors text-left duration-500" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                      Excluir
                    <% end %>
                  </div>
                </details>
              </div>

              <div class="flex-1 flex flex-col">
                <h2 class="text-lg font-serif font-medium text-ink dark:text-fable mb-1 group-hover:text-terracotta transition-colors truncate duration-500"><%= workspace.name %></h2>
                <% if workspace.description.present? %>
                  <p class="text-xs text-ink-light dark:text-white/60 font-sans line-clamp-2 mb-4"><%= workspace.description %></p>
                <% else %>
                  <p class="text-[11px] text-ink-light dark:text-white/60 font-sans mb-6">Criado há <%= time_ago_in_words(workspace.created_at) %></p>
                <% end %>
                
                <div class="flex flex-wrap items-center gap-2 mb-6 mt-auto">
                  <div class="bg-[#FDFBF7] dark:bg-ink-darker px-2 py-1 rounded-md text-[10px] font-semibold text-ink-light dark:text-white/60 border border-ink/5 dark:border-white/5 uppercase tracking-wide">
                    <%= workspace.projects.count %> Projetos
                  </div>
                  <div class="bg-sage/10 px-2 py-1 rounded-md text-[10px] font-semibold text-sage-dark uppercase tracking-wide">
                    <%= workspace.projects.where(status: 'Concluído').count %> Concluídos
                  </div>
                </div>
              </div>
              
              <div class="mt-auto pt-4 border-t border-ink/5 dark:border-white/5 flex items-center justify-between text-xs text-ink-light dark:text-white/60">
                <div class="flex items-center gap-1.5">
                  <div class="w-5 h-5 rounded-full bg-ink border border-white flex items-center justify-center text-[8px] text-white font-bold"><%= current_user.email[0].upcase %></div>
                  <span class="text-[11px]">Você (Admin)</span>
                </div>
                <div class="flex items-center gap-1 text-terracotta font-medium opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-2 group-hover:translate-x-0">
                  Acessar
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </div>
              </div>

            </div>
          <% end %>
        </div>

        <!-- List View -->
        <div data-view-toggle-target="listView" class="hidden space-y-3 animate-fade-in-up-delay-1">
          <% @workspaces.each do |workspace| %>
            <div class="bg-white dark:bg-ink-paper border border-ink/5 dark:border-white/5 rounded-2xl p-4 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] hover:shadow-md hover:border-ink/15 dark:hover:border-white/15 transition-all duration-300 flex items-center justify-between group cursor-pointer" onclick="if(!event.target.closest('details')) window.location='<%= workspace_path(workspace) %>'">
              <div class="flex items-center gap-4 min-w-0 flex-1">
                <% ws_color = workspace.color.presence || '#c26244' %>
                <% if workspace.logo.attached? %>
                  <%= image_tag workspace.logo, class: "w-12 h-12 rounded-xl object-cover border border-ink/10 dark:border-white/10 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] transition-transform group-hover:scale-105 duration-300 shrink-0" %>
                <% else %>
                  <div class="w-12 h-12 rounded-xl border border-ink/10 dark:border-white/10 shadow-sm dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] flex items-center justify-center transition-transform group-hover:scale-105 duration-300 shrink-0" style="background-color: <%= ws_color %>15; color: <%= ws_color %>;">
                    <span class="font-serif text-xl font-bold"><%= workspace.name[0].upcase %></span>
                  </div>
                <% end %>
                <div class="flex flex-col min-w-0 pr-4">
                  <h2 class="text-base font-serif font-medium text-ink dark:text-fable group-hover:text-terracotta transition-colors truncate mb-0.5 duration-500"><%= workspace.name %></h2>
                  <% if workspace.description.present? %>
                    <p class="text-xs text-ink-light dark:text-white/60 font-sans truncate"><%= workspace.description %></p>
                  <% else %>
                    <p class="text-xs text-ink-light dark:text-white/60 font-sans truncate">Você (Admin) • Criado há <%= time_ago_in_words(workspace.created_at) %></p>
                  <% end %>
                </div>
              </div>
              
              <div class="flex items-center gap-6 shrink-0">
                <div class="hidden sm:flex items-center gap-3">
                  <div class="bg-[#FDFBF7] dark:bg-ink-darker px-2.5 py-1 rounded-md text-[10px] font-semibold text-ink-light dark:text-white/60 border border-ink/5 dark:border-white/5 uppercase tracking-wide">
                    <%= workspace.projects.count %> Projetos
                  </div>
                  <div class="bg-sage/10 px-2.5 py-1 rounded-md text-[10px] font-semibold text-sage-dark uppercase tracking-wide">
                    <%= workspace.projects.where(status: 'Concluído').count %> Concluídos
                  </div>
                </div>

                <details class="relative z-10" data-action="click->dropdown#toggle">
                  <summary class="list-none cursor-pointer text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white p-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300 focus:outline-none focus:opacity-100">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
                  </summary>
                  
                  <div class="absolute right-0 mt-2 w-48 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-xl shadow-[0_8px_30px_-4px_rgba(0,0,0,0.12)] py-1.5 z-50">
                    <%= link_to edit_workspace_path(workspace), class: "flex items-center gap-2.5 px-3 py-2 text-sm text-ink dark:text-fable hover:bg-[#FDFBF7] dark:hover:bg-white/5 transition-colors duration-500" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                      Configurações
                    <% end %>
                    <div class="h-px bg-ink/5 dark:bg-white/5 my-1"></div>
                    <%= button_to workspace_path(workspace), method: :delete, form: { data: { turbo_confirm: "Tem certeza que deseja excluir '#{workspace.name}'? Isso apagará todos os projetos vinculados." } }, class: "w-full flex items-center gap-2.5 px-3 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors text-left duration-500" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                      Excluir
                    <% end %>
                  </div>
                </details>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="bg-white dark:bg-ink-paper border border-ink/5 dark:border-white/5 border-dashed rounded-2xl p-12 text-center">
          <p class="text-ink-light dark:text-white/60 font-sans mb-4">Você ainda não tem nenhum espaço de trabalho.</p>
          <%= link_to "Criar meu primeiro Workspace", new_workspace_path, class: "text-terracotta font-medium hover:underline" %>
        </div>
      <% end %>
    </div>

    <!-- Right: Activity Feed (Robust Feature Addition) -->
    <div class="w-full xl:w-80 shrink-0">
      <div class="flex items-center justify-between border-b border-ink/10 dark:border-white/10 pb-4 mb-6">
        <h2 class="text-lg font-serif text-ink dark:text-fable font-medium">Atividade Recente</h2>
      </div>
      
      <div class="bg-white dark:bg-ink-paper border border-ink/5 dark:border-white/5 rounded-2xl p-6 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.02)]">
        <% if @workspaces.any? && Project.where(workspace_id: @workspaces.pluck(:id)).any? %>
          <div class="relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px before:h-full before:w-px before:bg-gradient-to-b before:from-ink/10 before:via-ink/5 before:to-transparent space-y-6">
            
            <% Project.where(workspace_id: @workspaces.pluck(:id)).order(created_at: :desc).limit(4).each do |project| %>
              <div class="relative flex items-start gap-4 group is-active">
                <div class="flex items-center justify-center w-10 h-10 rounded-full border-4 border-white bg-sage/10 text-sage-dark shrink-0 z-10 transition-transform group-hover:scale-110 duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <div class="flex-1 pt-1.5 min-w-0">
                  <div class="flex items-center justify-between mb-0.5">
                    <span class="font-bold text-ink dark:text-fable text-xs truncate">Novo Projeto</span>
                    <time class="font-sans text-[10px] text-ink-light dark:text-white/60 shrink-0 ml-2"><%= time_ago_in_words(project.created_at) %></time>
                  </div>
                  <div class="text-[11px] text-ink-light dark:text-white/60 leading-snug">
                    Criou <span class="font-medium text-ink dark:text-fable"><%= project.name %></span> em <span class="font-medium text-ink dark:text-fable"><%= project.workspace.name %></span>
                  </div>
                </div>
              </div>
            <% end %>

          </div>
          <%= link_to "Ver todo o histórico", activities_path, class: "block w-full text-center text-[11px] font-semibold text-ink-light dark:text-white/60 mt-8 hover:text-terracotta transition-colors duration-500", data: { turbo_frame: "modal" } %>
        <% else %>
          <div class="text-center py-8">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-ink-light/40 dark:text-white/40 mx-auto mb-3"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <p class="text-xs text-ink-light dark:text-white/60">Nenhuma atividade recente.</p>
            <p class="text-[10px] text-ink-light/60 dark:text-white/60 mt-1">Crie projetos e documentos para ver movimentações aqui.</p>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>
