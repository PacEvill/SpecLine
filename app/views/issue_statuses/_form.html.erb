<% content_for(:sidebar) do %>
  <%= render "shared/workspace_sidebar", workspace: @workspace %>
<% end %>

<% if defined?(@project) && @project&.persisted? %>
  <div class="opacity-40 pointer-events-none filter blur-[1px] select-none h-full overflow-hidden">
    <%= render "projects/header" %>
    <%= render "projects/overview_view" %>
  </div>
<% end %>

<%= turbo_frame_tag "modal" do %>
  <div data-controller="modal" data-modal-open-value="true" class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-ink/30 backdrop-blur-sm transition-opacity duration-500" data-modal-target="backdrop" data-action="click->modal#close"></div>

    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
      <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
        <div class="relative transform overflow-hidden bg-white dark:bg-ink-paper text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-sm sm:rounded-2xl border border-ink/10 dark:border-white/10 flex flex-col duration-500" data-modal-target="panel">
          
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-ink/5 dark:border-white/5 bg-[#FDFBF7] dark:bg-ink-darker">
            <h3 class="text-sm font-serif font-semibold text-ink dark:text-white" id="modal-title">
              <%= @issue_status.new_record? ? "Nova Coluna" : "Editar Coluna" %>
            </h3>
            <button type="button" class="text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors duration-300" data-action="modal#close">
              <span class="sr-only">Fechar</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>

          <div class="px-5 py-5">
            <%= form_with(model: [@workspace, @project, @issue_status], html: { target: "_top", class: "space-y-5" }) do |f| %>
              <% if @issue_status.errors.any? %>
                <div class="bg-red-50 text-red-600 p-3 rounded-lg text-xs mb-4 border border-red-100">
                  <p class="font-semibold mb-1">Não foi possível salvar:</p>
                  <ul class="list-disc pl-4 space-y-0.5">
                    <% @issue_status.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <div>
                <%= f.label :name, "Nome da Coluna", class: "block text-[11px] uppercase tracking-wider font-semibold text-ink-light dark:text-white/60 mb-1.5" %>
                <%= f.text_field :name, class: "w-full px-3 py-2 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-lg text-sm text-ink dark:text-white focus:outline-none focus:border-terracotta dark:focus:border-terracotta focus:ring-1 focus:ring-terracotta transition-shadow placeholder:text-ink/30 dark:placeholder:text-white/30 duration-300", placeholder: "Ex: Em Validação", required: true %>
              </div>

              <div>
                <%= f.label :category, "Comportamento (Categoria)", class: "block text-[11px] uppercase tracking-wider font-semibold text-ink-light dark:text-white/60 mb-1.5" %>
                <%= f.select :category, [["Backlog", "backlog"], ["A Fazer", "todo"], ["Em Progresso", "in_progress"], ["Concluído", "done"], ["Cancelado", "cancelled"]], {}, class: "w-full px-3 py-2 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-lg text-sm text-ink dark:text-white focus:outline-none focus:border-terracotta dark:focus:border-terracotta focus:ring-1 focus:ring-terracotta transition-shadow duration-300" %>
              </div>

              <div>
                <%= f.label :color, "Cor de Destaque", class: "block text-[11px] uppercase tracking-wider font-semibold text-ink-light dark:text-white/60 mb-2" %>
                <div class="flex flex-wrap gap-2">
                  <% colors = ["#94a3b8", "#f59e0b", "#3b82f6", "#8b5cf6", "#22c55e", "#ef4444", "#ec4899", "#14b8a6"] %>
                  <% colors.each do |color| %>
                    <label class="cursor-pointer relative group">
                      <%= f.radio_button :color, color, class: "peer sr-only" %>
                      <div class="w-7 h-7 rounded-full flex items-center justify-center border-2 border-transparent peer-checked:border-ink dark:peer-checked:border-white group-hover:scale-110 transition-all duration-300">
                        <div class="w-5 h-5 rounded-full" style="background-color: <%= color %>"></div>
                      </div>
                    </label>
                  <% end %>
                </div>
              </div>

              <div class="pt-5 mt-5 border-t border-ink/5 dark:border-white/5 flex items-center justify-end gap-2">
                <button type="button" class="px-4 py-1.5 text-xs font-semibold text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors duration-300" data-action="modal#close">Cancelar</button>
                <%= f.submit "Salvar", class: "px-5 py-1.5 bg-ink text-white text-xs font-semibold rounded-lg hover:bg-terracotta transition-colors shadow-sm cursor-pointer duration-300" %>
              </div>
            <% end %>
          </div>
          
        </div>
      </div>
    </div>
  </div>
<% end %>
