<% current_ws = local_assigns[:workspace] || @workspace || current_user&.workspaces&.first %>
<nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-ink-paper/95 backdrop-blur-md border-t border-ink/10 dark:border-white/10 flex items-center justify-around py-1.5 px-2 shadow-[0_-4px_24px_rgba(0,0,0,0.06)] transition-colors duration-500">
  <!-- 1. Workspaces / Home -->
  <%= link_to workspaces_path, class: "flex flex-col items-center justify-center gap-0.5 px-3 py-1 text-xs #{current_page?(workspaces_path) ? 'text-terracotta font-semibold' : 'text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable'}" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
    <span class="text-[10px]">Workspaces</span>
  <% end %>

  <!-- 2. Buscar -->
  <%= link_to search_path, data: { turbo_frame: "modal" }, class: "flex flex-col items-center justify-center gap-0.5 px-3 py-1 text-xs text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <span class="text-[10px]">Buscar</span>
  <% end %>

  <!-- 3. Tarefas -->
  <%= link_to my_tasks_path, data: { turbo_frame: "modal" }, class: "flex flex-col items-center justify-center gap-0.5 px-3 py-1 text-xs text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable relative" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
    <span class="text-[10px]">Tarefas</span>
    <% if current_user && current_user.assigned_issues.joins(:issue_status).where.not(issue_statuses: { category: 'done' }).count > 0 %>
      <span class="absolute top-0 right-3 w-2 h-2 rounded-full bg-terracotta"></span>
    <% end %>
  <% end %>

  <!-- 4. Atividades -->
  <%= link_to activities_path, data: { turbo_frame: "modal" }, class: "flex flex-col items-center justify-center gap-0.5 px-3 py-1 text-xs text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
    <span class="text-[10px]">Atividades</span>
  <% end %>

  <!-- 5. Perfil -->
  <%= link_to edit_user_registration_path, data: { turbo_frame: "modal" }, class: "flex flex-col items-center justify-center gap-0.5 px-3 py-1 text-xs text-ink-light dark:text-white/60 hover:text-ink dark:hover:text-fable" do %>
    <% if current_user&.avatar&.attached? %>
      <%= image_tag current_user.avatar, class: "w-5 h-5 rounded-full object-cover border border-ink/10 dark:border-white/10" %>
    <% else %>
      <div class="w-5 h-5 rounded-full bg-terracotta/10 border border-terracotta/20 text-terracotta flex items-center justify-center font-serif text-[10px] font-bold">
        <%= current_user&.full_name.presence&.[](0)&.upcase || 'U' %>
      </div>
    <% end %>
    <span class="text-[10px]">Perfil</span>
  <% end %>
</nav>
