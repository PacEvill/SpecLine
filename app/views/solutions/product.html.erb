                </span>
              </div>
            </div>

            <!-- COLUMN 3: CONTEXTUAL CHAT -->
            <div class="lg:col-span-4 p-6 flex flex-col justify-between space-y-6 bg-white dark:bg-ink-paper">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-ocean font-bold flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
