<!-- Kanban Board View -->
<div class="px-4 sm:px-6 lg:px-8 py-4 sm:py-6 pb-20 md:pb-8" data-controller="kanban" data-kanban-move-url-value="<%= workspace_project_path(workspace, project) %>">
  <div class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory sm:snap-none scroll-smooth" style="min-height: calc(100vh - 200px);" data-kanban-target="board">
    <% statuses.each do |status| %>
      <div class="flex-shrink-0 w-[82vw] sm:w-72 flex flex-col snap-center" data-kanban-target="column" data-status-id="<%= status.id %>">
        
        <!-- Column Header -->
        <div class="flex items-center justify-between mb-3 px-1 column-drag-handle cursor-grab active:cursor-grabbing">
          <div class="flex items-center gap-2">
            <div class="w-2.5 h-2.5 rounded-full" style="background-color: <%= status.color %>"></div>
            <h3 class="text-xs font-bold text-ink dark:text-fable uppercase tracking-wider"><%= status.name %></h3>
            <span class="text-[10px] text-ink-light dark:text-white/60 bg-ink/5 dark:bg-white/5 px-1.5 py-0.5 rounded-full font-semibold">
              <%= issues.select { |i| i.issue_status_id == status.id }.count %>
            </span>
          </div>
          
          <div class="flex items-center gap-0.5">
            <%= link_to new_workspace_project_issue_path(workspace, project, issue_status_id: status.id), data: { turbo_frame: "modal" }, class: "w-6 h-6 rounded flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/5 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors cursor-pointer duration-500", title: "Adicionar Issue" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <% end %>

            <details class="relative" data-controller="dropdown" data-action="click->dropdown#toggle keydown.window->dropdown#closeOnEsc">
              <summary class="list-none w-6 h-6 rounded flex items-center justify-center text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/5 hover:text-ink dark:hover:text-fable dark:hover:text-white transition-colors cursor-pointer focus:outline-none duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg>
              </summary>
            
            <div class="absolute right-0 top-full mt-1 w-48 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-xl shadow-lg p-1 z-50">
              <%= link_to edit_workspace_project_issue_status_path(workspace, project, status), data: { turbo_frame: "modal" }, class: "flex items-center gap-2 px-3 py-2 text-sm text-ink dark:text-fable hover:bg-fable-light dark:hover:bg-white/5 rounded-lg transition-colors w-full text-left duration-500" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-light dark:text-white/60"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                Editar Coluna
              <% end %>
              <div class="h-px bg-ink/5 dark:bg-white/5 my-1"></div>
              <%= button_to workspace_project_issue_status_path(workspace, project, status), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir esta coluna?" }, class: "flex items-center gap-2 px-3 py-2 text-sm text-rust hover:bg-rust/10 rounded-lg transition-colors w-full text-left duration-500" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                Excluir Coluna
              <% end %>
            </div>
          </details>
          </div>
        </div>

        <!-- Cards Container (Sortable) -->
        <div class="flex-1 space-y-2 p-1 rounded-xl bg-ink/[0.02] border border-ink/[0.03] dark:border-white/[0.05] min-h-[100px]"
             data-kanban-target="list"
             data-status-id="<%= status.id %>"
             data-project-id="<%= project.id %>"
             <%= "data-assignee-id=\"#{local_assigns[:assignee_id]}\"".html_safe if local_assigns.has_key?(:assignee_id) %>
             <%= "data-board-id=\"#{local_assigns[:board_id]}\"".html_safe if local_assigns.has_key?(:board_id) %>>
          <% issues.select { |i| i.issue_status_id == status.id }.sort_by { |i| i.position || i.number }.each do |issue| %>
            <%= render "projects/issue_card", issue: issue, workspace: workspace, project: project %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Add New Column Button -->
    <div class="flex-shrink-0 w-72 flex flex-col pt-1">
      <%= link_to new_workspace_project_issue_status_path(workspace, project), data: { turbo_frame: "modal" }, class: "flex items-center gap-2 p-3 rounded-xl border border-dashed border-ink/20 dark:border-white/20 text-ink-light dark:text-white/60 hover:text-terracotta hover:border-terracotta hover:bg-terracotta/5 transition-all group cursor-pointer duration-500" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform duration-500"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span class="text-sm font-medium">Adicionar Coluna</span>
      <% end %>
    </div>
  </div>
</div>
