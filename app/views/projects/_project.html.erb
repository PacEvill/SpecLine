<div id="<%= dom_id project %>">
  <div>
    <strong>Name:</strong>
    <%= project.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= project.description %>
  </div>

  <div>
    <strong>Deadline:</strong>
    <%= project.deadline %>
  </div>

  <div>
    <strong>Progress:</strong>
    <%= project.progress %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= project.status %>
  </div>

  <div>
    <strong>Workspace:</strong>
    <%= project.workspace_id %>
  </div>

</div>
