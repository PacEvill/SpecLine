<!-- 1. Global Navigation Sidebar -->
<aside data-controller="sidebar" class="group relative h-full bg-white dark:bg-ink-paper border-r border-ink/10 dark:border-white/10 shrink-0 z-50 transition-all duration-300 w-16 [&.is-expanded]:w-64 flex flex-col">
  
  <!-- Logo & Toggle -->
  <div class="h-16 px-3 flex items-center shrink-0 border-b border-ink/5 dark:border-white/5 relative">
    <%= link_to workspaces_path, class: "flex items-center gap-3 text-ink dark:text-fable hover:text-terracotta transition-colors overflow-hidden w-full" do %>
      <div class="w-10 h-10 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-terracotta"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></svg>
      </div>
      <span class="font-serif font-medium text-lg tracking-tight whitespace-nowrap opacity-0 group-[.is-expanded]:opacity-100 transition-opacity duration-300">SpecLine</span>
    <% end %>

    <!-- Floating Toggle Button -->
    <button data-action="click->sidebar#toggle" class="absolute -right-3.5 top-1/2 -translate-y-1/2 w-7 h-7 bg-white dark:bg-ink border border-ink/10 dark:border-white/10 rounded-full shadow-sm flex items-center justify-center text-ink-light dark:text-white/60 hover:text-ink hover:border-ink/20 dark:hover:text-fable dark:hover:border-white/20 transition-all focus:outline-none z-50">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-[.is-expanded]:rotate-180 transition-transform duration-300"><path d="m13 17 5-5-5-5"/><path d="M6 17l5-5-5-5"/></svg>
    </button>
  </div>

  <!-- Main Links -->
  <nav class="flex flex-col gap-2 flex-1 w-full p-2 overflow-y-auto overflow-x-hidden">
    <%= link_to search_path, data: { turbo_frame: "modal", action: "click->dropdown#close" }, class: "flex items-center gap-3 w-full h-12 rounded-xl text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/5 hover:text-ink dark:hover:text-fable transition-colors relative overflow-hidden", title: "Busca Rápida (⌘K)" do %>
      <div class="w-12 h-12 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </div>
      <span class="font-medium text-sm whitespace-nowrap opacity-0 group-[.is-expanded]:opacity-100 transition-opacity duration-300">Buscar</span>
      <span class="ml-auto mr-4 text-[10px] font-sans font-medium text-ink-light/50 dark:text-white/30 bg-ink/5 dark:bg-white/5 px-1.5 py-0.5 rounded border border-ink/5 dark:border-white/5 opacity-0 group-[.is-expanded]:opacity-100 transition-opacity duration-300 shrink-0">⌘K</span>
    <% end %>

    <%= link_to workspaces_path, class: "flex items-center gap-3 w-full h-12 rounded-xl #{current_page?(workspaces_path) ? 'bg-ink/5 dark:bg-white/5 text-ink dark:text-fable' : 'text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/5 hover:text-ink dark:hover:text-fable'} transition-colors relative overflow-hidden" do %>
      <% if current_page?(workspaces_path) %>
        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-5 bg-terracotta rounded-r-full"></div>
      <% end %>
      <div class="w-12 h-12 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
      </div>
      <span class="font-medium text-sm whitespace-nowrap opacity-0 group-[.is-expanded]:opacity-100 transition-opacity duration-300">Workspaces</span>
    <% end %>

    <%= link_to my_tasks_path, data: { turbo_frame: "modal", action: "click->dropdown#close" }, class: "flex items-center gap-3 w-full h-12 rounded-xl text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/5 hover:text-ink dark:hover:text-fable transition-colors relative overflow-hidden" do %>
      <div class="w-12 h-12 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
      </div>
      <span class="font-medium text-sm whitespace-nowrap opacity-0 group-[.is-expanded]:opacity-100 transition-opacity duration-300">Minhas Tarefas</span>
      <% if current_user.assigned_issues.joins(:issue_status).where.not(issue_statuses: { category: 'done' }).count > 0 %>
        <span class="ml-auto mr-4 bg-terracotta text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full opacity-0 group-[.is-expanded]:opacity-100 transition-opacity duration-300 shrink-0"><%= current_user.assigned_issues.joins(:issue_status).where.not(issue_statuses: { category: 'done' }).count %></span>
      <% end %>
    <% end %>

    <%= link_to activities_path, data: { turbo_frame: "modal", action: "click->dropdown#close" }, class: "flex items-center gap-3 w-full h-12 rounded-xl text-ink-light dark:text-white/60 hover:bg-ink/5 dark:hover:bg-white/5 hover:text-ink dark:hover:text-fable transition-colors relative overflow-hidden" do %>
      <div class="w-12 h-12 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
      </div>
      <span class="font-medium text-sm whitespace-nowrap opacity-0 group-[.is-expanded]:opacity-100 transition-opacity duration-300">Atividades</span>
    <% end %>
  </nav>

  <!-- Bottom Actions & Profile -->
  <div class="flex flex-col gap-2 w-full p-2 mt-auto pb-4 shrink-0">
    
    <!-- User Profile Dropdown -->
    <details class="relative" data-controller="dropdown" data-action="keydown.window->dropdown#closeOnEsc">
      <summary class="list-none flex items-center gap-3 w-full h-12 rounded-xl hover:bg-ink/5 dark:hover:bg-white/5 transition-colors cursor-pointer focus:outline-none overflow-hidden">
        <div class="w-12 h-12 flex items-center justify-center shrink-0">
          <% if current_user.avatar.attached? %>
            <%= image_tag current_user.avatar, class: "w-8 h-8 rounded-full object-cover border border-ink/10 dark:border-white/10" %>
          <% else %>
            <div class="w-8 h-8 rounded-full bg-terracotta/10 border border-terracotta/20 text-terracotta flex items-center justify-center font-serif font-medium text-sm">
              <%= current_user.full_name[0].upcase %>
            </div>
          <% end %>
        </div>
        <div class="flex flex-col min-w-0 opacity-0 group-[.is-expanded]:opacity-100 transition-opacity duration-300 text-left shrink-0">
          <span class="text-sm font-medium text-ink dark:text-fable truncate leading-tight"><%= current_user.full_name %></span>
          <span class="text-[10px] text-ink-light dark:text-white/60 truncate"><%= current_user.job_title.presence || current_user.email %></span>
        </div>
      </summary>
      
      <!-- Dropdown Menu -->
      <div class="absolute bottom-full left-0 mb-2 w-56 bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-xl shadow-[0_8px_30px_-4px_rgba(0,0,0,0.12)] p-1 z-50 flex flex-col">
        
        <!-- Dropdown Header -->
        <div class="px-3 py-2 mb-1 border-b border-ink/5 dark:border-white/5 flex flex-col">
          <span class="text-sm font-medium text-ink dark:text-fable truncate leading-tight"><%= current_user.full_name %></span>
          <span class="text-xs text-ink-light dark:text-white/50 truncate"><%= current_user.email %></span>
        </div>
        
        <%= link_to edit_user_registration_path, data: { turbo_frame: "modal", action: "click->dropdown#close" }, class: "flex items-center gap-2.5 px-3 py-2 text-[13px] font-medium text-ink-light dark:text-white/70 hover:text-ink dark:hover:text-fable hover:bg-ink/5 dark:hover:bg-white/5 rounded-lg transition-colors duration-200" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          Editar Perfil
        <% end %>
        
        <%= link_to preferences_path, data: { turbo_frame: "modal", action: "click->dropdown#close" }, class: "flex items-center gap-2.5 px-3 py-2 text-[13px] font-medium text-ink-light dark:text-white/70 hover:text-ink dark:hover:text-fable hover:bg-ink/5 dark:hover:bg-white/5 rounded-lg transition-colors duration-200" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          Preferências
        <% end %>

        <div class="h-px bg-ink/5 dark:bg-white/5 my-1"></div>
        
        <%= button_to destroy_user_session_path, method: :delete, class: "w-full flex items-center gap-2.5 px-3 py-2 text-[13px] font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-lg transition-colors text-left duration-200" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          Sair
        <% end %>
      </div>
    </details>
  </div>
</aside>
