<div id="move-document-modal" 
     class="hidden fixed inset-0 z-[100] items-center justify-center p-4 bg-ink/40 dark:bg-black/60 backdrop-blur-md transition-all duration-200"
     data-action="click->document-tree#closeMoveModalBackground">
  
  <div class="bg-white dark:bg-ink-paper border border-ink/10 dark:border-white/10 rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col scale-95 transition-all duration-200 max-h-[85vh] animate-[scale-in_0.18s_cubic-bezier(0.16,1,0.3,1)_forwards]">
    
    <!-- Modal Header -->
    <div class="px-5 py-4 border-b border-ink/5 dark:border-white/5 flex items-center justify-between bg-[#FDFBF7] dark:bg-ink-darker">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-terracotta/10 text-terracotta flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><polyline points="12 11 16 15 12 19"/><line x1="8" y1="15" x2="16" y2="15"/></svg>
        </div>
        <div>
          <h3 class="font-serif font-bold text-base text-ink dark:text-fable leading-tight">Mover Arquivo ou Pasta</h3>
          <p class="text-xs text-ink-light/60 dark:text-white/40">
            Selecione a pasta de destino no projeto <strong class="text-ink dark:text-fable font-semibold"><%= project.name %></strong>
          </p>
        </div>
      </div>

      <button type="button" 
              data-action="click->document-tree#closeMoveModal" 
              class="w-8 h-8 rounded-xl flex items-center justify-center text-ink-light dark:text-white/50 hover:bg-ink/5 dark:hover:bg-white/10 hover:text-ink dark:hover:text-fable transition-colors cursor-pointer"
              title="Fechar">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- Active Item Pill / Context -->
    <div class="px-5 py-2.5 bg-ink/[0.02] dark:bg-white/[0.02] border-b border-ink/5 dark:border-white/5 flex items-center justify-between text-xs">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-ink-light/60 dark:text-white/40 shrink-0">Item selecionado:</span>
        <div id="move-modal-active-title" class="font-semibold text-ink dark:text-fable truncate flex items-center gap-1.5">
          <span id="move-modal-active-icon"><%= document_icon_tag(@document) if defined?(@document) && @document %></span>
          <span id="move-modal-active-name"><%= @document&.title.presence || "Documento Selecionado" if defined?(@document) && @document %></span>
        </div>
      </div>
      <span class="text-[10px] text-terracotta font-mono font-bold uppercase tracking-wider bg-terracotta/10 px-2 py-0.5 rounded-full shrink-0">
        Destino
      </span>
    </div>

    <!-- Search / Filter Destinations -->
    <div class="p-3 border-b border-ink/5 dark:border-white/5">
      <div class="relative">
        <input type="text" 
               id="move-modal-filter-input"
               data-action="input->document-tree#filterMoveDestinations" 
               placeholder="Buscar pasta de destino..." 
               class="w-full text-xs px-3 py-2 pl-8 bg-ink/[0.03] dark:bg-white/[0.04] border border-ink/10 dark:border-white/10 rounded-xl text-ink dark:text-fable placeholder-ink/30 dark:placeholder-white/30 outline-none focus:border-terracotta focus:ring-1 focus:ring-terracotta transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-2.5 top-2.5 text-ink-light/40 dark:text-white/40"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </div>
    </div>

    <!-- Destinations List Container -->
    <div class="flex-1 overflow-y-auto p-3 space-y-1 max-h-80 hide-scrollbar" id="move-destinations-container">
      
      <!-- Option 1: Root Destination (Raiz do Projeto) -->
      <div class="destination-node-wrapper pb-1">
        <button type="button" 
                data-action="click->document-tree#selectMoveDestination" 
                data-parent-id="" 
                data-destination-id=""
                data-destination-title="raiz do projeto principal root"
                class="move-destination-btn w-full text-left flex items-center justify-between p-2.5 rounded-xl hover:bg-terracotta/10 text-ink dark:text-fable hover:text-terracotta transition-all group cursor-pointer border border-ink/5 dark:border-white/5 hover:border-terracotta/30">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-lg bg-ink/5 dark:bg-white/10 group-hover:bg-terracotta/20 group-hover:text-terracotta flex items-center justify-center text-ink-light dark:text-white/70 transition-colors shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div class="truncate">
              <span class="font-semibold text-xs truncate block group-hover:text-terracotta">Raiz do Projeto</span>
              <span class="text-[10px] text-ink-light/50 dark:text-white/40 block truncate">Nível superior de <%= project.name %></span>
            </div>
          </div>
          <span class="text-[11px] font-medium text-ink-light/40 group-hover:text-terracotta shrink-0 font-mono">Mover para raiz →</span>
        </button>
      </div>

      <!-- Recursive Project Documents & Folders List -->
      <div class="pt-1 space-y-1">
        <% 
          render_destination_tree = ->(docs, depth = 0) {
            docs.each do |d|
        %>
              <div class="destination-node-wrapper" 
                   data-destination-id="<%= d.id %>" 
                   data-destination-title="<%= d.title.to_s.downcase %>"
                   style="padding-left: <%= depth * 12 %>px;">
                <button type="button" 
                        data-action="click->document-tree#selectMoveDestination" 
                        data-parent-id="<%= d.id %>" 
                        data-destination-id="<%= d.id %>"
                        class="move-destination-btn w-full text-left flex items-center justify-between px-2.5 py-2 rounded-xl hover:bg-terracotta/10 text-ink dark:text-fable hover:text-terracotta transition-all group cursor-pointer border border-transparent hover:border-terracotta/20">
                  <div class="flex items-center gap-2 min-w-0">
                    <span class="shrink-0 flex items-center justify-center">
                      <%= document_icon_tag(d, size_class: "w-4 h-4") %>
                    </span>
                    <span class="text-xs truncate <%= d.is_folder? ? 'font-semibold text-ink dark:text-fable' : 'font-medium' %> group-hover:text-terracotta"><%= d.title.presence || (d.is_folder? ? "Nova Pasta" : "Sem Título") %></span>
                    <% if d.is_folder? %>
                      <span class="px-1 py-0.2 rounded text-[9px] font-bold uppercase bg-amber-500/10 text-amber-600 dark:text-amber-400">Pasta</span>
                    <% end %>
                  </div>
                  
                  <div class="flex items-center gap-1.5 shrink-0">
                    <% if d.children.any? %>
                      <span class="text-[10px] text-ink-light/40 dark:text-white/30 font-mono"><%= d.children.count %> itens</span>
                    <% end %>
                    <span class="text-xs text-ink-light/30 group-hover:text-terracotta transition-colors ml-1">→</span>
                  </div>
                </button>
              </div>

              <% if d.children.any? %>
                <% render_destination_tree.call(d.children.ordered, depth + 1) %>
              <% end %>
        <% 
            end 
          }
        %>

        <% render_destination_tree.call(project.documents.roots.ordered) %>
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="p-3 bg-[#FDFBF7] dark:bg-ink-darker border-t border-ink/5 dark:border-white/5 flex items-center justify-between text-xs">
      <span class="text-[11px] text-ink-light/50 dark:text-white/40">Clique em qualquer pasta para transferir</span>
      <button type="button" 
              data-action="click->document-tree#closeMoveModal" 
              class="px-3 py-1.5 rounded-xl border border-ink/10 dark:border-white/10 hover:bg-ink/5 dark:hover:bg-white/5 text-ink dark:text-fable text-xs font-medium transition-colors cursor-pointer">
        Cancelar
      </button>
    </div>

  </div>
</div>
